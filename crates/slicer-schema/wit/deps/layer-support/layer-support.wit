package slicer:layer-support@2.0.0;

interface support {
    use slicer:ir-handles/ir-handles@1.0.0.{layer-idx, slice-region-view,
        paint-region-layer-view, support-output-builder, layer-collection-builder};
    use slicer:support-queries/support-queries@1.0.0.{support-query-view};
    use slicer:config/config-types.{config-view};
    use slicer:common/module-errors.{module-error};

    run: func(layer-index: layer-idx, regions: list<slice-region-view>,
        paint: paint-region-layer-view, support-queries: own<support-query-view>,
        output: support-output-builder,
        collection: layer-collection-builder,
        config: config-view) -> result<_, module-error>;
}

world support-module {
    import slicer:common/host-services;
    import slicer:common/profiling;
    import slicer:config/config-types;
    import slicer:ir-handles/ir-handles@1.0.0;
    import slicer:support-queries/support-queries@1.0.0;
    export support;
}
