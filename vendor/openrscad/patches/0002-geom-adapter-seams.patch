+    /// Weld vertices whose positions are **exactly** equal, returning a
+    /// re-indexed mesh with provably-degenerate triangles dropped.
+    ///
+    /// This is the representation-only form of [`Mesh::welded`]. It serves the
+    /// same purpose — a solid of revolution emits its seam and its cap rings as
+    /// separate vertices at *identical* positions, which is manifold by position
+    /// but not by index — without the epsilon bucket that `welded` uses. The
+    /// difference matters at an exactness boundary: `welded(1e-7)` merges two
+    /// genuinely distinct vertices 1e-8 mm apart and then drops every triangle
+    /// that collapsed, so a thin solid can disappear with no error and no
+    /// diagnostic. Exact identity cannot do that: only points that are the same
+    /// `f64` triple are merged, and only triangles that are already zero-area by
+    /// identity are dropped.
+    ///
+    /// Signed zeros are the same exact position (`-0.0 == 0.0`), so their keys are
+    /// canonicalised; no other value is altered and the output vertex keeps its
+    /// original bits.
+    pub fn welded_exact(&self) -> Mesh {
+        let key = |p: &[f64; 3]| {
+            [
+                if p[0] == 0.0 { 0 } else { p[0].to_bits() },
+                if p[1] == 0.0 { 0 } else { p[1].to_bits() },
+                if p[2] == 0.0 { 0 } else { p[2].to_bits() },
+            ]
+        };
+        let mut map: std::collections::HashMap<[u64; 3], u32> = std::collections::HashMap::new();
+        let mut verts: Vec<[f64; 3]> = Vec::with_capacity(self.verts.len());
+        let mut remap: Vec<u32> = Vec::with_capacity(self.verts.len());
+        for v in &self.verts {
+            let id = *map.entry(key(v)).or_insert_with(|| {
+                verts.push(*v);
+                (verts.len() - 1) as u32
+            });
+            remap.push(id);
+        }
+        let mut tris: Vec<[u32; 3]> = Vec::with_capacity(self.tris.len());
+        for t in &self.tris {
+            let a = remap[t[0] as usize];
+            let b = remap[t[1] as usize];
+            let c = remap[t[2] as usize];
+            if a != b && b != c && a != c {
+                tris.push([a, b, c]);
+            }
+        }
+        Mesh { verts, tris }
+    }
