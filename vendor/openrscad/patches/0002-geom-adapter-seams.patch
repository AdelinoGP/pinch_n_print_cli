+/// Tests for the adapter seams added by `patches/0002-geom-adapter-seams.patch`.
+#[cfg(test)]
+mod adapter_seam_tests {
+    use super::*;
+
+    fn kernel() -> ManifoldKernel {
+        ManifoldKernel::new()
+    }
+
+    #[test]
+    fn contour_diag_entrypoint_returns_contours_and_empty_diagnostics_for_clean_2d() {
+        let node = Node::Square {
+            size: [10.0, 10.0],
+            center: false,
+        };
+        let mut cache = GeomCache::new();
+        let (contours, diag) = render_contours_cached_diag(&node, &kernel(), &mut cache).unwrap();
+        let contours = contours.expect("a purely 2D tree returns contours");
+        assert_eq!(contours.len(), 1);
+        assert!(
+            diag.warnings.is_empty() && diag.errors.is_empty(),
+            "clean 2D traversal must report no diagnostics: {diag:?}"
+        );
+    }
+
+    #[test]
+    fn contour_diag_entrypoint_agrees_with_the_compatibility_entrypoint() {
+        let node = Node::Square {
+            size: [4.0, 6.0],
+            center: true,
+        };
+        let plain = render_contours_cached(&node, &kernel(), &mut GeomCache::new()).unwrap();
+        let (with_diag, _) =
+            render_contours_cached_diag(&node, &kernel(), &mut GeomCache::new()).unwrap();
+        assert_eq!(plain, with_diag);
+    }
+
+    #[test]
+    fn contour_diag_entrypoint_returns_none_for_3d() {
+        let node = Node::Cube {
+            size: [1.0, 1.0, 1.0],
+            center: false,
+        };
+        let (contours, diag) =
+            render_contours_cached_diag(&node, &kernel(), &mut GeomCache::new()).unwrap();
+        assert!(contours.is_none());
+        assert!(diag.warnings.is_empty() && diag.errors.is_empty());
+    }
+
+    #[test]
+    fn geom_message_ordering_is_well_defined_for_dedup() {
+        let mut v = vec![
+            GeomMessage {
+                code: GEOM_CODE_BOOLEAN_FALLBACK,
+                message: "b".into(),
+            },
+            GeomMessage {
+                code: GEOM_CODE_BOOLEAN_FALLBACK,
+                message: "b".into(),
+            },
+        ];
+        v.sort();
+        v.dedup();
+        assert_eq!(v.len(), 1);
+    }
+}
