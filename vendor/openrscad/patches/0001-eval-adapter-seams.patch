+/// Tests for the RNG-seed and budget-flag seams (patch `0001`).
+#[cfg(test)]
+mod adapter_rng_tests {
+    use super::*;
+
+    #[test]
+    fn scad_seed_random_state_makes_an_unseeded_stream_reproducible() {
+        let prog = openrscad_syntax::parse("echo(rands(0,1,3));").unwrap();
+        seed_random_state(7);
+        let first = eval_program(&prog).unwrap().echoes;
+        seed_random_state(7);
+        let repeat = eval_program(&prog).unwrap().echoes;
+        assert_eq!(first, repeat, "the same seed must reproduce the stream");
+        seed_random_state(8);
+        let other = eval_program(&prog).unwrap().echoes;
+        assert_ne!(first, other, "a different seed must change the stream");
+    }
+
+    #[test]
+    fn scad_budget_exhaustion_is_flagged_structurally() {
+        let err = eval_const_expr_with_budget("[for (i = [0:1000000]) i]", 1_000).unwrap_err();
+        assert!(
+            err.budget_exhausted,
+            "budget exhaustion must be classifiable without matching its message"
+        );
+    }
+}
