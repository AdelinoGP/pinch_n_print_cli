+/// Tests for the override-expression seam added by patch `0001`.
+#[cfg(test)]
+mod adapter_expr_tests {
+    use super::*;
+    use std::cell::Cell;
+
+    struct Recorder {
+        hits: Cell<usize>,
+    }
+
+    impl FileResolver for Recorder {
+        fn load(&self, _path: &str, _from_dir: &str) -> Option<LoadedFile> {
+            self.hits.set(self.hits.get() + 1);
+            None
+        }
+        fn load_bytes(&self, _path: &str, _from_dir: &str) -> Option<Vec<u8>> {
+            self.hits.set(self.hits.get() + 1);
+            None
+        }
+    }
+
+    #[test]
+    fn scad_const_expr_uses_the_callers_resolver() {
+        // `dxf_dim` reads through `load_bytes`; a `NullResolver` would hide the
+        // request from a host that must deny every external resource.
+        let recorder = Recorder { hits: Cell::new(0) };
+        let outcome = eval_const_expr_with_budget_and_resolver(
+            "dxf_dim(file = \"tempting.dxf\")",
+            1_000_000,
+            &recorder,
+        )
+        .expect("a missing DXF is a warning plus undef, not a hard error");
+        assert_eq!(
+            recorder.hits.get(),
+            1,
+            "the caller's resolver must observe the request"
+        );
+        // Both fail-closed signals a host needs: the unclassified warning and the
+        // undefined value that must never become an override binding.
+        assert!(outcome
+            .warnings
+            .iter()
+            .any(|w| w.code == WARN_CODE_OTHER && w.message.contains("tempting.dxf")));
+        assert!(matches!(outcome.value, Value::Undef));
+    }
+
+    #[test]
+    fn scad_const_expr_returns_its_own_warnings_and_echoes() {
+        let outcome =
+            eval_const_expr_with_budget_and_resolver("echo(7) 1", 1_000_000, &NullResolver)
+                .expect("an echo-prefixed expression evaluates");
+        assert!(
+            outcome.echoes.iter().any(|e| e.contains('7')),
+            "the expression's echo must be returned, not discarded: {:?}",
+            outcome.echoes
+        );
+        assert!(outcome.remaining < 1_000_000, "the expression is charged");
+    }
+}
