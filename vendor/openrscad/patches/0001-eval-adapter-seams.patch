+/// Tests for the adapter seams added by `patches/0001-eval-adapter-seams.patch`.
+/// Kept in their own module so the patch is additive to upstream's test body.
+#[cfg(test)]
+mod adapter_seam_tests {
+    use super::*;
+
+    #[test]
+    fn budgeted_const_expr_bounds_a_runaway_expression() {
+        // A single expression whose `for` range makes evaluation unbounded: the
+        // per-construct MAX_RANGE_ITERS cap alone would still allow 10M steps.
+        let err = eval_const_expr_with_budget("[for (i = [0:1000000]) i]", 1_000).unwrap_err();
+        assert!(err.message.contains("budget exhausted"), "{err:?}");
+    }
+
+    #[test]
+    fn budgeted_const_expr_reports_remaining_fuel_and_matches_unbudgeted_value() {
+        let (value, remaining) = eval_const_expr_with_budget("sqrt(2)*2", 1_000_000).unwrap();
+        assert!(remaining < 1_000_000, "the expression must be charged");
+        match (value, eval_const_expr("sqrt(2)*2").unwrap()) {
+            (Value::Number(a), Value::Number(b)) => assert_eq!(a, b),
+            _ => panic!("expected numeric values"),
+        }
+    }
+
+    #[test]
+    fn injected_second_statement_in_a_parameter_expression_is_rejected() {
+        // Upstream's `__orscad_const = (<src>);` wrapper discards trailing
+        // statements, but a caller-supplied second `__orscad_const` assignment
+        // would silently change which expression runs.
+        let err =
+            eval_const_expr_with_budget("1); cube(1); __orscad_const = (2", 1_000).unwrap_err();
+        assert!(
+            err.message.contains("exactly one expression"),
+            "expected an injection rejection, got: {err:?}"
+        );
+    }
+
+    #[test]
+    fn combined_entrypoint_applies_overrides_under_a_budget() {
+        let prog = openrscad_syntax::parse("x = 1;\necho(x);\n").unwrap();
+        let out = eval_program_with_budget_and_params(
+            &prog,
+            &NullResolver,
+            ".",
+            &[("x".to_string(), Value::Number(3.0))],
+            1_000_000,
+            RenderMode::Exact,
+        )
+        .unwrap();
+        assert_eq!(out.echoes, vec!["ECHO: 3".to_string()]);
+    }
+
+    #[test]
+    fn combined_entrypoint_reports_budget_exhaustion() {
+        let prog = openrscad_syntax::parse(
+            "for (a = [0:100000]) for (b = [0:100000]) translate([a, b, 0]) cube(1);",
+        )
+        .unwrap();
+        let err = eval_program_with_budget_and_params(
+            &prog,
+            &NullResolver,
+            ".",
+            &[],
+            100_000,
+            RenderMode::Exact,
+        )
+        .unwrap_err();
+        assert!(err.message.contains("budget exhausted"), "{err:?}");
+    }
+
+    #[test]
+    fn root_recursion_abort_is_structured_and_drops_trailing_statements() {
+        // Same contained-abort fixture upstream uses in
+        // `deep_recursion_is_non_fatal`: a real non-terminating recursion whose
+        // abort is caught at the root statement boundary. It needs the CLI's
+        // ample stack because the 6000-frame guard exceeds the 2 MiB test stack.
+        let src = "function cum(list, k) = (k == 0) ? 0 : cum(list, k - 1) + list[k - 1];\
+                   cube(3);\
+                   cube(cum([5], -1));\
+                   cube(7);";
+        let out = std::thread::Builder::new()
+            .stack_size(256 << 20)
+            .spawn(move || {
+                let prog = openrscad_syntax::parse(src).unwrap();
+                eval_program(&prog).unwrap()
+            })
+            .unwrap()
+            .join()
+            .unwrap();
+        assert!(
+            out.recursion_aborted,
+            "a retained-but-partial result must be identified structurally, not by prose"
+        );
+        assert!(out
+            .warnings
+            .iter()
+            .any(|w| w.code == WARN_CODE_RECURSION_ABORTED));
+        let inner = match &out.node {
+            Node::Provenance { child, .. } => child.as_ref(),
+            other => other,
+        };
+        assert_eq!(
+            inner,
+            &Node::Cube {
+                size: [3.0, 3.0, 3.0],
+                center: false
