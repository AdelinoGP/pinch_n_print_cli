+/// Seed the thread-local `rands()` stream.
+///
+/// `rands(min, max, count, seed)` reseeds itself from its own fourth argument,
+/// so a *seeded* program is already reproducible. This seam exists for the
+/// other half: a program that calls `rands()` **without** an explicit seed
+/// draws from a thread-local generator that advances across calls on the same
+/// thread, so two evaluations of the same source can differ. A host that wants a
+/// reproducible run of such a program calls this once before evaluating.
+///
+/// The generator is thread-local, so seeding one thread never affects another.
+pub fn seed_random_state(seed: u64) {
+    RNG_STATE.with(|c| c.set(seed.max(1)));
+}
