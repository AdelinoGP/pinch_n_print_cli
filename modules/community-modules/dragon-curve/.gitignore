# wit-bindgen output — regenerated by `make bindings`, never hand-edited.
/gen/
/interface/
/world/

# moon build output.
/_build/
/target/

# Intermediate core module produced between `component embed` and
# `component new`. Only dragon-curve.wasm is committed.
/embedded.wasm

# The root .gitignore excludes *.wasm, because every core-module artifact is
# rebuilt locally by `cargo xtask build-guests`. This module is deliberately
# outside that discovery walk, so nothing would ever rebuild it for a user who
# does not have the MoonBit toolchain installed. Design spec §1 requires the
# component to be committed for precisely that reason, so re-include it.
!/dragon-curve.wasm

# moon fmt rewrites moon.mod.json to moon.mod under the rr_moon_mod feature
# flag. moon.mod.json itself IS committed (wit-bindgen regenerates it with
# identical content) so `make test` works on a fresh clone without first
# running `make bindings`.
/moon.mod
