@@ -0,0 +1,128 @@
+//! [T68-PROBE] Temporary per-call recorder for the classic-perimeters
+//! per-layer host-service round-trip attribution (wayfinder perf-vs-orca
+//! ticket 68). Probe-only; reverted before any commit. See
+//! `docs/specs/perf-vs-orca/evidence/t68-host-roundtrips/`.
+//!
+//! A thread-local [`DispatchGuard`] names the module dispatch being watched
+//! (set by the runtime around the classic-perimeters `run_stage` call); every
+//! host-service call recorded while a guard is active is bucketed by
+//! `(owner, seq-within-dispatch)`, where `seq` follows the guest's fixed
+//! per-layer call order, so the buckets map 1:1 onto the guest's call sites.
+//! The recorder is global and mutex-protected; the `(owner, seq)` key is
+//! per-thread only in what it counts, while the sums aggregate across the
+//! concurrent per-layer workers, which is the intended meaning.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+thread_local! {
+    static CURRENT_OWNER: RefCell<Option<&'static str>> = const { RefCell::new(None) };
+    static CALL_SEQ: Cell<u32> = const { Cell::new(0) };
+}
+
+/// [T68-PROBE] RAII bracket naming the module dispatch whose host-service
+/// calls this recorder should attribute. Probe-only.
+pub struct DispatchGuard {
+    prev: Option<&'static str>,
+}
+
+impl DispatchGuard {
+    /// [T68-PROBE] Enter the bracket; resets the per-dispatch call sequence.
+    #[must_use]
+    pub fn new(name: &'static str) -> Self {
+        let prev = CURRENT_OWNER.with(|c| c.borrow_mut().replace(name));
+        CALL_SEQ.with(|s| s.set(0));
+        Self { prev }
+    }
+}
+
+impl Drop for DispatchGuard {
+    fn drop(&mut self) {
+        CURRENT_OWNER.with(|c| *c.borrow_mut() = self.prev);
+    }
+}
+
+#[derive(Clone, Default)]
+struct Bucket {
+    service: &'static str,
+    calls: u64,
+    in_polys: u64,
+    in_verts: u64,
+    out_polys: u64,
+    out_verts: u64,
+    conv_in_ns: u64,
+    ops_ns: u64,
+    conv_out_ns: u64,
+    sample_arg: f64,
+}
+
+static BUCKETS: Mutex<Option<HashMap<(&'static str, u32), Bucket>>> = Mutex::new(None);
+
+/// [T68-PROBE] Record one attributed host-service call (wall split into
+/// conversion-in, ops, conversion-out). No-op without an active dispatch
+/// bracket.
+#[allow(clippy::too_many_arguments)]
+pub fn note_call(
+    service: &'static str,
+    sample_arg: f64,
+    in_polys: u64,
+    in_verts: u64,
+    out_polys: u64,
+    out_verts: u64,
+    conv_in_ns: u64,
+    ops_ns: u64,
+    conv_out_ns: u64,
+) {
+    let owner = CURRENT_OWNER.with(|c| *c.borrow());
+    let Some(owner) = owner else { return };
+    let seq = CALL_SEQ.with(|s| {
+        let v = s.get();
+        s.set(v.wrapping_add(1));
+        v
+    });
+    let mut guard = BUCKETS.lock().expect("t68 probe buckets poisoned");
+    let map = guard.get_or_insert_with(HashMap::new);
+    let bucket = map.entry((owner, seq)).or_insert_with(|| Bucket {
+        service,
+        sample_arg,
+        ..Bucket::default()
+    });
+    bucket.calls += 1;
+    bucket.in_polys += in_polys;
+    bucket.in_verts += in_verts;
+    bucket.out_polys += out_polys;
+    bucket.out_verts += out_verts;
+    bucket.conv_in_ns += conv_in_ns;
+    bucket.ops_ns += ops_ns;
+    bucket.conv_out_ns += conv_out_ns;
+}
+
+/// [T68-PROBE] Dump per-(owner, seq) buckets to stderr; called once at slice
+/// end by the runtime's native-profiling teardown (requires `--profile`).
+pub fn dump() {
+    let map = BUCKETS
+        .lock()
+        .expect("t68 probe buckets poisoned")
+        .take()
+        .unwrap_or_default();
+    let mut rows: Vec<_> = map.into_iter().collect();
+    rows.sort_by_key(|((owner, seq), _)| (*owner, *seq));
+    for ((owner, seq), b) in rows {
+        eprintln!(
+            "[T68-PROBE] host owner={owner} seq={seq} service={} arg={:.4} calls={} \
+             in_polys={} in_verts={} out_polys={} out_verts={} conv_in_ns={} ops_ns={} \
+             conv_out_ns={}",
+            b.service,
+            b.sample_arg,
+            b.calls,
+            b.in_polys,
+            b.in_verts,
+            b.out_polys,
+            b.out_verts,
+            b.conv_in_ns,
+            b.ops_ns,
+            b.conv_out_ns
+        );
+    }
+}
