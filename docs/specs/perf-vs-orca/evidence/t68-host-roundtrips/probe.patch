 /// named constant in `arachne-perimeters`.
 const ERR_NEGATIVE_SPACING: u32 = 1;
 
+// ---------------------------------------------------------------------------
+// [T68-PROBE] temporary per-site round-trip timers (wayfinder perf-vs-orca
+// ticket 68). Reverted before any commit; probe-only, never in a shipped
+// artifact. See docs/specs/perf-vs-orca/evidence/t68-host-roundtrips/.
+// ---------------------------------------------------------------------------
+
+/// [T68-PROBE] accumulated guest-observed ns per call site (12 slots).
+static T68_NS: [std::sync::atomic::AtomicU64; 12] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 12];
+/// [T68-PROBE] executed-call counts per call site.
+static T68_CALLS: [std::sync::atomic::AtomicU64; 12] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 12];
+
+/// [T68-PROBE] Time one host-service call site via the `now_us` host service.
+#[inline]
+fn t68_time<T>(site: usize, f: impl FnOnce() -> T) -> T {
+    use std::sync::atomic::Ordering;
+    let t0 = slicer_sdk::host::now_us();
+    let result = f();
+    let t1 = slicer_sdk::host::now_us();
+    T68_NS[site].fetch_add(t1.wrapping_sub(t0), Ordering::Relaxed);
+    T68_CALLS[site].fetch_add(1, Ordering::Relaxed);
+    result
+}
+
+/// [T68-PROBE] Emit this invocation's per-site sums as one `module_log` line.
+fn t68_dump(layer_index: u32) {
+    use std::sync::atomic::Ordering;
+    let mut ns = String::new();
+    let mut calls = String::new();
+    for i in 0..12 {
+        if i > 0 {
+            ns.push(',');
+            calls.push(',');
+        }
+        ns.push_str(&T68_NS[i].swap(0, Ordering::Relaxed).to_string());
+        calls.push_str(&T68_CALLS[i].swap(0, Ordering::Relaxed).to_string());
+    }
+    slicer_sdk::host::log_info(&format!(
+        "[T68-PROBE] layer={layer_index} ns=[{ns}] calls=[{calls}]"
+    ));
+}
+
 /// AUTO selects the host's geometry-dependent base, not a zero multiplier.
 /// Keep positive configured-speed scaling and the emitter's clamp unchanged
 /// (docs/adr/0072-context-aware-feedrate-resolution-preserves-factor-contract.md).
@@ -619,6 +662,9 @@ impl LayerModule for ClassicPerimeters {
             }
         }
 
+        // [T68-PROBE] per-layer per-site round-trip dump (temporary; ticket 68).
+        t68_dump(layer_index);
+
         Ok(())
     }
 }
