diff --git a/src/prof.rs b/src/prof.rs
new file mode 100644
index 00000000..604eaa90
--- /dev/null
+++ b/src/prof.rs
@@ -0,0 +1,83 @@
+//! t70 profiling instrumentation (SCRATCH TWIN ONLY — never shipped).
+//!
+//! Phase tag + accumulated span/alloc buckets. The driver's GlobalAlloc reads
+//! `current_phase` so allocation count/bytes are attributed per engine phase.
+//! Instrumented runs are never mixed into wall claims (§3.2 trap).
+
+use std::cell::{Cell, RefCell};
+use std::time::Instant;
+
+pub const PHASE_OTHER: u32 = 0;
+pub const PHASE_ADD_PATH: u32 = 1;
+pub const PHASE_INSERT_LOCAL_MINIMA: u32 = 2;
+pub const PHASE_DO_HORIZONTAL: u32 = 3;
+pub const PHASE_BUILD_INTERSECT_LIST: u32 = 4;
+pub const PHASE_PROCESS_INTERSECT_LIST: u32 = 5;
+pub const PHASE_DO_TOP_OF_SCANBEAM: u32 = 6;
+pub const PHASE_CONVERT_HORZ_SEGS: u32 = 7;
+pub const PHASE_PROCESS_HORZ_JOINS: u32 = 8;
+pub const PHASE_CLEAN_UP: u32 = 9;
+pub const PHASE_CLEAN_COLLINEAR: u32 = 10;
+pub const PHASE_BUILD_RESULT: u32 = 11;
+pub const PHASE_GROUP_OFFSET: u32 = 12;
+pub const PHASE_OFFSET_SOLUTION_ADMIN: u32 = 13;
+pub const PHASE_TEARDOWN: u32 = 14;
+pub const PHASE_UNION_TOTAL: u32 = 15;
+pub const PHASE_SCANLINE_ADMIN: u32 = 16;
+pub const PHASE_LIST_CLEARS: u32 = 17;
+pub const PHASE_DO_MAXIMA: u32 = 18;
+pub const PHASE_DO_TOP_ELSE_TOPX: u32 = 19;
+pub const PHASE_COUNT: u32 = 24;
+
+thread_local! {
+    static PHASE: Cell<u32> = const { Cell::new(PHASE_OTHER) };
+    static SPANS_NS: RefCell<[u128; PHASE_COUNT as usize]> =
+        const { RefCell::new([0; PHASE_COUNT as usize]) };
+}
+
+/// Current phase — read by the driver's counting GlobalAlloc.
+pub fn current_phase() -> u32 {
+    PHASE.get()
+}
+
+/// Accumulated span time per phase (ns).
+pub fn spans() -> [u128; PHASE_COUNT as usize] {
+    SPANS_NS.with(|s| *s.borrow())
+}
+
+/// Zero all buckets (driver calls between cases).
+pub fn reset_buckets() {
+    SPANS_NS.with(|s| {
+        let mut b = s.borrow_mut();
+        *b = [0; PHASE_COUNT as usize];
+    });
+    PHASE.with(|p| p.set(PHASE_OTHER));
+}
+
+pub struct Span {
+    prev: u32,
+    phase: u32,
+    start: Instant,
+}
+
+/// Enter `phase`, restoring the previous phase on drop; accumulate elapsed.
+#[must_use]
+pub fn span(phase: u32) -> Span {
+    let prev = PHASE.replace(phase);
+    Span {
+        prev,
+        phase,
+        start: Instant::now(),
+    }
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        let elapsed = self.start.elapsed().as_nanos();
+        SPANS_NS.with(|s| {
+            let mut b = s.borrow_mut();
+            b[self.phase as usize] += elapsed;
+        });
+        PHASE.set(self.prev);
+    }
+}
