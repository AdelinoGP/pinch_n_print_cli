+/// t155 probe digest of the fields `prepare_regions` reads off a staged slice.
+fn t155_slice_read_digest(slice: &slicer_ir::SliceIR) -> (u64, usize) {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut points: usize = 0;
+    for region in &slice.regions {
+        hash = (hash ^ region.region_id as u64).wrapping_mul(0x100_0000_01b3);
+        hash = (hash ^ region.object_id.len() as u64).wrapping_mul(0x100_0000_01b3);
+        hash = (hash ^ u64::from(region.nonplanar_surface.is_some()))
+            .wrapping_mul(0x100_0000_01b3);
+        for polygon in &region.polygons {
+            for point in &polygon.contour.points {
+                hash = (hash ^ point.x as u64).wrapping_mul(0x100_0000_01b3);
+                hash = (hash ^ point.y as u64).wrapping_mul(0x100_0000_01b3);
+                points += 1;
+            }
+            for hole in &polygon.holes {
+                for point in &hole.points {
+                    hash = (hash ^ point.x as u64).wrapping_mul(0x100_0000_01b3);
+                    hash = (hash ^ point.y as u64).wrapping_mul(0x100_0000_01b3);
+                    points += 1;
+                }
+            }
+        }
+    }
+    (hash, points)
+}
