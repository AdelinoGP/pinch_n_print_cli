+/// t155 probe: axis-aligned bbox of an ExPolygon set, as (min_x, min_y, max_x, max_y).
+fn t155_region_bbox(polygons: &[slicer_ir::ExPolygon]) -> Option<(i64, i64, i64, i64)> {
+    let mut bbox: Option<(i64, i64, i64, i64)> = None;
+    for polygon in polygons {
+        for point in polygon
+            .contour
+            .points
+            .iter()
+            .chain(polygon.holes.iter().flat_map(|hole| hole.points.iter()))
+        {
+            bbox = Some(match bbox {
+                None => (point.x, point.y, point.x, point.y),
+                Some((min_x, min_y, max_x, max_y)) => (
+                    min_x.min(point.x),
+                    min_y.min(point.y),
+                    max_x.max(point.x),
+                    max_y.max(point.y),
+                ),
+            });
+        }
+    }
+    bbox
+}
