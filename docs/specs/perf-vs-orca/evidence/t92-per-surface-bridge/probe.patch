+/// t92 Phase-1 screening probe for the two boundary-anchor offsets —
+/// env-gated (`PNP_T92_PROBE=1`), attribution only, removed before the take
+/// closes. Global sums: the caller prints one summary after the slice.
+mod t92_probe {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::OnceLock;
+
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+
+    pub(super) fn enabled() -> bool {
+        *ENABLED.get_or_init(|| std::env::var_os("PNP_T92_PROBE").is_some())
+    }
+
+    pub(super) static TOTAL_FILL_NS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static LIMITING_NS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static CALLS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static TOTAL_FILL_POLYS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static LIMITING_POLYS: AtomicU64 = AtomicU64::new(0);
+
+    /// `factor` distinguishes the layer-constant `1.3 x` total-fill offset from
+    /// the per-candidate `0.3 x` limiting-area offset.
+    pub(super) fn record(area_polys: usize, factor: f32, nanos: u128) {
+        let target = if factor > 1.0 {
+            &TOTAL_FILL_NS
+        } else {
+            &LIMITING_NS
+        };
+        target.fetch_add(nanos as u64, Ordering::Relaxed);
+        CALLS.fetch_add(1, Ordering::Relaxed);
+        if factor > 1.0 {
+            TOTAL_FILL_POLYS.fetch_add(area_polys as u64, Ordering::Relaxed);
+        } else {
+            LIMITING_POLYS.fetch_add(area_polys as u64, Ordering::Relaxed);
+        }
+    }
+
+    pub(super) fn dump() {
+        if !enabled() {
+            return;
+        }
+        let ms = |counter: &AtomicU64| counter.load(Ordering::Relaxed) as f64 / 1.0e6;
+        eprintln!(
+            "T92ANCHORS calls={} total_fill_polys={} limiting_polys={} \
+total_fill_offset_ms={:.3} limiting_offset_ms={:.3}",
+            CALLS.load(Ordering::Relaxed),
+            TOTAL_FILL_POLYS.load(Ordering::Relaxed),
+            LIMITING_POLYS.load(Ordering::Relaxed),
+            ms(&TOTAL_FILL_NS),
+            ms(&LIMITING_NS),
+        );
+    }
+}
+
+/// t92 Phase-1 screening: print the accumulated boundary-anchor offset split.
+/// Env-gated, attribution only; removed before the take closes.
+pub fn dump_boundary_anchor_probe() {
+    t92_probe::dump();
+}
