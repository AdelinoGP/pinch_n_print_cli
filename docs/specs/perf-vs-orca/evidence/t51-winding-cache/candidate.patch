+// These direct-f64 endpoints must never be borrowed from the f32-rounded distance index.
+struct PreparedWindingContour {
+    points: Vec<[f64; 2]>,
+}
+
+impl PreparedWindingContour {
+    fn new(ring: &Polygon) -> Self {
+        Self {
+            points: ring
+                .points
+                .iter()
+                .map(|point| [point.x as f64 / 10_000.0, point.y as f64 / 10_000.0])
+                .collect(),
+        }
+    }
+
+    fn contains(&self, px: f64, py: f64) -> bool {
+        let n = self.points.len();
+        if n < 3 {
+            return false;
+        }
+        for i in 0..n {
+            let [ax, ay] = self.points[i];
+            let [bx, by] = self.points[(i + 1) % n];
+            let dx = bx - ax;
+            let dy = by - ay;
+            let len2 = dx * dx + dy * dy;
+            let distance_sq = if len2 == 0.0 {
+                let ex = px - ax;
+                let ey = py - ay;
+                ex * ex + ey * ey
+            } else {
+                let t = (((px - ax) * dx + (py - ay) * dy) / len2).clamp(0.0, 1.0);
+                let cx = ax + t * dx;
+                let cy = ay + t * dy;
+                let ex = px - cx;
+                let ey = py - cy;
+                ex * ex + ey * ey
+            };
+            if distance_sq <= 0.0 {
+                return true;
+            }
+        }
+        let mut winding = 0_i32;
+        for i in 0..n {
+            let [ax, ay] = self.points[i];
+            let [bx, by] = self.points[(i + 1) % n];
+            if ay <= py {
+                if by > py && (bx - ax) * (py - ay) - (px - ax) * (by - ay) > 0.0 {
+                    winding += 1;
+                }
+            } else if by <= py && (bx - ax) * (py - ay) - (px - ax) * (by - ay) < 0.0 {
+                winding -= 1;
+            }
+        }
+        winding != 0
+    }
+}
