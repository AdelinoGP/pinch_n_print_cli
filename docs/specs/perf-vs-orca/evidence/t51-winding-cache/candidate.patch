+#[test]
+fn prepared_full_queries_match_full_scan_on_raw_unit_precision_boundaries() {
+    use slicer_core::perimeter_spatial::{diagnostics, PerimeterSpatialContext};
+
+    let cases = [
+        (16_777_217_i64, -10_000_i64, 50_000_i64, 20_000_i64),
+        (i64::MIN + 65_536, -32_768, 65_536, 65_536),
+        (i64::MAX - 131_072, -32_768, 65_536, 65_536),
+        (
+            -900_000_000_000_000,
+            -900_000_000_000_000,
+            1_800_000_000_000_000,
+            1_800_000_000_000_000,
+        ),
+    ];
+    for (left, bottom, width, height) in cases {
+        let ring = Polygon {
+            points: vec![
+                Point2 { x: left, y: bottom },
+                Point2 {
+                    x: left + width,
+                    y: bottom,
+                },
+                Point2 {
+                    x: left + width,
+                    y: bottom + height,
+                },
+                Point2 {
+                    x: left,
+                    y: bottom + height,
+                },
+            ],
+        };
+        // A distinct second contour keeps both trees indexed and tests source alignment.
+        let boundary = vec![
+            ExPolygon {
+                contour: ring.clone(),
+                holes: vec![],
+            },
+            expolygon_mm(
+                &[(-10.0, -10.0), (10.0, -10.0), (10.0, 10.0), (-10.0, 10.0)],
+                &[],
+            ),
+        ];
+        let mut queries = vec![(0.0_f32, 0.0_f32)];
+        for point in &ring.points {
+            let x = (point.x as f64 / 10_000.0) as f32;
+            let y = (point.y as f64 / 10_000.0) as f32;
+            queries.extend([
+                (x, y),
+                (x.next_up(), y),
+                (x.next_down(), y),
+                (x, y.next_up()),
+                (x, y.next_down()),
+            ]);
+        }
+        let expected: Vec<_> = queries
+            .iter()
+            .map(|&(x, y)| signed_distance_to_boundary(x, y, &boundary).to_bits())
+            .collect();
+        let mut reference_ordinals = None;
+        for (accelerated, inject_fault) in [(true, true), (false, false), (true, false)] {
+            let (actual, counters, ordinals) = diagnostics::with_counters_and_distance_selections(
+                accelerated,
+                inject_fault,
+                || {
+                    let context = PerimeterSpatialContext::new(&boundary, &[], &[]);
+                    queries
+                        .iter()
+                        .map(|&(x, y)| context.signed_distance_to_boundary(x, y).to_bits())
+                        .collect::<Vec<_>>()
+                },
+            );
+            assert_eq!(
+                actual, expected,
+                "raw-unit full queries at {left}, mode={accelerated}, fault={inject_fault}"
+            );
+            if let Some(reference) = &reference_ordinals {
+                assert_eq!(
+                    &ordinals, reference,
+                    "source-order selections at raw-unit {left}"
+                );
+            } else {
+                reference_ordinals = Some(ordinals);
+            }
+            if inject_fault {
+                assert_eq!(counters.fallback_queries, queries.len());
+            } else if accelerated {
+                assert_eq!(
+                    counters.indexed_queries,
+                    queries.len(),
+                    "precision queries must exercise indexed cache routing"
+                );
+                assert_eq!(counters.fallback_queries, 0);
+                assert_eq!(counters.legacy_queries, 0);
+            } else {
+                assert_eq!(counters.legacy_queries, queries.len());
+                assert_eq!(counters.fallback_queries, 0);
+            }
+        }
+    }
+}
