+#[test]
+fn prepared_distance_matches_full_scan_bits_and_forced_fallbacks() {
+    use slicer_core::perimeter_spatial::{diagnostics, PerimeterSpatialContext};
+
+    let fixture = adversarial_fixture();
+    let mut queries = query_points();
+    queries.extend([
+        (5.0, 0.0),
+        (10.0, 0.0),
+        (10.0_f32.next_up(), 0.0),
+        (10.0_f32.next_down(), 0.0),
+        (f32::NAN, 0.0),
+        (0.0, f32::NAN),
+        (f32::INFINITY, 0.0),
+        (0.0, f32::NEG_INFINITY),
+    ]);
+    assert!(!queries.is_empty());
+    let expected: Vec<_> = queries
+        .iter()
+        .map(|&(x, y)| signed_distance_to_boundary(x, y, &fixture.boundary).to_bits())
+        .collect();
+    for (accelerated, inject_fault) in [(false, false), (true, false), (true, true)] {
+        let (actual, counters, ordinals) =
+            diagnostics::with_counters_and_distance_selections(accelerated, inject_fault, || {
+                let context = PerimeterSpatialContext::new(&fixture.boundary, &[], &[]);
+                queries
+                    .iter()
+                    .map(|&(x, y)| context.signed_distance_to_boundary(x, y).to_bits())
+                    .collect::<Vec<_>>()
+            });
+        assert_eq!(actual, expected, "mode={accelerated} fault={inject_fault}");
+        assert_eq!(
+            ordinals[1],
+            Some(4),
+            "center tie must select first hole edge"
+        );
+        assert_eq!(counters.contexts_constructed, 1);
+        if inject_fault {
+            assert_eq!(counters.fallback_queries, queries.len());
+            assert_eq!(counters.legacy_queries, queries.len());
+            assert_eq!(counters.indexed_queries, 0);
+        } else if accelerated {
+            assert!(counters.indexed_queries > 0);
+            assert_eq!(counters.fallback_queries, 4);
+            assert_eq!(
+                counters.indexed_queries + counters.fallback_queries,
+                queries.len()
+            );
+        } else {
+            assert_eq!(counters.legacy_queries, queries.len());
+            assert_eq!(counters.indexed_queries, 0);
+            assert_eq!(counters.fallback_queries, 0);
+        }
+    }
+}
