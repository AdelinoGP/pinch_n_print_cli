+#[test]
+fn quartile_bbox_matches_unchanged_predicate_at_large_and_rounding_sensitive_coordinates() {
+    use slicer_core::perimeter_spatial::{diagnostics::with_counters, PerimeterSpatialContext};
+    let mut rings = Vec::new();
+    for origin in [
+        i64::MIN + 2048,
+        -9_000_000_000_000_000,
+        -10_003,
+        0,
+        10_003,
+        i64::MAX - 4096,
+    ] {
+        rings.push(ExPolygon {
+            contour: Polygon {
+                points: vec![
+                    Point2 {
+                        x: origin,
+                        y: origin,
+                    },
+                    Point2 {
+                        x: origin + 2048,
+                        y: origin,
+                    },
+                    Point2 {
+                        x: origin + 2048,
+                        y: origin + 2048,
+                    },
+                    Point2 {
+                        x: origin,
+                        y: origin + 2048,
+                    },
+                ],
+            },
+            holes: vec![],
+        });
+    }
+    // Cancellation in a + (b - a), and a nearly horizontal sloped edge.
+    rings.push(ExPolygon {
+        contour: Polygon {
+            points: vec![
+                Point2 { x: i64::MIN, y: -1 },
+                Point2 { x: 1, y: 0 },
+                Point2 { x: i64::MAX, y: 1 },
+            ],
+        },
+        holes: vec![],
+    });
+    let points = rings
+        .iter()
+        .flat_map(|p| p.contour.points.iter())
+        .flat_map(|p| {
+            let x = (p.x as f64 / 10_000.0) as f32;
+            let y = (p.y as f64 / 10_000.0) as f32;
+            [
+                (x, y),
+                (x.next_up(), y),
+                (x.next_down(), y),
+                (x, y.next_up()),
+                (x, y.next_down()),
+                (0.0, y),
+            ]
+        })
+        .collect::<Vec<_>>();
+    assert!(!points.is_empty());
+    let bands = vec![QuartileBand {
+        quartile: 3,
+        polygons: rings,
+    }];
+    let expected = points
+        .iter()
+        .map(|&(x, y)| {
+            bands[0]
+                .polygons
+                .iter()
+                .any(|p| slicer_ir::point_in_polygon_winding(p, f64::from(x), f64::from(y), 0.0))
+                .then_some(3)
+        })
+        .collect::<Vec<_>>();
+    assert!(expected.iter().any(Option::is_some));
+    assert!(expected.iter().any(Option::is_none));
+    for accelerated in [false, true] {
+        let (observed, _) = with_counters(accelerated, false, || {
+            let context = PerimeterSpatialContext::new(&[], &bands, &[]);
+            points
+                .iter()
+                .map(|&(x, y)| context.overhang_quartile(x, y))
+                .collect::<Vec<_>>()
+        });
+        assert_eq!(observed, expected);
+    }
+}
