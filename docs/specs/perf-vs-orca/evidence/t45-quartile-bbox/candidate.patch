+fn quartile_contour_bounds(bands: &[QuartileBand]) -> Vec<Vec<Option<AABB<[f64; 2]>>>> {
+    bands
+        .iter()
+        .map(|band| {
+            band.polygons
+                .iter()
+                .map(|polygon| {
+                    let points = &polygon.contour.points;
+                    if points.len() < 3 {
+                        return None;
+                    }
+                    let mut lower = [f64::INFINITY; 2];
+                    let mut upper = [f64::NEG_INFINITY; 2];
+                    for i in 0..points.len() {
+                        let a = points[i];
+                        let b = points[(i + 1) % points.len()];
+                        for (axis, (a, b)) in [(a.x, b.x), (a.y, b.y)].into_iter().enumerate() {
+                            let a = winding_coordinate(a);
+                            let b = winding_coordinate(b);
+                            // Cover both raw winding endpoints and the segment-distance
+                            // evaluator's effective endpoint, including cancellation.
+                            let effective_b = a + (b - a);
+                            // Outward slack also covers rounded winding cross products
+                            // just outside a raw bound. Integer coordinates converted
+                            // to f64 stay finite, as do all predicate intermediates for
+                            // finite f32 queries. No hole subtraction is introduced.
+                            let slack = 16.0 * f64::EPSILON * a.abs().max(b.abs()).max(1.0);
+                            lower[axis] =
+                                lower[axis].min(next_down(a.min(b).min(effective_b) - slack));
+                            upper[axis] =
+                                upper[axis].max(next_up(a.max(b).max(effective_b) + slack));
+                        }
+                    }
+                    Some(AABB::from_corners(lower, upper))
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn quartile_bbox_may_contain(bounds: Option<&AABB<[f64; 2]>>, x: f32, y: f32) -> bool {
+    if !x.is_finite() || !y.is_finite() {
+        return true;
+    }
+    let Some(bounds) = bounds else {
+        return false;
+    };
+    let lower = bounds.lower();
+    let upper = bounds.upper();
+    let x = f64::from(x);
+    let y = f64::from(y);
+    x >= lower[0] && x <= upper[0] && y >= lower[1] && y <= upper[1]
+}
