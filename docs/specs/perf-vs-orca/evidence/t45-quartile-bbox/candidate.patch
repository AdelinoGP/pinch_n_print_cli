+#[test]
+fn quartile_bbox_prunes_same_y_disjoint_x_without_changing_winding_verdicts() {
+    use slicer_core::perimeter_spatial::{diagnostics::with_counters, PerimeterSpatialContext};
+    let polygons = (0..32)
+        .map(|i| {
+            let x = (i * 20) as f32;
+            expolygon_mm(
+                &[(x, -5.0), (x + 10.0, -5.0), (x + 10.0, 5.0), (x, 5.0)],
+                &[],
+            )
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(polygons.len(), 32);
+    let bands = vec![QuartileBand {
+        quartile: 4,
+        polygons,
+    }];
+    let (quartile, counters) = with_counters(true, false, || {
+        PerimeterSpatialContext::new(&[], &bands, &[]).overhang_quartile(5.0, 0.0)
+    });
+    assert_eq!(quartile, Some(4));
+    assert_eq!(counters.indexed_queries, 1);
+    assert_eq!(
+        counters.exact_evaluations, 1,
+        "only the containing polygon should reach the exact scan"
+    );
+    let points = (0..640).map(|x| (x as f32, 0.0)).collect::<Vec<_>>();
+    assert!(!points.is_empty());
+    let expected = points
+        .iter()
+        .map(|&(x, y)| {
+            bands
+                .iter()
+                .filter(|band| {
+                    band.polygons.iter().any(|p| {
+                        slicer_ir::point_in_polygon_winding(p, f64::from(x), f64::from(y), 0.0)
+                    })
+                })
+                .map(|b| b.quartile)
+                .max()
+        })
+        .collect::<Vec<_>>();
+    for accelerated in [false, true] {
+        let (observed, _) = with_counters(accelerated, false, || {
+            let context = PerimeterSpatialContext::new(&[], &bands, &[]);
+            points
+                .iter()
+                .map(|&(x, y)| context.overhang_quartile(x, y))
+                .collect::<Vec<_>>()
+        });
+        assert_eq!(observed, expected);
+    }
+}
