+// [T64-SDK-PROBE] temporary counters for the paint-policy query; observation
+// only, inverted before any commit.
+#[allow(missing_docs, dead_code, unused_imports)]
+mod t64_sdk_probe {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    const C_QUERIES: usize = 0;
+    const C_REGIONS: usize = 1;
+    const C_COVER_HITS: usize = 2;
+    const C_VERT_LOOPS: usize = 3;
+    const C_RING_CALLS: usize = 4;
+    const C_RING_EDGES: usize = 5;
+    const C_RING_FLIPS: usize = 6;
+    const C_ELIG_CHECKS: usize = 7;
+
+    const COUNT: usize = 8;
+    const NAMES: [&str; COUNT] = [
+        "queries",
+        "cover_regions",
+        "cover_hits",
+        "vert_loops",
+        "ring_calls",
+        "ring_edges",
+        "ring_flips",
+        "elig_checks",
+    ];
+
+    static COUNTERS: [AtomicU64; COUNT] = [const { AtomicU64::new(0) }; COUNT];
+
+    #[inline]
+    fn bump(index: usize, amount: u64) {
+        COUNTERS[index].fetch_add(amount, Ordering::Relaxed);
+    }
+
+    /// Snapshot-and-zero handle for one query.
+    pub struct Query([u64; COUNT]);
+
+    #[cfg(target_arch = "wasm32")]
+    pub fn begin() -> Query {
+        let mut snapshot = [0u64; COUNT];
+        for (index, value) in snapshot.iter_mut().enumerate() {
+            *value = COUNTERS[index].load(Ordering::Relaxed);
+        }
+        bump(C_QUERIES, 1);
+        Query(snapshot)
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    pub fn begin() -> Query {
+        bump(C_QUERIES, 1);
+        Query([0u64; COUNT])
+    }
+
+    /// Emits one per-query trace line and zeroes the counters. Zeroing is
+    /// wasm-only: wasm statics are per-instance (single-threaded per instance),
+    /// while native statics are process-global and concurrent native legs must
+    /// not clobber each other.
+    #[cfg(target_arch = "wasm32")]
+    pub fn end(query: Query) {
+        let mut values = [0u64; COUNT];
+        for (index, place) in values.iter_mut().enumerate() {
+            let now = COUNTERS[index].load(Ordering::Relaxed);
+            *place = now.saturating_sub(query.0[index]);
+            COUNTERS[index].store(0, Ordering::Relaxed);
         }
+        let taken = values;
+        let line: String = NAMES
+            .iter()
+            .zip(taken.iter())
+            .map(|(name, value)| format!("{name}={value}"))
+            .collect::<Vec<_>>()
+            .join(" ");
+        crate::host::log_trace(&format!("T64-SDK {line}"));
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    pub fn end(query: Query) {
+        let _ = query;
+    }
+
+    pub fn regions(count: u64) {
+        bump(C_REGIONS, count);
+    }
+    pub fn cover_hit() {
+        bump(C_COVER_HITS, 1);
+    }
+    pub fn vert_loops(count: u64) {
+        bump(C_VERT_LOOPS, count);
+    }
+    pub fn ring_call(edges: u64) {
+        bump(C_RING_CALLS, 1);
+        bump(C_RING_EDGES, edges);
+    }
+    pub fn ring_flip() {
+        bump(C_RING_FLIPS, 1);
+    }
+    pub fn elig_checks(count: u64) {
+        bump(C_ELIG_CHECKS, count);
     }
 }
 
