+    /// T95 PROBE — batch every requested Z of every queried object through one
+    /// `slice_mesh_ex` call and compare each plane against the production
+    /// single-Z result. Attribution only: it runs after the production loop and
+    /// changes no emitted byte.
+    pub fn probe_batch_cross_sections(&self) {
+        if !t95_enabled() {
+            return;
+        }
+        let (queries, misses, records) = {
+            let mut sink = t95_sink().lock().unwrap();
+            (sink.queries, sink.misses, std::mem::take(&mut sink.records))
+        };
+        let mut by_object: HashMap<String, Vec<(f32, u64, Vec<ExPolygon>)>> = HashMap::new();
+        for record in records {
+            by_object.entry(record.object_id).or_default().push((
+                record.z_mm,
+                record.ns,
+                record.occupancy,
+            ));
+        }
+        for (object_id, mut recs) in by_object {
+            recs.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap_or(std::cmp::Ordering::Equal));
+            let distinct_z = recs
+                .windows(2)
+                .filter(|pair| pair[0].0 != pair[1].0)
+                .count()
+                + usize::from(!recs.is_empty());
+            let zs: Vec<f32> = recs.iter().map(|record| record.0).collect();
+            let Ok(geometry) = self.object_geometry(&object_id) else {
+                continue;
+            };
+            let triangles = geometry.world_mesh.indices.len() / 3;
+            let vertices = geometry.world_mesh.vertices.len();
+            let start = Instant::now();
+            let batch = slice_mesh_ex(&geometry.world_mesh, &zs);
+            let batch_ns = start.elapsed().as_nanos() as u64;
+            let mut equal = 0usize;
+            let mut mismatch = 0usize;
+            let mut first_mismatch = String::new();
+            let mut batch_polys = 0usize;
+            let mut production_polys = 0usize;
+            for (index, (z, _, production)) in recs.iter().enumerate() {
+                let got = batch.get(index).cloned().unwrap_or_default();
+                batch_polys += got.len();
+                production_polys += production.len();
+                if &got == production {
+                    equal += 1;
+                } else {
+                    mismatch += 1;
+                    if first_mismatch.is_empty() {
+                        first_mismatch = format!(
+                            "z={z:.6} batch_polys={} production_polys={}",
+                            got.len(),
+                            production.len()
+                        );
+                    }
+                }
+            }
+            let mut per_query: Vec<u64> = recs.iter().map(|record| record.1).collect();
+            per_query.sort_unstable();
+            let min = per_query.first().copied().unwrap_or(0);
+            let median = per_query.get(per_query.len() / 2).copied().unwrap_or(0);
+            let max = per_query.last().copied().unwrap_or(0);
+            let single_ns_total: u64 = per_query.iter().sum();
+            eprintln!(
+                "T95 BATCH object={object_id} vertices={vertices} triangles={triangles} \
+                 queries={queries} misses={misses} object_misses={} distinct_z={distinct_z} \
+                 single_ns_total={single_ns_total} single_ns_min={min} \
+                 single_ns_median={median} single_ns_max={max} batch_ns={batch_ns} \
+                 equal={equal} mismatch={mismatch} first_mismatch={first_mismatch:?} \
+                 batch_polys={batch_polys} production_polys={production_polys}",
+                recs.len()
+            );
+        }
+        let mut sink = t95_sink().lock().unwrap();
+        sink.queries = 0;
+        sink.misses = 0;
+        sink.cross_section_ns = 0;
+    }
