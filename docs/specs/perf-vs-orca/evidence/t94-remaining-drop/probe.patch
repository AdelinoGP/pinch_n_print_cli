+/// t94 Phase-1 probe — env-gated (`PNP_T94_PROBE=1`), attribution only,
+/// removed before the take closes. Splits the `host:gcode_emit` bracket into
+/// cross-layer rotation, emission walk and collection drop, and can free the
+/// collection in parallel (`PNP_T94_PARALLEL=1`) to price that counterfactual.
+/// Never changes emitted bytes.
+mod t94_probe {
+    use std::sync::OnceLock;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    static PARALLEL: OnceLock<bool> = OnceLock::new();
+
+    pub(super) fn enabled() -> bool {
+        *ENABLED.get_or_init(|| std::env::var_os("PNP_T94_PROBE").is_some())
+    }
+
+    pub(super) fn parallel() -> bool {
+        *PARALLEL.get_or_init(|| std::env::var_os("PNP_T94_PARALLEL").is_some())
+    }
+
+    /// Microseconds since the Unix epoch. `SystemTime`, not `Instant`, per the
+    /// t88 probe trap (an `Instant` read disagreed with the event timestamps by
+    /// the width of an earlier phase).
+    pub(super) fn now_us() -> u128 {
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|duration| duration.as_micros())
+            .unwrap_or(0)
+    }
+}
