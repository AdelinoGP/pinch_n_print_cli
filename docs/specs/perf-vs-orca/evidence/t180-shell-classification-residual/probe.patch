+        for s in STAGE_SITES {
+            s.reset();
+        }
+        C.reset();
+        *DISTS.lock().unwrap() = Some(DistStore::default());
+        t180_probe::set_active(true);
+        Some(out)
+    }
+
+    pub fn update_max(atom: &AtomicU64, val: u64) {
+        let mut prev = atom.load(Ordering::Relaxed);
+        while val > prev {
+            match atom.compare_exchange_weak(prev, val, Ordering::Relaxed, Ordering::Relaxed) {
+                Ok(_) => break,
+                Err(cur) => prev = cur,
+            }
+        }
+    }
+
+    pub fn bbox_of(polys: &[ExPolygon]) -> Option<(i64, i64, i64, i64)> {
+        let mut min_x = i64::MAX;
+        let mut min_y = i64::MAX;
+        let mut max_x = i64::MIN;
+        let mut max_y = i64::MIN;
+        let mut any = false;
+        for p in polys {
+            for pt in &p.contour.points {
+                min_x = min_x.min(pt.x);
+                min_y = min_y.min(pt.y);
+                max_x = max_x.max(pt.x);
+                max_y = max_y.max(pt.y);
+                any = true;
+            }
+        }
+        any.then_some((min_x, min_y, max_x, max_y))
+    }
+
+    pub fn bbox_of_one(p: &ExPolygon) -> Option<(i64, i64, i64, i64)> {
+        bbox_of(std::slice::from_ref(p))
+    }
+
+    pub fn bboxes_overlap(a: (i64, i64, i64, i64), b: (i64, i64, i64, i64)) -> bool {
+        a.0 <= b.2 && b.0 <= a.2 && a.1 <= b.3 && b.1 <= a.3
+    }
+
+    pub fn count_slivers(polys: &[ExPolygon], min_dim_units: i64) -> u64 {
+        polys
+            .iter()
+            .filter(|p| {
+                bbox_of_one(p).is_none_or(|(x0, y0, x1, y1)| {
+                    (x1 - x0) <= min_dim_units || (y1 - y0) <= min_dim_units
+                })
+            })
+            .count() as u64
+    }
+
+    pub fn verts_in_bbox(polys: &[ExPolygon], b: (i64, i64, i64, i64)) -> u64 {
+        let mut inside = 0u64;
+        for p in polys {
+            for ring in std::iter::once(&p.contour).chain(p.holes.iter()) {
+                for pt in &ring.points {
+                    if pt.x >= b.0 && pt.x <= b.2 && pt.y >= b.1 && pt.y <= b.3 {
+                        inside += 1;
+                    }
+                }
+            }
+        }
+        inside
+    }
+
+    pub fn dist_json(items: &[(u32, u64)]) -> String {
+        if items.is_empty() {
+            return "{\"count\":0,\"sum_ns\":0,\"p50_ns\":0,\"p90_ns\":0,\"p95_ns\":0,\"p99_ns\":0,\"max_ns\":0,\"max_idx\":0}".into();
+        }
+        let mut sorted: Vec<(u32, u64)> = items.to_vec();
+        sorted.sort_by_key(|&(_, ns)| ns);
+        let n = sorted.len();
+        let sum: u64 = sorted.iter().map(|&(_, ns)| ns).sum();
+        let pct = |p: f64| -> u64 {
+            let idx = ((n - 1) as f64 * p).round() as usize;
+            sorted[idx.min(n - 1)].1
+        };
+        let (max_idx, max_ns) = sorted[n - 1];
+        format!(
+            "{{\"count\":{},\"sum_ns\":{},\"p50_ns\":{},\"p90_ns\":{},\"p95_ns\":{},\"p99_ns\":{},\"max_ns\":{},\"max_idx\":{}}}",
+            n, sum, pct(0.50), pct(0.90), pct(0.95), pct(0.99), max_ns, max_idx
+        )
+    }
+
+    pub fn finish_and_write(path: &str) {
+        t180_probe::set_active(false);
+        let dists = DISTS.lock().unwrap().take().unwrap_or_default();
+        let mut sites_json = Vec::new();
+        for s in STAGE_SITES {
+            sites_json.push(s.to_json());
+        }
+        for s in CORE_SITES {
+            sites_json.push(s.to_json());
+        }
+        let recomp_json: Vec<String> = dists
+            .ib_recomp_layers
+            .iter()
+            .map(|(l, ns, ovl)| format!("{{\"layer\":{},\"ns\":{},\"ovl_is\":{}}}", l, ns, ovl))
+            .collect();
+        let body = format!(
+            "{{\n  \"counters\": {},\n  \"gather_layers\": {{\"layers_1\":{},\"layers_gt1\":{}}},\n  \"dists\": {{\n    \"pass1\": {},\n    \"p2t_proj\": {},\n    \"p2b_proj\": {},\n    \"b4_ext_bridge\": {},\n    \"ib_phase_a\": {},\n    \"ib_phase_b_precomp\": {}\n  }},\n  \"ib_recomp_layers\": [{}],\n  \"sites\": [\n    {}\n  ]\n}}\n",
+            C.to_json(),
+            t180_probe::IB_GATHER_LAYERS_1.load(Ordering::SeqCst),
+            t180_probe::IB_GATHER_LAYERS_GT1.load(Ordering::SeqCst),
+            dist_json(&dists.pass1_items),
+            dist_json(&dists.p2t_items),
+            dist_json(&dists.p2b_items),
+            dist_json(&dists.b4_items),
+            dist_json(&dists.ib_a_items),
+            dist_json(&dists.ib_b_items),
+            recomp_json.join(","),
+            sites_json.join(",\n    ")
+        );
+        let _ = std::fs::write(path, body);
+    }
+
+    pub use t180_probe::{count_verts as cverts, is_active as active, record_ex as rec_ex, record_single as rec1};
+}
