+    pub static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+    #[inline]
+    pub fn is_active() -> bool {
+        ACTIVE.load(Ordering::Relaxed)
+    }
+
+    pub fn set_active(v: bool) {
+        ACTIVE.store(v, Ordering::SeqCst);
+    }
+
+    pub struct SiteStats {
+        pub name: &'static str,
+        pub op_kind: &'static str,
+        pub calls: AtomicU64,
+        pub total_ns: AtomicU64,
+        pub max_ns: AtomicU64,
+        pub in_polys: AtomicU64,
+        pub in_verts: AtomicU64,
+        pub out_polys: AtomicU64,
+        pub out_verts: AtomicU64,
+        pub empty_in: AtomicU64,
+        pub empty_out: AtomicU64,
+    }
+
+    impl SiteStats {
+        pub const fn new(name: &'static str, op_kind: &'static str) -> Self {
+            Self {
+                name,
+                op_kind,
+                calls: AtomicU64::new(0),
+                total_ns: AtomicU64::new(0),
+                max_ns: AtomicU64::new(0),
+                in_polys: AtomicU64::new(0),
+                in_verts: AtomicU64::new(0),
+                out_polys: AtomicU64::new(0),
+                out_verts: AtomicU64::new(0),
+                empty_in: AtomicU64::new(0),
+                empty_out: AtomicU64::new(0),
+            }
+        }
+
+        pub fn reset(&self) {
+            self.calls.store(0, Ordering::SeqCst);
+            self.total_ns.store(0, Ordering::SeqCst);
+            self.max_ns.store(0, Ordering::SeqCst);
+            self.in_polys.store(0, Ordering::SeqCst);
+            self.in_verts.store(0, Ordering::SeqCst);
+            self.out_polys.store(0, Ordering::SeqCst);
+            self.out_verts.store(0, Ordering::SeqCst);
+            self.empty_in.store(0, Ordering::SeqCst);
+            self.empty_out.store(0, Ordering::SeqCst);
+        }
+
+        #[inline]
+        pub fn record(
+            &self,
+            dt_ns: u64,
+            in_p: u64,
+            in_v: u64,
+            out_p: u64,
+            out_v: u64,
+            empty_in: bool,
+            empty_out: bool,
+        ) {
+            self.calls.fetch_add(1, Ordering::Relaxed);
+            self.total_ns.fetch_add(dt_ns, Ordering::Relaxed);
+            let mut prev = self.max_ns.load(Ordering::Relaxed);
+            while dt_ns > prev {
+                match self.max_ns.compare_exchange_weak(
+                    prev,
+                    dt_ns,
+                    Ordering::Relaxed,
+                    Ordering::Relaxed,
+                ) {
+                    Ok(_) => break,
+                    Err(cur) => prev = cur,
+                }
+            }
+            self.in_polys.fetch_add(in_p, Ordering::Relaxed);
+            self.in_verts.fetch_add(in_v, Ordering::Relaxed);
+            self.out_polys.fetch_add(out_p, Ordering::Relaxed);
+            self.out_verts.fetch_add(out_v, Ordering::Relaxed);
+            if empty_in {
+                self.empty_in.fetch_add(1, Ordering::Relaxed);
+            }
+            if empty_out {
+                self.empty_out.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+
+        pub fn to_json(&self) -> String {
+            format!(
+                "{{\"name\":\"{}\",\"op_kind\":\"{}\",\"calls\":{},\"total_ns\":{},\"max_ns\":{},\"in_polys\":{},\"in_verts\":{},\"out_polys\":{},\"out_verts\":{},\"empty_in\":{},\"empty_out\":{}}}",
+                self.name,
+                self.op_kind,
+                self.calls.load(Ordering::SeqCst),
+                self.total_ns.load(Ordering::SeqCst),
+                self.max_ns.load(Ordering::SeqCst),
+                self.in_polys.load(Ordering::SeqCst),
+                self.in_verts.load(Ordering::SeqCst),
+                self.out_polys.load(Ordering::SeqCst),
+                self.out_verts.load(Ordering::SeqCst),
+                self.empty_in.load(Ordering::SeqCst),
+                self.empty_out.load(Ordering::SeqCst),
+            )
+        }
+    }
+
+    #[inline]
+    pub fn count_verts(polys: &[ExPolygon]) -> u64 {
+        polys
+            .iter()
+            .map(|e| {
+                e.contour.points.len() as u64
+                    + e.holes.iter().map(|h| h.points.len() as u64).sum::<u64>()
+            })
+            .sum()
+    }
+
+    #[inline]
+    pub fn record_ex<F: FnOnce() -> Vec<ExPolygon>>(
+        site: &SiteStats,
+        a: &[ExPolygon],
+        b: &[ExPolygon],
+        f: F,
+    ) -> Vec<ExPolygon> {
+        if !is_active() {
+            return f();
+        }
+        let in_p = (a.len() + b.len()) as u64;
+        let in_v = count_verts(a) + count_verts(b);
+        let empty_in = a.is_empty() && b.is_empty();
+        let t0 = Instant::now();
+        let out = f();
+        let dt = t0.elapsed().as_nanos() as u64;
+        let out_p = out.len() as u64;
+        let out_v = count_verts(&out);
+        site.record(dt, in_p, in_v, out_p, out_v, empty_in, out.is_empty());
+        out
+    }
+
+    #[inline]
+    pub fn record_single<F: FnOnce() -> Vec<ExPolygon>>(
+        site: &SiteStats,
+        a: &[ExPolygon],
+        f: F,
+    ) -> Vec<ExPolygon> {
+        record_ex(site, a, &[], f)
+    }
