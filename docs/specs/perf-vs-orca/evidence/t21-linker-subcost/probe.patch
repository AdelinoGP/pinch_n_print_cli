index 00000000..b8d64440
--- /dev/null
+++ b/modules/core-modules/infill-linker/src/t21.rs
@@ -0,0 +1,104 @@
+//! [T21-PROBE] Temporary linker subcost attribution (wayfinder ticket 21).
+//!
+//! Removed before any commit; preserved as
+//! `docs/specs/perf-vs-orca/evidence/t21-linker-subcost/probe.patch`.
+//!
+//! Fuel scopes (`t21::*`) resolve only under `--profile`; fuel ratios are exact
+//! (ADR-0055). The counters and the export-call wall bracket (`fn_us`) and the
+//! `orchestrate_infill` bracket (`orch_us`) come from
+//! [`slicer_sdk::host::now_us`] and are flushed as one `module_log` line per
+//! layer.
+
+use std::cell::{Cell, RefCell};
+
+
+/// Opens a fuel scope for `$name`, resolving (and caching) its id per call site.
+macro_rules! t21_scope {
+    ($name:expr) => {{
+        static T21_SCOPE_ID: ::std::sync::OnceLock<Option<slicer_core::profile::ScopeId>> =
+            ::std::sync::OnceLock::new();
+        let t21_id = *T21_SCOPE_ID.get_or_init(|| slicer_sdk::profile::register_scope($name));
+        t21_id.map(slicer_core::profile::scope)
+    }};
+}
+pub(crate) use t21_scope;
+
+/// [T21-PROBE] Per-layer counters.
+#[derive(Default)]
+pub(crate) struct Counters {
+    pub regions: u64,
+    pub matched: u64,
+    pub roles: u64,
+    pub selected: u64,
+    pub locked: u64,
+    pub clip_calls: u64,
+    pub clip_in_pts: u64,
+    pub clip_bnd_pts: u64,
+    pub clip_out: u64,
+    pub fallbacks: u64,
+    pub endpoints: u64,
+    pub cands: u64,
+    pub merges: u64,
+    pub rings: u64,
+    pub bpts: u64,
+    pub unions: u64,
+    pub rgroups: u64,
+    pub owners: u64,
+    pub out: u64,
+}
+
+thread_local! {
+    static COUNTERS: RefCell<Counters> = const { RefCell::new(Counters {
+        regions: 0, matched: 0, roles: 0, selected: 0, locked: 0,
+        clip_calls: 0, clip_in_pts: 0, clip_bnd_pts: 0, clip_out: 0,
+        fallbacks: 0, endpoints: 0, cands: 0, merges: 0,
+        rings: 0, bpts: 0, unions: 0, rgroups: 0, owners: 0, out: 0,
+    }) };
+    static ORCH_US: Cell<u64> = const { Cell::new(0) };
+}
+
+/// [T21-PROBE] Mutates the current layer's counters.
+pub(crate) fn add(f: impl FnOnce(&mut Counters)) {
+    COUNTERS.with(|counters| f(&mut counters.borrow_mut()));
+}
+
+/// [T21-PROBE] Records the `orchestrate_infill` wall span for this call.
+pub fn set_orch_us(us: u64) {
+    ORCH_US.with(|cell| cell.set(us));
+}
+
+/// [T21-PROBE] Flushes and resets counters as one `module_log` line.
+/// `entry_us` is the export-call entry timestamp from
+/// [`slicer_sdk::host::now_us`]; the same per-call host clock backstops both
+/// deltas.
+pub fn flush(layer: u32, entry_us: u64) {
+    let c = COUNTERS.with(|counters| std::mem::take(&mut *counters.borrow_mut()));
+    let orch_us = ORCH_US.with(|cell| cell.replace(0));
+    let fn_us = slicer_sdk::host::now_us().saturating_sub(entry_us);
+    slicer_sdk::host::log_warn(&format!(
+        "T21-PROBE layer={layer} fn_us={fn_us} orch_us={orch_us} \
+         regions={} matched={} roles={} selected={} locked={} \
+         clip_calls={} clip_in_pts={} clip_bnd_pts={} clip_out={} \
+         fallbacks={} endpoints={} cands={} merges={} rings={} bpts={} \
+         unions={} rgroups={} owners={} out={}",
+        c.regions,
+        c.matched,
+        c.roles,
+        c.selected,
+        c.locked,
+        c.clip_calls,
+        c.clip_in_pts,
+        c.clip_bnd_pts,
+        c.clip_out,
+        c.fallbacks,
+        c.endpoints,
+        c.cands,
+        c.merges,
+        c.rings,
+        c.bpts,
+        c.unions,
+        c.rgroups,
+        c.owners,
+        c.out
+    ));
+}
