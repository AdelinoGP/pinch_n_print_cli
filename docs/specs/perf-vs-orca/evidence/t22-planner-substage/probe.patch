+//! [PERF-T22-PROBE] Temporary probe test (wayfinder ticket 22).
+//!
+//! Question: when `clip_polygons(subject, clip, Difference)` is called with a
+//! subject whose bounding box is disjoint from the clip's, what exactly does
+//! the caller get back? A `carve_emitted_regions` bbox gate needs to know
+//! whether skipping the call can be output-preserving.
+//!
+//! Measured answer:
+//!
+//! 1. The result is the subject **as a set** (same area, same outline) — the
+//!    clip contributes nothing.
+//! 2. The result is **not** the subject verbatim: clipper normalizes ring
+//!    order/winding (the test below observes a reversed, rotated contour). Any
+//!    gate must therefore be justified by downstream equivalence, not by
+//!    "returns the input unchanged".
+//!
+//! This file is probe-only: delete it before any commit.
+//!
+//! Run: cargo test -p slicer-core --features host-algos --test t22_probe_diff_identity_tdd
+
+#![cfg(feature = "host-algos")]
+
+use slicer_core::polygon_ops::clip_polygons;
+use slicer_core::polygon_ops::ClipOperation;
+use slicer_ir::{ExPolygon, Point2, Polygon};
+
+fn rect(x0: i64, y0: i64, x1: i64, y1: i64) -> ExPolygon {
+    ExPolygon {
+        contour: Polygon {
+            points: vec![
+                Point2 { x: x0, y: y0 },
+                Point2 { x: x1, y: y0 },
+                Point2 { x: x1, y: y1 },
+                Point2 { x: x0, y: y1 },
+            ],
+        },
+        holes: Vec::new(),
+    }
+}
+
+/// Shoelace area, ignoring sign, in scaled units².
+fn area(poly: &ExPolygon) -> f64 {
+    let pts = &poly.contour.points;
+    let mut twice = 0.0f64;
+    for i in 0..pts.len() {
+        let a = pts[i];
+        let b = pts[(i + 1) % pts.len()];
+        twice += (a.x as f64) * (b.y as f64) - (b.x as f64) * (a.y as f64);
+    }
+    (twice / 2.0).abs()
+}
+
+/// Disjoint boxes: the difference is the subject as a set (area equal), but it
+/// is NOT returned verbatim — clipper rewrites the ring.
+#[test]
+fn disjoint_difference_preserves_the_set_but_not_the_representation() {
+    let subject = vec![rect(0, 0, 1000, 1000)];
+    let clip = vec![rect(10_000, 10_000, 11_000, 11_000)];
+    let out = clip_polygons(&subject, &clip, ClipOperation::Difference);
+    assert_eq!(out.len(), 1, "one surviving region");
+    assert_eq!(
+        area(&out[0]),
+        area(&subject[0]),
+        "disjoint Difference is set-preserving"
+    );
+    assert_ne!(
+        out, subject,
+        "…but clipper normalizes ring order/winding, so it is not verbatim"
+    );
+}
+
+/// Touching bounding boxes are NOT disjoint (shared edge): a bbox gate must
+/// treat them as overlapping.
+#[test]
+fn touching_bboxes_are_not_disjoint() {
+    let subject = vec![rect(0, 0, 1000, 1000)];
+    let clip = vec![rect(1000, 0, 2000, 1000)];
+    let out = clip_polygons(&subject, &clip, ClipOperation::Difference);
+    assert_eq!(out.len(), 1);
+    assert_eq!(area(&out[0]), area(&subject[0]));
+}
