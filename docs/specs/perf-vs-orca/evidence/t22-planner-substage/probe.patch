diff --git a/crates/slicer-wasm-host/src/perf_t22_probe.rs b/crates/slicer-wasm-host/src/perf_t22_probe.rs
new file mode 100644
index 00000000..9f24eb1c
--- /dev/null
+++ b/crates/slicer-wasm-host/src/perf_t22_probe.rs
@@ -0,0 +1,315 @@
+//! [PERF-T22-PROBE] Host-side substage timing for wayfinder ticket 22
+//! ("Tree-planner substage attribution").
+//!
+//! Probe-only, temporary. Every use site is tagged `PERF-T22-PROBE`; removal is
+//! a mechanical pass (delete this file, revert the tagged call sites, grep for
+//! `PERF-T22-PROBE`). Nothing here is meant to be committed.
+//!
+//! What it records, all as process-global atomics so rayon workers can add:
+//!
+//! - **Host geometry services** (`host.rs`): per-service call count and total
+//!   wall spent inside the host function body (IR conversion + clipper + back
+//!   conversion). For the batched forms it also records the summed per-request
+//!   wall, so `total - per-request` exposes fan-out/dispatch overhead.
+//! - **Exact-Z query service** (`exact_z_query.rs`): cache hits, misses, and
+//!   the wall spent inside `cross_section_at_z`.
+//! - **Support-plan aggregation** (`support_aggregation.rs`): overall wall plus
+//!   the `validate_entry`, same-family union, territory-clip, and cross-family
+//!   overlap sub-terms.
+//!
+//! `reset()` / `flush(label)` are driven from `crates/slicer-runtime/src/prepass.rs`
+//! around the `PrePass::SupportGeometry` guest stage, so the totals cover
+//! exactly that stage's host-side work. `flush` writes one greppable stderr
+//! line; the slice's stderr capture keeps it.
+
+#![allow(missing_docs)]
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+/// One host service's accumulated counters.
+#[derive(Debug, Default)]
+pub struct ServiceCounters {
+    pub calls: AtomicU64,
+    pub wall_ns: AtomicU64,
+    /// Summed per-request wall for batched forms; 0 for singular forms.
+    pub inner_wall_ns: AtomicU64,
+    /// Number of requests in batched forms; 0 for singular forms.
+    pub items: AtomicU64,
+    /// Batches that ran on the rayon pool.
+    pub parallel_batches: AtomicU64,
+}
+
+impl ServiceCounters {
+    fn reset(&self) {
+        self.calls.store(0, Ordering::Relaxed);
+        self.wall_ns.store(0, Ordering::Relaxed);
+        self.inner_wall_ns.store(0, Ordering::Relaxed);
+        self.items.store(0, Ordering::Relaxed);
+        self.parallel_batches.store(0, Ordering::Relaxed);
+    }
+}
+
+/// Named host-service counters. Singular and batch forms are kept apart so a
+/// batch adoption's effect is visible.
+pub struct Probe {
+    pub offset_polygons: ServiceCounters,
+    pub offset_polygons_batch: ServiceCounters,
+    pub clip_polygons: ServiceCounters,
+    pub clip_polygons_batch: ServiceCounters,
+    pub simplify_polygon: ServiceCounters,
+    pub simplify_polygon_batch: ServiceCounters,
+    /// Whole `PrePass::SupportGeometry` aggregation call (once per stage).
+    pub aggregation: ServiceCounters,
+    /// Singular clips whose subject bbox was disjoint from the clip bbox.
+    pub clip_bbox_disjoint: AtomicU64,
+    pub clip_bbox_disjoint_ns: AtomicU64,
+    /// Singular clips whose bboxes overlapped (the ones a gate cannot skip).
+    pub clip_bbox_overlap_ns: AtomicU64,
+    pub exact_z_hits: AtomicU64,
+    pub exact_z_misses: AtomicU64,
+    pub exact_z_cross_section_ns: AtomicU64,
+    pub aggregation_validate_ns: AtomicU64,
+    pub aggregation_union_ns: AtomicU64,
+    pub aggregation_territory_ns: AtomicU64,
+    pub aggregation_overlap_ns: AtomicU64,
+    pub prepare_plan_clone_ns: AtomicU64,
+    pub prepass_commit_ns: AtomicU64,
+}
+
+static PROBE: OnceLock<Probe> = OnceLock::new();
+
+/// The process-global probe state.
+pub fn probe() -> &'static Probe {
+    PROBE.get_or_init(|| Probe {
+        offset_polygons: ServiceCounters::default(),
+        offset_polygons_batch: ServiceCounters::default(),
+        clip_polygons: ServiceCounters::default(),
+        clip_polygons_batch: ServiceCounters::default(),
+        simplify_polygon: ServiceCounters::default(),
+        simplify_polygon_batch: ServiceCounters::default(),
+        aggregation: ServiceCounters::default(),
+        clip_bbox_disjoint: AtomicU64::new(0),
+        clip_bbox_disjoint_ns: AtomicU64::new(0),
+        clip_bbox_overlap_ns: AtomicU64::new(0),
+        exact_z_hits: AtomicU64::new(0),
+        exact_z_misses: AtomicU64::new(0),
+        exact_z_cross_section_ns: AtomicU64::new(0),
+        aggregation_validate_ns: AtomicU64::new(0),
+        aggregation_union_ns: AtomicU64::new(0),
+        aggregation_territory_ns: AtomicU64::new(0),
+        aggregation_overlap_ns: AtomicU64::new(0),
+        prepare_plan_clone_ns: AtomicU64::new(0),
+        prepass_commit_ns: AtomicU64::new(0),
+    })
+}
+
+/// Zero every counter. Call before the measured stage.
+pub fn reset() {
+    let p = probe();
+    for c in [
+        &p.offset_polygons,
+        &p.offset_polygons_batch,
+        &p.clip_polygons,
+        &p.clip_polygons_batch,
+        &p.simplify_polygon,
+        &p.simplify_polygon_batch,
+        &p.aggregation,
+    ] {
+        c.reset();
+    }
+    for a in [
+        &p.exact_z_hits,
+        &p.exact_z_misses,
+        &p.exact_z_cross_section_ns,
+        &p.clip_bbox_disjoint,
+        &p.clip_bbox_disjoint_ns,
+        &p.clip_bbox_overlap_ns,
+        &p.aggregation_validate_ns,
+        &p.aggregation_union_ns,
+        &p.aggregation_territory_ns,
+        &p.aggregation_overlap_ns,
+        &p.prepare_plan_clone_ns,
+        &p.prepass_commit_ns,
+    ] {
+        a.store(0, Ordering::Relaxed);
+    }
+}
+
+/// Accumulate one call's wall against `c`.
+pub fn add(c: &ServiceCounters, wall: std::time::Duration) {
+    c.calls.fetch_add(1, Ordering::Relaxed);
+    c.wall_ns
+        .fetch_add(wall.as_nanos() as u64, Ordering::Relaxed);
+}
+
+/// Accumulate one request's wall (batch inner work).
+pub fn add_inner(c: &ServiceCounters, wall: std::time::Duration) {
+    c.items.fetch_add(1, Ordering::Relaxed);
+    c.inner_wall_ns
+        .fetch_add(wall.as_nanos() as u64, Ordering::Relaxed);
+}
+
+/// Record whether a batch took the parallel fan-out.
+pub fn record_batch_mode(c: &ServiceCounters, mode: crate::batch::BatchMode) {
+    if mode == crate::batch::BatchMode::Parallel {
+        c.parallel_batches.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// RAII wall bracket against one counter.
+pub struct Bracket {
+    start: Instant,
+    counter: Option<&'static ServiceCounters>,
+}
+
+impl Bracket {
+    #[must_use]
+    pub fn new(counter: &'static ServiceCounters) -> Self {
+        Self {
+            start: Instant::now(),
+            counter: Some(counter),
+        }
+    }
+
+    /// A bracket that records only into the caller (used for aggregation
+    /// sub-terms, which add their delta by hand).
+    #[must_use]
+    pub fn plain() -> Self {
+        Self {
+            start: Instant::now(),
+            counter: None,
+        }
+    }
+
+    #[must_use]
+    pub fn elapsed(&self) -> std::time::Duration {
+        self.start.elapsed()
+    }
+}
+
+impl Drop for Bracket {
+    fn drop(&mut self) {
+        if let Some(c) = self.counter {
+            add(c, self.start.elapsed());
+        }
+    }
+}
+
+fn ns(v: &AtomicU64) -> u64 {
+    v.load(Ordering::Relaxed)
+}
+
+fn bboxes_disjoint(a: &[slicer_ir::ExPolygon], b: &[slicer_ir::ExPolygon]) -> bool {
+    fn bbox(polys: &[slicer_ir::ExPolygon]) -> Option<(i64, i64, i64, i64)> {
+        let mut out: Option<(i64, i64, i64, i64)> = None;
+        for poly in polys {
+            for point in &poly.contour.points {
+                out = Some(match out {
+                    None => (point.x, point.x, point.y, point.y),
+                    Some((min_x, max_x, min_y, max_y)) => (
+                        min_x.min(point.x),
+                        max_x.max(point.x),
+                        min_y.min(point.y),
+                        max_y.max(point.y),
+                    ),
+                });
+            }
+        }
+        out
+    }
+    match (bbox(a), bbox(b)) {
+        (Some((aminx, amaxx, aminy, amaxy)), Some((bminx, bmaxx, bminy, bmaxy))) => {
+            amaxx < bminx || aminx > bmaxx || amaxy < bminy || aminy > bmaxy
+        }
+        _ => false,
+    }
+}
+
+/// Whether these two polygon sets are provably disjoint by bounding box.
+pub fn bbox_disjoint(subject: &[slicer_ir::ExPolygon], clip: &[slicer_ir::ExPolygon]) -> bool {
+    bboxes_disjoint(subject, clip)
+}
+
+/// Attribute one singular clip's wall to the disjoint or overlapping class.
+///
+/// `wall_before` is the wall counter's value before the call; the delta is
+/// recovered on the caller's thread, which is also where the counter was
+/// incremented.
+pub fn record_clip_class(disjoint: bool, wall_before: u64) {
+    let p = probe();
