+//! The selection index declines a raft-band-only `Layer::Infill` binding
+//! outside the raft band (`selection::raft_band_only_binding`). That decline is
+//! exact only while the binding produces nothing but raft fill, and it is safe
+//! only while another infill binding remains scheduled there. Both halves are
+//! properties of the real module roster, so they are derived from the committed
+//! manifests rather than from a hand-maintained list.
+
+#![allow(missing_docs)]
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+#[derive(Debug)]
+struct InfillBinding {
+    module_id: String,
+    holds: Vec<String>,
+}
+
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../..")
+}
+
+/// Every core-module manifest whose `[stage].id` is `Layer::Infill`.
+fn infill_bindings() -> Vec<InfillBinding> {
+    let modules_dir = workspace_root().join("modules/core-modules");
+    let mut dirs: Vec<PathBuf> = fs::read_dir(&modules_dir)
+        .unwrap_or_else(|error| panic!("cannot read {}: {error}", modules_dir.display()))
+        .map(|entry| {
+            entry
+                .unwrap_or_else(|error| panic!("cannot read module directory entry: {error}"))
+                .path()
+        })
+        .filter(|path| path.is_dir())
+        .collect();
+    dirs.sort();
+
+    let mut bindings = Vec::new();
+    for dir in dirs {
+        let stem = dir
+            .file_name()
+            .and_then(|name| name.to_str())
+            .unwrap_or_else(|| panic!("module directory is not valid UTF-8: {dir:?}"));
+        let manifest = dir.join(format!("{stem}.toml"));
+        let text = fs::read_to_string(&manifest)
+            .unwrap_or_else(|error| panic!("cannot read {}: {error}", manifest.display()));
+        let document: toml::Value = toml::from_str(&text)
+            .unwrap_or_else(|error| panic!("cannot parse {}: {error}", manifest.display()));
+        if document
+            .get("stage")
+            .and_then(|stage| stage.get("id"))
+            .and_then(toml::Value::as_str)
+            != Some("Layer::Infill")
+        {
+            continue;
+        }
+        let module_id = document
+            .get("module")
+            .and_then(|module| module.get("id"))
+            .and_then(toml::Value::as_str)
+            .unwrap_or_else(|| panic!("{} has no [module].id", manifest.display()))
+            .to_string();
+        let holds = document
+            .get("claims")
+            .and_then(|claims| claims.get("holds"))
+            .and_then(toml::Value::as_array)
+            .map(|claims| {
+                claims
+                    .iter()
+                    .map(|claim| {
+                        claim.as_str().unwrap_or_else(|| {
+                            panic!("{} has a non-string claim", manifest.display())
+                        })
+                    })
+                    .map(str::to_string)
+                    .collect()
+            })
+            .unwrap_or_default();
+        bindings.push(InfillBinding { module_id, holds });
+    }
+    bindings
+}
+
+/// Mirrors the selection gate's claim-shape test.
+fn is_raft_band_only(binding: &InfillBinding) -> bool {
+    binding.holds.len() == 1 && binding.holds[0] == "claim:raft-fill"
+}
+
+#[test]
+fn raft_band_only_infill_binding_leaves_stage_coverage() {
+    let infill = infill_bindings();
+    assert!(
+        !infill.is_empty(),
+        "core-module census found no Layer::Infill binding"
+    );
+
+    let raft_band_only: Vec<&InfillBinding> =
+        infill.iter().filter(|b| is_raft_band_only(b)).collect();
+    assert!(
+        raft_band_only
+            .iter()
+            .any(|b| b.module_id == "com.core.raft-default"),
+        "com.core.raft-default is no longer raft-band-only; the selection gate's \
+         exactness premise changed, so re-derive it before keeping the decline. \
+         Declined bindings: {raft_band_only:?}",
+    );
+    assert!(
+        infill.len() > raft_band_only.len(),
+        "every Layer::Infill binding would be declined outside the raft band, \
+         leaving the stage with no producer there",
+    );
+}
