+/// The optional raft-fill role claim (ADR-0009).
+const RAFT_FILL_CLAIM: &str = "claim:raft-fill";
+/// Whether this binding can produce work only inside the raft band.
+///
+/// A binding whose *only* declared claim is `claim:raft-fill` can emit nothing
+/// but `RaftInfill` geometry, and raft-fill geometry exists nowhere but the
+/// physical raft layers: the host already emits the `Raft` target only when
+/// `GlobalLayer.is_raft` is set, and the module body's own guard returns on
+/// every non-raft layer. Declining the whole call there is therefore
+/// output-neutral and skips the per-call view materialisation a no-op call
+/// still pays. Any additional claim keeps the binding scheduled, because it
+/// may then produce that other role outside the band.
+fn raft_band_only_binding(module: &LayerSelectionModuleInput<'_>) -> bool {
+    matches!(module.stage_id, "Layer::Infill" | "Layer::Support")
+        && module.claims.len() == 1
+        && module.claims[0] == RAFT_FILL_CLAIM
+}
