+    region_infill_polys: u64,
+}
+
+fn t75_poly_census(polys: &[ExPolygon]) -> (u64, u64) {
+    (
+        polys.len() as u64,
+        polys
+            .iter()
+            .map(|polygon| {
+                (polygon.contour.points.len()
+                    + polygon
+                        .holes
+                        .iter()
+                        .map(|hole| hole.points.len())
+                        .sum::<usize>()) as u64
+            })
+            .sum(),
+    )
+}
