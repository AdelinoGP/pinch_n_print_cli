+                not_sparse_infill: if density >= 0.999 {
+                    let mut dense = lower.infill_areas.clone();
+                    dense.extend(not_sparse);
+                    dense
+                } else {
+                    not_sparse
+                },
+            })
+        })
+        .collect()
+}
