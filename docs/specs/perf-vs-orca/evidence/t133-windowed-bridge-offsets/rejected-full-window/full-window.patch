+/// Rectangular clip window for the two `deep_infill_area` offsets: the union
+/// bounding box of the layer's internal-bridge candidates, grown by enough to
+/// cover the largest offset delta plus Clipper's miter reach (`miter_limit` is
+/// 2.0 in [`offset`]). Every point whose offset can reach a candidate lies
+/// inside the window, so the offsets computed on the clipped operand agree
+/// with the whole-layer offsets wherever a candidate consumes them.
+///
+/// The window exists because the offsets are local operations: a point farther
+/// than `miter_limit x |delta|` from the candidate bounding box cannot change
+/// the clipped area inside it. `deep_infill_area` on a large plate extends far
+/// beyond the candidate set, and paying to offset that geometry is what the
+/// window removes.
+fn internal_bridge_offset_window(
+    region: &slicer_ir::SlicedRegion,
+    qualify_spacing_mm: f32,
+) -> Option<ExPolygon> {
+    let mut min_x = i64::MAX;
+    let mut min_y = i64::MAX;
+    let mut max_x = i64::MIN;
+    let mut max_y = i64::MIN;
+    let mut any = false;
+    for surface in &region.internal_solid_fill {
+        for ring in std::iter::once(&surface.contour).chain(surface.holes.iter()) {
+            for point in &ring.points {
+                min_x = min_x.min(point.x);
+                min_y = min_y.min(point.y);
+                max_x = max_x.max(point.x);
+                max_y = max_y.max(point.y);
+                any = true;
+            }
+        }
+    }
+    if !any {
+        return None;
+    }
+    // 4.5 * spacing is the largest of the two deltas; miter_limit 2.0 doubles
+    // its reach. One extra spacing keeps the rectangle clear of the offset
+    // boundary so the clipped operand is not itself the clip boundary.
+    let margin_mm = (2.0 * 4.5 + 1.0) * qualify_spacing_mm;
+    let margin = (f64::from(margin_mm) * slicer_ir::UNITS_PER_MM).ceil() as i64;
+    Some(ExPolygon {
+        contour: slicer_ir::Polygon {
+            points: vec![
+                slicer_ir::Point2 {
+                    x: min_x - margin,
+                    y: min_y - margin,
+                },
+                slicer_ir::Point2 {
+                    x: max_x + margin,
+                    y: min_y - margin,
+                },
+                slicer_ir::Point2 {
+                    x: max_x + margin,
+                    y: max_y + margin,
+                },
+                slicer_ir::Point2 {
+                    x: min_x - margin,
+                    y: max_y + margin,
+                },
+            ],
+        },
+        holes: Vec::new(),
+    })
+}
