+/// Batched [`inflate_model_occupancy`], with one result per input in input order.
+///
+/// Empty inputs and non-positive distances retain the singular path's verbatim
+/// no-op. Every other request uses the same offset operation and arguments; only
+/// its execution location and fan-out change.
+fn inflate_model_occupancy_batch<'a>(
+    polygon_sets: impl IntoIterator<Item = &'a [ExPolygon]>,
+    xy_distance_mm: f32,
+) -> Vec<Vec<ExPolygon>> {
+    let polygon_sets: Vec<&[ExPolygon]> = polygon_sets.into_iter().collect();
+    let mut request_slots = vec![None; polygon_sets.len()];
+    let mut requests = Vec::new();
+    for (index, polys) in polygon_sets.iter().enumerate() {
+        if polys.is_empty() || xy_distance_mm <= 0.0 {
+            continue;
+        }
+        request_slots[index] = Some(requests.len());
+        requests.push(OffsetRequest {
+            polygons: polys.to_vec(),
+            delta_mm: xy_distance_mm,
+            join: OffsetJoinType::Miter,
+            arc_tolerance_mm: 0.0,
+            miter_limit: None,
+        });
+    }
+
+    let results = offset_polygons_batch(&requests);
+    assert_eq!(
+        results.len(),
+        requests.len(),
+        "offset batch must return one result per request"
+    );
+    let mut results = results.into_iter();
+    polygon_sets
+        .into_iter()
+        .zip(request_slots)
+        .map(|(polys, slot)| match slot {
+            Some(_) => results.next().expect("validated offset batch result count"),
+            None => polys.to_vec(),
+        })
+        .collect()
+}
