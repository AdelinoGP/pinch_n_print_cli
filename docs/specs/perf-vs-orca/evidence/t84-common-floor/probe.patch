+    *ON.get_or_init(|| std::env::var_os("PNP_T84_PROBE").is_some())
+}
+
+thread_local! {
+    static T84_PUSH_NS: std::cell::Cell<(u64, u64)> = const { std::cell::Cell::new((0, 0)) };
+}
+
+/// Drain and reset the accumulated host-side `push_seam_plan` time/count.
+pub fn t84_take_push_stats() -> (u64, u64) {
+    T84_PUSH_NS.with(|cell| {
+        let stats = cell.get();
+        cell.set((0, 0));
+        stats
+    })
