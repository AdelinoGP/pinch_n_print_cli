+// ---------------------------------------------------------------------------
+// [T60-PROBE] Thread-local owner override for the host:native attribution take
+// ---------------------------------------------------------------------------
+// Temporary probe (wayfinder perf-vs-orca ticket 60). Reverted before any
+// commit; see docs/specs/perf-vs-orca/evidence/t60-host-native/probe.patch.
+
+thread_local! {
+    /// [T60-PROBE] Per-thread owner override, consulted before the global
+    /// `NATIVE_OWNER` at flush time so a probe bracket attributes this
+    /// thread's native marks to the bracketed site. Thread-local because the
+    /// per-layer tier runs on concurrent rayon workers; the global owner is
+    /// only sound for the serial prepass built-ins.
+    static PROBE_NATIVE_OWNER: std::cell::RefCell<Option<&'static str>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// [T60-PROBE] Accumulated live-span totals per probe owner: (name, ns, entries).
+static PROBE_TOTALS: Mutex<Vec<(&'static str, u64, u64)>> = Mutex::new(Vec::new());
+
+/// [T60-PROBE] RAII bracket attributing this thread's native marks to `name`
+/// and accumulating the guard's live span. Probe-only; never committed.
+pub struct ProbeOwnerGuard {
+    name: &'static str,
+    start: Instant,
+    prev: Option<&'static str>,
+}
+
+impl ProbeOwnerGuard {
+    /// [T60-PROBE] Enter a probe attribution bracket for `name`.
+    #[must_use]
+    pub fn new(name: &'static str) -> Self {
+        let start = Instant::now();
+        let prev = PROBE_NATIVE_OWNER.with(|c| c.borrow_mut().replace(name));
+        Self { name, start, prev }
+    }
+}
+
+impl Drop for ProbeOwnerGuard {
+    fn drop(&mut self) {
+        PROBE_NATIVE_OWNER.with(|c| *c.borrow_mut() = self.prev);
+        let ns = self.start.elapsed().as_nanos() as u64;
+        let mut totals = PROBE_TOTALS.lock().expect("t60 probe totals poisoned");
+        if let Some(entry) = totals.iter_mut().find(|(n, _, _)| *n == self.name) {
+            entry.1 += ns;
+            entry.2 += 1;
+        } else {
+            totals.push((self.name, ns, 1));
+        }
+    }
+}
