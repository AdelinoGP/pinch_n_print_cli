+    /// Windowed erosion must preserve every verdict its two consumers can
+    /// observe: `retain` on each qualified polygon, and
+    /// `internal_bridge_angles`' per-candidate filter.
+    ///
+    /// Fixture: one 200 x 200 mm sparse area with an off-window hole plus a
+    /// disconnected island, and two qualified polygons in one corner — one
+    /// inside the sparse area, one wholly outside it (the disjoint-surface
+    /// case). The window covers a small part of the sparse area.
+    #[test]
+    fn windowed_erosion_preserves_every_observable_qualified_neighbourhood_verdict() {
+        let boxed = |x0: f32, x1: f32, y0: f32, y1: f32| ExPolygon {
+            contour: Polygon {
+                points: vec![
+                    Point2::from_mm(x0, y0),
+                    Point2::from_mm(x1, y0),
+                    Point2::from_mm(x1, y1),
+                    Point2::from_mm(x0, y1),
+                ],
+            },
+            holes: Vec::new(),
+        };
+        let mut sparse = boxed(0.0, 200.0, 0.0, 200.0);
+        sparse.holes.push(Polygon {
+            points: vec![
+                Point2::from_mm(150.0, 150.0),
+                Point2::from_mm(190.0, 150.0),
+                Point2::from_mm(190.0, 190.0),
+                Point2::from_mm(150.0, 190.0),
+            ],
+        });
+        let deep = vec![sparse, boxed(210.0, 240.0, 210.0, 240.0)];
+        let qualified = vec![
+            boxed(10.0, 14.0, 10.0, 14.0),
+            boxed(-30.0, -20.0, 50.0, 60.0),
+        ];
+        let spacing_mm = 0.4_f32;
+        let windowed = eroded_area_in_qualified_neighbourhood(&deep, &qualified, spacing_mm);
+        let full = offset(&deep, -(4.5 * spacing_mm), OffsetJoinType::Miter, 0.0);
+        assert!(!full.is_empty(), "fixture must produce a non-empty erosion");
+        assert!(
+            !intersection(std::slice::from_ref(&qualified[0]), &full).is_empty(),
+            "fixture's in-area qualified polygon must observe the erosion"
+        );
+        assert!(
+            intersection(std::slice::from_ref(&qualified[1]), &full).is_empty(),
+            "fixture's disjoint qualified polygon must not observe the erosion"
+        );
+        for (index, polygon) in qualified.iter().enumerate() {
+            assert_eq!(
+                !intersection(std::slice::from_ref(polygon), &windowed).is_empty(),
+                !intersection(std::slice::from_ref(polygon), &full).is_empty(),
+                "retain verdict changed for qualified[{index}]"
+            );
+            let expanded = offset(
+                std::slice::from_ref(polygon),
+                spacing_mm,
+                OffsetJoinType::Miter,
+                0.0,
+            );
+            assert_eq!(
+                !intersection(&expanded, &windowed).is_empty(),
+                !intersection(&expanded, &full).is_empty(),
+                "internal_bridge_angles filter verdict changed for qualified[{index}]"
+            );
+        }
+        let contour_points = |polygons: &[ExPolygon]| -> usize {
+            polygons.iter().map(|p| p.contour.points.len()).sum()
+        };
+        assert!(
+            contour_points(&windowed) < contour_points(&full),
+            "the window must actually shrink the operand ({} vs {} contour points)",
+            contour_points(&windowed),
+            contour_points(&full)
+        );
+    }
