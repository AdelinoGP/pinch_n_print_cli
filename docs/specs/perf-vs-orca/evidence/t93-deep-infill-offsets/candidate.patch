+/// Bounding box of `polygons` in scaled units: `(min_x, min_y, max_x, max_y)`.
+fn expolygon_bbox(polygons: &[ExPolygon]) -> Option<(i64, i64, i64, i64)> {
+    let mut points = polygons
+        .iter()
+        .flat_map(|polygon| std::iter::once(&polygon.contour).chain(polygon.holes.iter()))
+        .flat_map(|ring| ring.points.iter());
+    let first = points.next()?;
+    let (mut min_x, mut min_y, mut max_x, mut max_y) = (first.x, first.y, first.x, first.y);
+    for point in points {
+        min_x = min_x.min(point.x);
+        min_y = min_y.min(point.y);
+        max_x = max_x.max(point.x);
+        max_y = max_y.max(point.y);
+    }
+    Some((min_x, min_y, max_x, max_y))
+}
+
+/// Erode `deep_infill_area` only where the internal-bridge consumers can
+/// observe it.
+///
+/// Both consumers query the erosion inside the pre-retain qualified set: the
+/// `retain` predicate intersects each qualified polygon against it, and
+/// `internal_bridge_angles`' per-candidate filter intersects
+/// `offset(candidate, spacing)` (reach `2 x spacing`) against it. A Clipper2
+/// Miter offset with the default limit 2.0 displaces no vertex farther than
+/// `2 x |delta|`, so the erosion at those points depends only on input
+/// geometry within `9 x spacing` of them. Clipping the operand to the
+/// qualified bbox grown by `14 x spacing` therefore leaves every observable
+/// point unchanged: the cut is farther than the `9 + 2 = 11 x spacing` reach,
+/// and the remaining `3 x spacing` is margin.
+fn eroded_area_in_qualified_neighbourhood(
+    deep_infill_area: &[ExPolygon],
+    qualified: &[ExPolygon],
+    qualify_spacing_mm: f32,
+) -> Vec<ExPolygon> {
+    use slicer_ir::{Point2, Polygon};
+
+    const MARGIN_SPACING: f64 = 14.0;
+    let Some((min_x, min_y, max_x, max_y)) = expolygon_bbox(qualified) else {
+        return Vec::new();
+    };
+    let margin = (MARGIN_SPACING * f64::from(qualify_spacing_mm) * slicer_ir::UNITS_PER_MM) as i64;
+    let window = [ExPolygon {
+        contour: Polygon {
+            points: vec![
+                Point2 {
+                    x: min_x - margin,
+                    y: min_y - margin,
+                },
+                Point2 {
+                    x: max_x + margin,
+                    y: min_y - margin,
+                },
+                Point2 {
+                    x: max_x + margin,
+                    y: max_y + margin,
+                },
+                Point2 {
+                    x: min_x - margin,
+                    y: max_y + margin,
+                },
+            ],
+        },
+        holes: Vec::new(),
+    }];
+    offset(
+        &intersection(deep_infill_area, &window),
+        -(4.5 * qualify_spacing_mm),
+        OffsetJoinType::Miter,
+        0.0,
+    )
+}
