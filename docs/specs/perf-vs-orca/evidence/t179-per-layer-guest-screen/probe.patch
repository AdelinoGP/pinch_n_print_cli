+    pub fn flush(layer_index: u32) {
+        let clip = slicer_core::polygon_ops::t179_clip_probe::take_and_reset();
+        let vals: [u64; C_COUNT] = std::array::from_fn(|i| COUNTERS[i].swap(0, Ordering::Relaxed));
