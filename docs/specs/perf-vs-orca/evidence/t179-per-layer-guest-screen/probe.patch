+
+    static S_EXEC: AtomicU32 = AtomicU32::new(0);
+    static S_ATTR: AtomicU32 = AtomicU32::new(0);
+    static S_REPAIR: AtomicU32 = AtomicU32::new(0);
+    static S_FALLBACK: AtomicU32 = AtomicU32::new(0);
+    static S_SINGLE: AtomicU32 = AtomicU32::new(0);
+
+    static BATCH_CALLS: AtomicU64 = AtomicU64::new(0);
+    static SINGLE_CALLS: AtomicU64 = AtomicU64::new(0);
+    static AMBIG_REPAIRS: AtomicU64 = AtomicU64::new(0);
+    static ERR_FALLBACKS: AtomicU64 = AtomicU64::new(0);
+    static ERR_FALLBACK_SUBJS: AtomicU64 = AtomicU64::new(0);
+    static OUT_SEGS: AtomicU64 = AtomicU64::new(0);
+    static CAND_BBOX_PASS: AtomicU64 = AtomicU64::new(0);
+
+    pub fn set_scopes(
+        exec: Option<ScopeId>,
+        attr: Option<ScopeId>,
+        repair: Option<ScopeId>,
+        fallback: Option<ScopeId>,
+        single: Option<ScopeId>,
+    ) {
+        S_EXEC.store(exec.map_or(0, ScopeId::raw), Ordering::Relaxed);
+        S_ATTR.store(attr.map_or(0, ScopeId::raw), Ordering::Relaxed);
+        S_REPAIR.store(repair.map_or(0, ScopeId::raw), Ordering::Relaxed);
+        S_FALLBACK.store(fallback.map_or(0, ScopeId::raw), Ordering::Relaxed);
+        S_SINGLE.store(single.map_or(0, ScopeId::raw), Ordering::Relaxed);
+    }
+
+    #[inline]
+    pub fn enter(slot: &AtomicU32) -> Option<ScopeGuard> {
+        let raw = slot.load(Ordering::Relaxed);
+        (raw != 0).then(|| profile::scope(ScopeId::new(raw)))
+    }
+    #[inline]
+    pub fn enter_exec() -> Option<ScopeGuard> {
+        enter(&S_EXEC)
+    }
+    #[inline]
+    pub fn enter_attr() -> Option<ScopeGuard> {
+        enter(&S_ATTR)
+    }
+    #[inline]
+    pub fn enter_repair() -> Option<ScopeGuard> {
+        enter(&S_REPAIR)
+    }
+    #[inline]
+    pub fn enter_fallback() -> Option<ScopeGuard> {
+        enter(&S_FALLBACK)
+    }
+    #[inline]
+    pub fn enter_single() -> Option<ScopeGuard> {
+        enter(&S_SINGLE)
+    }
+
+    #[inline]
+    pub fn inc_batch_call() {
+        BATCH_CALLS.fetch_add(1, Ordering::Relaxed);
+    }
+    #[inline]
+    pub fn inc_single_call() {
+        SINGLE_CALLS.fetch_add(1, Ordering::Relaxed);
+    }
+    #[inline]
+    pub fn inc_ambig_repair() {
+        AMBIG_REPAIRS.fetch_add(1, Ordering::Relaxed);
+    }
+    #[inline]
+    pub fn inc_err_fallback(subjs: u64) {
+        ERR_FALLBACKS.fetch_add(1, Ordering::Relaxed);
+        ERR_FALLBACK_SUBJS.fetch_add(subjs, Ordering::Relaxed);
+    }
+    #[inline]
+    pub fn inc_out_seg() {
+        OUT_SEGS.fetch_add(1, Ordering::Relaxed);
+    }
+    #[inline]
+    pub fn inc_cand_bbox_pass() {
+        CAND_BBOX_PASS.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn take_and_reset() -> [u64; 7] {
+        [
+            BATCH_CALLS.swap(0, Ordering::Relaxed),
+            SINGLE_CALLS.swap(0, Ordering::Relaxed),
+            AMBIG_REPAIRS.swap(0, Ordering::Relaxed),
+            ERR_FALLBACKS.swap(0, Ordering::Relaxed),
+            ERR_FALLBACK_SUBJS.swap(0, Ordering::Relaxed),
+            OUT_SEGS.swap(0, Ordering::Relaxed),
+            CAND_BBOX_PASS.swap(0, Ordering::Relaxed),
+        ]
+    }
+}
