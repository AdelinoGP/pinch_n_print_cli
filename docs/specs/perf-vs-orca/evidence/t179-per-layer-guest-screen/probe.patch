+            return;
+        }
+        let mut parts = Vec::with_capacity(C_COUNT + 8);
+        parts.push(format!("T179-IL layer={layer_index}"));
+        for (name, v) in NAMES.iter().zip(vals.iter()) {
+            parts.push(format!("{name}={v}"));
+        }
+        let cnames = [
+            "clip_batch_calls",
+            "clip_single_calls",
+            "clip_ambig_repairs",
+            "clip_err_fallbacks",
+            "clip_err_fallback_subjs",
+            "clip_out_segs",
+            "clip_cand_bbox_pass",
+        ];
+        for (name, v) in cnames.iter().zip(clip.iter()) {
+            parts.push(format!("{name}={v}"));
+        }
+        slicer_sdk::host::log_trace(&parts.join(" "));
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    pub fn flush(_layer_index: u32) {
+        let _ = slicer_core::polygon_ops::t179_clip_probe::take_and_reset();
+        for c in &COUNTERS {
+            c.store(0, Ordering::Relaxed);
+        }
+    }
+}
