 // Internal helpers
 // ============================================================================
 
+// ---------------------------------------------------------------------------
+// t99 probe — split-and-union counterfactuals for the whole-layer clip-area
+// dilation. Attribution only: the production clip area is computed first (or
+// last, under `PNP_T99_ORDER=split`) and the counterfactual never feeds it.
+// ---------------------------------------------------------------------------
+
+fn t99_probe_enabled() -> bool {
+    std::env::var_os("PNP_T99_PROBE").is_some()
+}
+
+fn t99_record(line: String) {
+    use std::io::Write as _;
+    let Some(path) = std::env::var_os("PNP_T99_ROWS") else {
+        return;
+    };
+    static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+    let _guard = LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+    if let Ok(mut file) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+    {
+        let _ = writeln!(file, "{line}");
+    }
+}
+
+/// Offset every operand polygon on its own, then union the pieces — the
+/// ticket's literal split-and-union shape. Returns `(offsets_ms, union_ms,
+/// result)`, so the caller can also read the union-free lower bound.
+fn t99_split_arm(operand: &[ExPolygon], delta_mm: f32) -> (f64, f64, Vec<ExPolygon>) {
+    let t_offsets = std::time::Instant::now();
+    let mut pieces: Vec<ExPolygon> = Vec::with_capacity(operand.len());
+    for polygon in operand {
+        pieces.extend(offset(
+            std::slice::from_ref(polygon),
+            delta_mm,
+            OffsetJoinType::Miter,
+            0.0,
+        ));
+    }
+    let offsets_ms = t_offsets.elapsed().as_secs_f64() * 1e3;
+    let t_union = std::time::Instant::now();
+    let merged = union(&pieces, &[]);
+    let union_ms = t_union.elapsed().as_secs_f64() * 1e3;
+    (offsets_ms, union_ms, merged)
+}
+
+fn t99_vertices(operand: &[ExPolygon]) -> usize {
+    operand
+        .iter()
+        .map(|polygon| {
+            polygon.contour.points.len()
+                + polygon
+                    .holes
+                    .iter()
+                    .map(|hole| hole.points.len())
+                    .sum::<usize>()
+        })
+        .sum()
+}
