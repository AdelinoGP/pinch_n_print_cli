+        static COLLISION_QUERIED: RefCell<HashSet<(i64, usize)>> = RefCell::new(HashSet::new());
+        static AVOIDANCE_QUERIED: RefCell<HashSet<(i64, usize)>> = RefCell::new(HashSet::new());
+        static COLLISION_MAX_LAYER: RefCell<BTreeMap<i64, usize>> = const { RefCell::new(BTreeMap::new()) };
+        static AVOIDANCE_MAX_LAYER: RefCell<BTreeMap<i64, usize>> = const { RefCell::new(BTreeMap::new()) };
+    }
+
+    pub fn init() {
+        let hot = slicer_sdk::profile::register_scope("__t187_hot__").is_some();
+        HOT_FUEL.with(|c| c.set(hot));
+        C_EMIT_ACTIVE_NODES.with(|c| c.set(0));
+        C_EMIT_ANCESTOR_STEPS.with(|c| c.set(0));
+        C_EMIT_SKEL_POINTS.with(|c| c.set(0));
+        C_EMIT_SKEL_ITERS.with(|c| c.set(0));
+        C_EMIT_SWALLOWED.with(|c| c.set(0));
+        C_LINE_CUT_CALLS.with(|c| c.set(0));
+        C_LINE_CUT_HITS.with(|c| c.set(0));
+        C_MOVE_OUT_CALLS.with(|c| c.set(0));
+        C_MOVE_OUT_EARLY.with(|c| c.set(0));
+        C_MOVE_OUT_OFFSETS.with(|c| c.set(0));
+        C_PIP_CALLS.with(|c| c.set(0));
+        C_PROJ_CALLS.with(|c| c.set(0));
+        C_TV_COLL_QUERIES.with(|c| c.set(0));
+        C_TV_AVOID_QUERIES.with(|c| c.set(0));
+        COUNTERS.with(|m| m.borrow_mut().clear());
+        COLLISION_QUERIED.with(|s| s.borrow_mut().clear());
+        AVOIDANCE_QUERIED.with(|s| s.borrow_mut().clear());
+        COLLISION_MAX_LAYER.with(|m| m.borrow_mut().clear());
+        AVOIDANCE_MAX_LAYER.with(|m| m.borrow_mut().clear());
+    }
+
+    #[inline]
+    pub fn hot_fuel() -> bool {
+        HOT_FUEL.with(Cell::get)
+    }
+
+    pub fn site(name: &str) {
+        slicer_sdk::host::log_info(&format!("__T187__:SITE:{name}"));
+    }
+
+    pub struct ScopeGuard {
+        name: &'static str,
+        active: bool,
+    }
+
+    pub fn scope(name: &'static str) -> ScopeGuard {
+        slicer_sdk::host::log_info(&format!("__T187__:ENTER:{name}"));
+        ScopeGuard { name, active: true }
+    }
+
+    #[inline]
+    pub fn hot_scope(name: &'static str) -> ScopeGuard {
+        if hot_fuel() {
+            slicer_sdk::host::log_info(&format!("__T187__:ENTER:{name}"));
+            ScopeGuard { name, active: true }
+        } else {
+            ScopeGuard {
+                name,
+                active: false,
+            }
+        }
+    }
+
+    impl Drop for ScopeGuard {
+        fn drop(&mut self) {
+            if self.active {
+                slicer_sdk::host::log_info(&format!("__T187__:EXIT:{}", self.name));
+            }
+        }
+    }
+
+    #[inline]
+    pub fn add(key: &'static str, delta: u64) {
+        match key {
+            "emit_active_nodes_total" => C_EMIT_ACTIVE_NODES.with(|c| c.set(c.get() + delta)),
+            "emit_ancestor_walk_steps" => C_EMIT_ANCESTOR_STEPS.with(|c| c.set(c.get() + delta)),
+            "emit_skeleton_points" => C_EMIT_SKEL_POINTS.with(|c| c.set(c.get() + delta)),
+            "emit_skeleton_inner_iters" => C_EMIT_SKEL_ITERS.with(|c| c.set(c.get() + delta)),
+            "emit_swallowed_calls" => C_EMIT_SWALLOWED.with(|c| c.set(c.get() + delta)),
+            "line_cut_calls" => C_LINE_CUT_CALLS.with(|c| c.set(c.get() + delta)),
+            "line_cut_cache_hits" => C_LINE_CUT_HITS.with(|c| c.set(c.get() + delta)),
+            "move_out_total_calls" => C_MOVE_OUT_CALLS.with(|c| c.set(c.get() + delta)),
+            "move_out_early_outside" => C_MOVE_OUT_EARLY.with(|c| c.set(c.get() + delta)),
+            "move_out_offset_calls" => C_MOVE_OUT_OFFSETS.with(|c| c.set(c.get() + delta)),
+            "point_in_any_expoly_calls" => C_PIP_CALLS.with(|c| c.set(c.get() + delta)),
+            "projection_onto_calls" => C_PROJ_CALLS.with(|c| c.set(c.get() + delta)),
+            _ => COUNTERS.with(|m| {
+                *m.borrow_mut().entry(key).or_insert(0) += delta;
+            }),
+        }
+    }
+
+    #[inline]
+    pub fn record_collision_query(rkey: i64, layer: usize) {
+        C_TV_COLL_QUERIES.with(|c| c.set(c.get() + 1));
+        COLLISION_QUERIED.with(|s| {
+            s.borrow_mut().insert((rkey, layer));
+        });
+        COLLISION_MAX_LAYER.with(|m| {
+            let mut map = m.borrow_mut();
+            let e = map.entry(rkey).or_insert(0);
+            if layer > *e {
+                *e = layer;
+            }
+        });
+    }
+
