+    d.instantiate_ns += instantiate_ns;
+    d.project_mesh_ns += project_mesh_ns;
+    d.project_layer_plan_ns += project_layer_plan_ns;
+    d.project_region_seg_ns += project_region_seg_ns;
+    d.project_support_geom_ns += project_support_geom_ns;
+    d.project_support_analysis_ns += project_support_analysis_ns;
+    d.call_run_ns += call_run_ns;
+    d.harvest_ns += harvest_ns;
+    d.total_ns += total_ns;
+}
