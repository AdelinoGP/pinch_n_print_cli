+pub fn count_expolys(polys: &[ExPolygon]) -> (u64, u64) {
+    let mut verts = 0u64;
+    for p in polys {
+        verts += p.contour.points.len() as u64;
+        for h in &p.holes {
+            verts += h.points.len() as u64;
+        }
+    }
+    (polys.len() as u64, verts)
+}
+
+pub fn hash_expolys(polys: &[ExPolygon], extra1: u64, extra2: u64) -> u64 {
+    const FNV_OFFSET: u64 = 0xcbf2_9ce4_8422_2325;
+    const FNV_PRIME: u64 = 0x0000_0100_0000_01b3;
+    let mut h = FNV_OFFSET;
+    let mut mix = |w: u64| {
+        h ^= w;
+        h = h.wrapping_mul(FNV_PRIME);
+    };
+    mix(extra1);
+    mix(extra2);
+    mix(polys.len() as u64);
+    for p in polys {
+        mix(p.contour.points.len() as u64);
+        for pt in &p.contour.points {
+            mix(pt.x as u64);
+            mix(pt.y as u64);
+        }
+        mix(p.holes.len() as u64);
+        for hole in &p.holes {
+            mix(hole.points.len() as u64);
+            for pt in &hole.points {
+                mix(pt.x as u64);
+                mix(pt.y as u64);
+            }
+        }
+    }
+    h
+}
+
+fn ring_area_u2(pts: &[slicer_ir::Point2]) -> f64 {
+    if pts.len() < 3 {
+        return 0.0;
+    }
+    let mut sum = 0.0_f64;
+    let mut j = pts.len() - 1;
+    for i in 0..pts.len() {
+        sum += (pts[j].x as f64) * (pts[i].y as f64) - (pts[i].x as f64) * (pts[j].y as f64);
+        j = i;
+    }
+    0.5 * sum
+}
+
+fn expolys_area_u2(polys: &[ExPolygon]) -> f64 {
+    let mut total = 0.0_f64;
+    for p in polys {
+        total += ring_area_u2(&p.contour.points).abs();
+        for h in &p.holes {
+            total -= ring_area_u2(&h.points).abs();
+        }
+    }
+    total
+}
