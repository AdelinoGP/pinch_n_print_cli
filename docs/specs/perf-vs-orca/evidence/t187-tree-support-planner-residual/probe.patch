+pub fn handle_log(message: &str, host_entry_fuel: u64, profiling_enabled: bool) -> bool {
+    let Some(rest) = message.strip_prefix("__T187__:") else {
+        return false;
+    };
+    if !enabled() {
+        return true;
+    }
+    let now = Instant::now();
+    let mut s = state().lock().unwrap();
+    s.profiling_active |= profiling_enabled;
+    s.last_fuel = host_entry_fuel;
+
+    if let Some(name) = rest.strip_prefix("ENTER:") {
+        s.scope_stack.push(ActiveFrame {
+            name: name.to_string(),
+            enter_wall: now,
+            enter_fuel: host_entry_fuel,
+            child_wall_ns: 0,
+            child_fuel: 0,
+        });
+    } else if let Some(name) = rest.strip_prefix("EXIT:") {
+        if let Some(top) = s.scope_stack.last() {
+            if top.name == name {
+                let frame = s.scope_stack.pop().unwrap();
+                let inc_wall = now.saturating_duration_since(frame.enter_wall).as_nanos() as u64;
+                let inc_fuel = host_entry_fuel.saturating_sub(frame.enter_fuel);
+                let exc_wall = inc_wall.saturating_sub(frame.child_wall_ns);
+                let exc_fuel = inc_fuel.saturating_sub(frame.child_fuel);
+                if let Some(parent) = s.scope_stack.last_mut() {
+                    parent.child_wall_ns = parent.child_wall_ns.saturating_add(inc_wall);
+                    parent.child_fuel = parent.child_fuel.saturating_add(inc_fuel);
+                }
+                let agg = s.scopes.entry(frame.name).or_default();
+                agg.calls += 1;
+                agg.inclusive_wall_ns += inc_wall;
+                agg.exclusive_wall_ns += exc_wall;
+                agg.inclusive_fuel += inc_fuel;
+                agg.exclusive_fuel += exc_fuel;
+            }
+        }
+    } else if let Some(site) = rest.strip_prefix("SITE:") {
+        s.active_site = site.to_string();
+    } else if let Some(kv) = rest.strip_prefix("COUNTER:") {
+        if let Some((k, v)) = kv.split_once(':') {
+            if let Ok(val) = v.parse::<u64>() {
+                *s.counters.entry(k.to_string()).or_insert(0) += val;
+            }
+        }
+    } else if rest == "FLUSH" {
+        drop(s);
+        flush_to_disk();
+    }
+    true
+}
