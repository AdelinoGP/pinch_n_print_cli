+        static C_LINE_CUT_CALLS: Cell<u64> = const { Cell::new(0) };
+        static C_LINE_CUT_HITS: Cell<u64> = const { Cell::new(0) };
+        static C_MOVE_OUT_CALLS: Cell<u64> = const { Cell::new(0) };
