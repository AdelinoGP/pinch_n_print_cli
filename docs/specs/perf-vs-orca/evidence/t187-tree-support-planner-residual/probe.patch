+}
+
+pub fn record_batch(kind: &str, batch_wall_ns: u64, rows: &[BatchReqStat]) {
+    if !enabled() {
+        return;
+    }
+    let mut s = state().lock().unwrap();
+    if !s.in_planner {
+        return;
+    }
+    let is_phase5 = s.active_site == "br_phase5_set_diff";
+    let key_name = format!("{}::{}", s.active_site, kind);
+    let mut max_req_worker = 0u64;
+    let mut batch_dups = 0u64;
+    let mut batch_uniques = 0u64;
+    let mut batch_dup_clip = 0u64;
+    let mut batch_dup_worker = 0u64;
+
+    let mut p5_total = 0u64;
+    let mut p5_exact = 0u64;
+    let mut p5_same_area = 0u64;
+    let mut p5_changed = 0u64;
+    let mut p5_max_mm2 = 0.0_f64;
+    let mut p5_sum_mm2 = 0.0_f64;
+    let mut p5_emptied = 0u64;
+
+    for r in rows {
+        max_req_worker = max_req_worker.max(r.worker_ns);
+        let is_dup = if kind.starts_with("offset") {
+            s.seen_offset_keys
+                .insert((key_name.clone(), r.content_key), true)
+                .is_some()
+        } else {
+            s.seen_clip_keys
+                .insert((key_name.clone(), r.content_key), true)
+                .is_some()
+        };
+        if is_dup {
+            batch_dups += 1;
+            batch_dup_clip += r.clipper_ns;
+            batch_dup_worker += r.worker_ns;
+        } else {
+            batch_uniques += 1;
+        }
+        if is_phase5 {
+            if let Some(exact) = r.phase5_exact_eq {
+                p5_total += 1;
+                let diff_mm2 = r.phase5_area_diff_u2 / 1e8_f64;
+                if exact {
+                    p5_exact += 1;
+                } else if r.phase5_area_diff_u2 <= 1.0 {
+                    p5_same_area += 1;
+                } else {
+                    p5_changed += 1;
+                }
+                if r.phase5_emptied {
+                    p5_emptied += 1;
+                }
+                p5_max_mm2 = p5_max_mm2.max(diff_mm2);
+                p5_sum_mm2 += diff_mm2;
+            }
+        }
+    }
+
+    if is_phase5 {
+        s.phase5.total_reqs += p5_total;
+        s.phase5.exact_eq += p5_exact;
+        s.phase5.same_area_within_1u2 += p5_same_area;
+        s.phase5.area_changed += p5_changed;
+        s.phase5.max_area_diff_mm2 = s.phase5.max_area_diff_mm2.max(p5_max_mm2);
+        s.phase5.total_abs_area_diff_mm2 += p5_sum_mm2;
+        s.phase5.emptied_count += p5_emptied;
+    }
+
+    let agg = s.host_ops.entry(key_name).or_default();
+    agg.wit_calls += 1;
+    agg.requests += rows.len() as u64;
+    agg.batch_wall_ns += batch_wall_ns;
+    agg.max_batch_wall_ns = agg.max_batch_wall_ns.max(batch_wall_ns);
+    agg.sum_batch_max_req_ns += max_req_worker;
+    agg.unique_keys += batch_uniques;
+    agg.dup_requests += batch_dups;
+    agg.dup_wall_ns += batch_dup_worker;
+    agg.dup_clipper_ns += batch_dup_clip;
+    for r in rows {
+        agg.worker_total_ns += r.worker_ns;
+        agg.wit_conv_ns += r.wit_conv_ns;
+        agg.clipper_ns += r.clipper_ns;
+        agg.in_polys += r.in_polys;
+        agg.in_verts += r.in_verts;
+        agg.out_polys += r.out_polys;
+        agg.out_verts += r.out_verts;
+        agg.max_req_clipper_ns = agg.max_req_clipper_ns.max(r.clipper_ns);
+    }
+}
+
+pub fn phase5_check(subject: &[ExPolygon], result: &[ExPolygon]) -> (bool, f64, bool) {
+    let exact = subject == result;
+    if exact {
+        return (true, 0.0, false);
+    }
+    let a_sub = expolys_area_u2(subject);
+    let a_res = expolys_area_u2(result);
+    (false, (a_sub - a_res).abs(), !subject.is_empty() && result.is_empty())
+}
+
+pub fn active_site_is_phase5() -> bool {
+    if !enabled() {
+        return false;
+    }
+    state().lock().unwrap().active_site == "br_phase5_set_diff"
+}
+
+pub fn flush_to_disk() {
+    let Some(path) = out_path() else {
+        return;
+    };
+    let s = state().lock().unwrap();
+    let mut out = String::from("{\n");
+    out.push_str(&format!("  \"profiling_active\": {},\n", s.profiling_active));
+    out.push_str(&format!("  \"last_fuel\": {},\n", s.last_fuel));
+
+    out.push_str("  \"dispatch\": {\n");
+    for (idx, (k, d)) in s.dispatch.iter().enumerate() {
+        let comma = if idx + 1 < s.dispatch.len() { "," } else { "" };
+        out.push_str(&format!(
+            "    {:?}: {{\"instantiate_ns\": {}, \"project_mesh_ns\": {}, \"project_layer_plan_ns\": {}, \"project_region_seg_ns\": {}, \"project_support_geom_ns\": {}, \"project_support_analysis_ns\": {}, \"call_run_ns\": {}, \"harvest_ns\": {}, \"total_ns\": {}}}{}\n",
+            k, d.instantiate_ns, d.project_mesh_ns, d.project_layer_plan_ns,
+            d.project_region_seg_ns, d.project_support_geom_ns, d.project_support_analysis_ns,
+            d.call_run_ns, d.harvest_ns, d.total_ns, comma
+        ));
+    }
+    out.push_str("  },\n");
+
+    out.push_str("  \"scopes\": {\n");
+    for (idx, (k, a)) in s.scopes.iter().enumerate() {
+        let comma = if idx + 1 < s.scopes.len() { "," } else { "" };
+        out.push_str(&format!(
+            "    {:?}: {{\"calls\": {}, \"inc_wall_ns\": {}, \"exc_wall_ns\": {}, \"inc_fuel\": {}, \"exc_fuel\": {}}}{}\n",
+            k, a.calls, a.inclusive_wall_ns, a.exclusive_wall_ns, a.inclusive_fuel, a.exclusive_fuel, comma
+        ));
+    }
+    out.push_str("  },\n");
+
+    out.push_str("  \"host_ops\": {\n");
+    for (idx, (k, a)) in s.host_ops.iter().enumerate() {
+        let comma = if idx + 1 < s.host_ops.len() { "," } else { "" };
+        out.push_str(&format!(
+            "    {:?}: {{\"wit_calls\": {}, \"requests\": {}, \"batch_wall_ns\": {}, \"worker_total_ns\": {}, \"wit_conv_ns\": {}, \"clipper_ns\": {}, \"in_polys\": {}, \"in_verts\": {}, \"out_polys\": {}, \"out_verts\": {}, \"max_batch_wall_ns\": {}, \"max_req_clipper_ns\": {}, \"sum_batch_max_req_ns\": {}, \"unique_keys\": {}, \"dup_requests\": {}, \"dup_wall_ns\": {}, \"dup_clipper_ns\": {}, \"singleton_inputs\": {}}}{}\n",
+            k, a.wit_calls, a.requests, a.batch_wall_ns, a.worker_total_ns, a.wit_conv_ns,
+            a.clipper_ns, a.in_polys, a.in_verts, a.out_polys, a.out_verts,
+            a.max_batch_wall_ns, a.max_req_clipper_ns, a.sum_batch_max_req_ns,
+            a.unique_keys, a.dup_requests, a.dup_wall_ns, a.dup_clipper_ns, a.singleton_inputs, comma
+        ));
+    }
+    out.push_str("  },\n");
+
+    out.push_str(&format!(
+        "  \"phase5_audit\": {{\"total_reqs\": {}, \"exact_eq\": {}, \"same_area_within_1u2\": {}, \"area_changed\": {}, \"max_area_diff_mm2\": {:.9}, \"total_abs_area_diff_mm2\": {:.9}, \"emptied_count\": {}}},\n",
+        s.phase5.total_reqs, s.phase5.exact_eq, s.phase5.same_area_within_1u2,
+        s.phase5.area_changed, s.phase5.max_area_diff_mm2, s.phase5.total_abs_area_diff_mm2,
+        s.phase5.emptied_count
+    ));
+
+    out.push_str("  \"counters\": {\n");
+    for (idx, (k, v)) in s.counters.iter().enumerate() {
+        let comma = if idx + 1 < s.counters.len() { "," } else { "" };
+        out.push_str(&format!("    {:?}: {}{}\n", k, v, comma));
+    }
+    out.push_str("  }\n");
+    out.push_str("}\n");
+
+    if let Some(parent) = std::path::Path::new(path).parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    let _ = std::fs::write(path, out);
+}
