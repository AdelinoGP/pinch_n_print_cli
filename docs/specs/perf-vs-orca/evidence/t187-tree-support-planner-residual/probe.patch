+pub fn record_single_clip(
+    op_name: &str,
+    subject: &[ExPolygon],
+    clip: &[ExPolygon],
+    result: &[ExPolygon],
+    total_ns: u64,
+    wit_conv_ns: u64,
+    clipper_ns: u64,
+) {
+    if !enabled() {
+        return;
+    }
+    let (sp, sv) = count_expolys(subject);
+    let (cp, cv) = count_expolys(clip);
+    let (op, ov) = count_expolys(result);
+    let h1 = hash_expolys(subject, 1, 0);
+    let h2 = hash_expolys(clip, 2, h1);
+    let mut s = state().lock().unwrap();
+    if !s.in_planner {
+        return;
+    }
+    let key_name = format!("{}::clip_single({})", s.active_site, op_name);
+    let is_dup = s
+        .seen_clip_keys
+        .insert((key_name.clone(), h2), true)
+        .is_some();
+    let agg = s.host_ops.entry(key_name).or_default();
+    agg.wit_calls += 1;
+    agg.requests += 1;
+    agg.batch_wall_ns += total_ns;
+    agg.worker_total_ns += total_ns;
+    agg.wit_conv_ns += wit_conv_ns;
+    agg.clipper_ns += clipper_ns;
+    agg.in_polys += sp + cp;
+    agg.in_verts += sv + cv;
+    agg.out_polys += op;
+    agg.out_verts += ov;
+    agg.max_batch_wall_ns = agg.max_batch_wall_ns.max(total_ns);
+    agg.max_req_clipper_ns = agg.max_req_clipper_ns.max(clipper_ns);
+    agg.sum_batch_max_req_ns += total_ns;
+    if sp + cp <= 1 {
+        agg.singleton_inputs += 1;
+    }
+    if is_dup {
+        agg.dup_requests += 1;
+        agg.dup_wall_ns += total_ns;
+        agg.dup_clipper_ns += clipper_ns;
+    } else {
+        agg.unique_keys += 1;
+    }
+}
+
+pub fn record_single_offset(
+    polys: &[ExPolygon],
+    result: &[ExPolygon],
+    delta_mm: f32,
+    miter_limit: Option<f32>,
+    total_ns: u64,
+    wit_conv_ns: u64,
+    clipper_ns: u64,
+) {
+    if !enabled() {
+        return;
+    }
+    let (ip, iv) = count_expolys(polys);
+    let (op, ov) = count_expolys(result);
+    let key = hash_expolys(
+        polys,
+        u64::from(delta_mm.to_bits()),
+        u64::from(miter_limit.map_or(u32::MAX, f32::to_bits)),
+    );
+    let mut s = state().lock().unwrap();
+    if !s.in_planner {
+        return;
+    }
+    let key_name = format!("{}::offset_single", s.active_site);
+    let is_dup = s
+        .seen_offset_keys
+        .insert((key_name.clone(), key), true)
+        .is_some();
+    let agg = s.host_ops.entry(key_name).or_default();
+    agg.wit_calls += 1;
+    agg.requests += 1;
+    agg.batch_wall_ns += total_ns;
+    agg.worker_total_ns += total_ns;
+    agg.wit_conv_ns += wit_conv_ns;
+    agg.clipper_ns += clipper_ns;
+    agg.in_polys += ip;
+    agg.in_verts += iv;
+    agg.out_polys += op;
+    agg.out_verts += ov;
+    agg.max_batch_wall_ns = agg.max_batch_wall_ns.max(total_ns);
+    agg.max_req_clipper_ns = agg.max_req_clipper_ns.max(clipper_ns);
+    agg.sum_batch_max_req_ns += total_ns;
+    if is_dup {
+        agg.dup_requests += 1;
+        agg.dup_wall_ns += total_ns;
+        agg.dup_clipper_ns += clipper_ns;
+    } else {
+        agg.unique_keys += 1;
+    }
+}
