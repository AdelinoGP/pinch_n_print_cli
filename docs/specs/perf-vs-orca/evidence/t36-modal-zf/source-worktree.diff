+++ b/crates/slicer-gcode/tests/gcode_modal_zf_tdd.rs
@@ -0,0 +1,216 @@
+//! Modal Z/F token emission tests (wayfinder ticket 36).
+//!
+//! The serializer is expected to state a `Z`/`F` word on a move line only when
+//! its formatted value changes. The printer's modal state carries the previous
+//! value otherwise, so omission is physically equivalent to repetition. These
+//! tests pin the exact emission rules, including the safe-invalidation cases:
+//! opaque (non-comment) `Raw` commands and `ToolChange` can change machine state
+//! the serializer cannot see, so they must force the next move to re-state Z/F;
+//! comment-only raws (`;TYPE:` / `;LAYER_CHANGE` / `;Z:` …) must not.
+
+use slicer_gcode::{DefaultGCodeSerializer, GCodeSerializer};
+use slicer_ir::{ExtrusionRole, GCodeCommand, GCodeIR, RetractMode};
+
+fn serialize(commands: Vec<GCodeCommand>) -> String {
+    let ir = GCodeIR {
+        commands,
+        ..GCodeIR::default()
+    };
+    DefaultGCodeSerializer::new()
+        .serialize_gcode(&ir)
+        .expect("modal serialization must succeed")
+}
+
+fn extrusion(x: f32, z: f32, e: f32, f: f32) -> GCodeCommand {
+    GCodeCommand::Move {
+        x: Some(x),
+        y: Some(1.0),
+        z: Some(z),
+        e: Some(e),
+        f: Some(f),
+        role: ExtrusionRole::OuterWall,
+    }
+}
+
+fn travel(x: f32) -> GCodeCommand {
+    GCodeCommand::Move {
+        x: Some(x),
+        y: Some(1.0),
+        z: None,
+        e: None,
+        f: None,
+        role: ExtrusionRole::Custom("Travel".to_string()),
+    }
+}
+
+fn move_lines(text: &str) -> Vec<&str> {
+    text.lines()
+        .filter(|l| l.starts_with("G0") || l.starts_with("G1"))
+        .collect()
+}
+
+#[test]
+fn repeated_z_and_f_are_stated_only_on_change() {
+    // Same Z and F across the first two moves; the third changes F only; the
+    // fourth changes Z only. Absolute E (0.1, 0.2, 0.3, 0.4) is emitted as
+    // relative deltas (0.10000 each after the first).
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        extrusion(2.0, 0.2, 0.2, 1800.0),
+        extrusion(3.0, 0.2, 0.3, 3600.0),
+        extrusion(4.0, 0.4, 0.4, 3600.0),
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(
+        lines,
+        vec![
+            "G1 X1 Y1 Z0.2 E0.10000 F1800",
+            "G1 X2 Y1 E0.10000",
+            "G1 X3 Y1 E0.10000 F3600",
+            "G1 X4 Y1 Z0.4 E0.10000",
+        ],
+        "expected modal Z/F emission, got:\n{text}"
+    );
+}
+
+#[test]
+fn comment_only_raw_commands_do_not_reset_modal_state() {
+    // The layer-marker triple is Raw but comment-only; it cannot move the
+    // machine, so the next move must still omit unchanged Z/F.
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        GCodeCommand::Raw {
+            text: ";LAYER_CHANGE".to_string(),
+        },
+        GCodeCommand::Raw {
+            text: ";Z:0.200".to_string(),
+        },
+        extrusion(2.0, 0.2, 0.2, 1800.0),
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(lines.len(), 2, "expected two move lines, got:\n{text}");
+    assert!(
+        !lines[1].contains('Z') && !lines[1].contains('F'),
+        "comment-only raws must not reset the modal cache: {lines:?}"
+    );
+}
+
+#[test]
+fn opaque_raw_command_forces_restatement() {
+    // A non-comment Raw command is opaque: it may set feeds or move axes, so
+    // the next move must re-state the values even though they look unchanged.
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        GCodeCommand::Raw {
+            text: "M73 P1 R1".to_string(),
+        },
+        extrusion(2.0, 0.2, 0.2, 1800.0),
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(lines.len(), 2, "expected two move lines, got:\n{text}");
+    assert!(
+        lines[1].contains("Z0.2") && lines[1].contains("F1800"),
+        "opaque raw commands must force Z/F restatement: {lines:?}"
+    );
+}
+
+#[test]
+fn tool_change_forces_restatement() {
+    // A firmware toolchange macro may move axes and set feeds.
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        GCodeCommand::ToolChange {
+            to: 1,
+            from: 0,
+            after_entity_index: 0,
+        },
+        extrusion(2.0, 0.2, 0.2, 1800.0),
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(lines.len(), 2, "expected two move lines, got:\n{text}");
+    assert!(
+        lines[1].contains("Z0.2") && lines[1].contains("F1800"),
+        "tool changes must force Z/F restatement: {lines:?}"
+    );
+}
+
+#[test]
+fn extrusion_mode_command_alone_does_not_reset_modal_state() {
+    // M82/M83 changes E interpretation only; Z/F modal state is unaffected.
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        GCodeCommand::ExtrusionMode { absolute: false },
+        extrusion(2.0, 0.2, 0.2, 1800.0),
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(lines.len(), 2, "expected two move lines, got:\n{text}");
+    assert!(
+        !lines[1].contains('Z') && !lines[1].contains('F'),
+        "extrusion-mode commands must not reset the modal cache: {lines:?}"
+    );
+}
+
+#[test]
+fn retract_and_unretract_state_feed_once_per_change() {
+    // The move establishes F1800. The retract changes feed to 2400 (stated);
+    // the unretract repeats 2400 (omitted).
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        GCodeCommand::Retract {
+            length: 0.8,
+            speed: 2400.0,
+            mode: RetractMode::Gcode,
+        },
+        GCodeCommand::Unretract {
+            length: 0.8,
+            speed: 2400.0,
+            mode: RetractMode::Gcode,
+        },
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(
+        lines.iter().filter(|l| l.contains("F2400")).count(),
+        1,
+        "F2400 must be stated exactly once (retract), got:\n{text}"
+    );
+    assert!(
+        lines.iter().any(|l| l.starts_with("G1 E-0.80000 F2400")),
+        "retract must state the changed feed, got:\n{text}"
+    );
+    assert!(
+        lines.iter().any(|l| l.trim_end() == "G1 E0.80000"),
+        "unretract must omit the unchanged feed, got:\n{text}"
+    );
+}
+
+#[test]
+fn neutral_move_renders_as_bare_no_op_line() {
+    // A move with no operands at all changes nothing. It keeps its line
+    // slot as a bare `G0` no-op so one IR move stays one output line, and the
+    // following real move is unaffected.
+    let text = serialize(vec![
+        extrusion(1.0, 0.2, 0.1, 1800.0),
+        GCodeCommand::Move {
+            x: None,
+            y: None,
+            z: Some(0.2),
+            e: None,
+            f: None,
+            role: ExtrusionRole::Custom("Travel".to_string()),
+        },
+        travel(2.0),
+    ]);
+    let lines = move_lines(&text);
+
+    assert_eq!(
+        lines,
+        vec!["G1 X1 Y1 Z0.2 E0.10000 F1800", "G0", "G0 X2 Y1"],
+        "the neutral Z-only move must render as a bare no-op line, got:\n{text}"
+    );
+}
