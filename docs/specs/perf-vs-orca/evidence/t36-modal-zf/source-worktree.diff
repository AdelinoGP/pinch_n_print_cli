+/// Modal Z/F emission state for [`DefaultGCodeSerializer::serialize_gcode`].
+///
+/// The printer already holds the last-emitted feedrate and Z position in its
+/// modal state, so a repeated `Z`/`F` word carries no information. This cache
+/// tracks the last *emitted formatted* token per axis; a token is written only
+/// when its formatted value differs from the cached one. Comparing formatted
+/// strings (not raw floats) matches what the printer actually receives.
+///
+/// Both caches are invalidated by any non-comment `Raw` command and by
+/// `ToolChange`: those can change coordinate mode, offsets, or machine state
+/// (firmware macros) in ways this serializer cannot see. Comment-only `Raw`
+/// lines (`;TYPE:` / `;LAYER_CHANGE` / `;Z:` etc.) do not touch machine state
+/// and never invalidate the cache. A move whose operands all match the cached
+/// state still occupies its output line, rendered as a bare `G0`/`G1` no-op.
+#[derive(Default)]
+struct ModalZfState {
+    last_z_token: Option<String>,
+    last_f_token: Option<String>,
+}
+
+impl ModalZfState {
+    /// Forget both caches; the next move re-states Z and F.
+    fn invalidate(&mut self) {
+        self.last_z_token = None;
+        self.last_f_token = None;
+    }
+
+    /// Returns `true` when `formatted` differs from the last emitted Z token,
+    /// updating the cache in that case.
+    fn z_changed(&mut self, formatted: &str) -> bool {
+        if self.last_z_token.as_deref() == Some(formatted) {
+            false
+        } else {
+            self.last_z_token = Some(formatted.to_string());
+            true
+        }
+    }
+
+    /// Returns `true` when `formatted` differs from the last emitted F token,
+    /// updating the cache in that case.
+    fn f_changed(&mut self, formatted: &str) -> bool {
+        if self.last_f_token.as_deref() == Some(formatted) {
+            false
+        } else {
+            self.last_f_token = Some(formatted.to_string());
+            true
+        }
+    }
+}
+
