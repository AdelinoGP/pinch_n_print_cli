diff --git a/crates/slicer-core/src/t69_probe.rs b/crates/slicer-core/src/t69_probe.rs
new file mode 100644
index 00000000..c804add9
--- /dev/null
+++ b/crates/slicer-core/src/t69_probe.rs
@@ -0,0 +1,99 @@
+//! T69-DUMP temporary host-only engine-input recorder. Revert after capture.
+use clipper2_rust::Point64;
+use std::{cell::RefCell, fmt::Write as _, path::PathBuf};
+
+struct State {
+    owner: &'static str,
+    layer: u32,
+    service: usize,
+    engine: usize,
+    rows: String,
+    root: PathBuf,
+}
+thread_local! { static CURRENT: RefCell<Option<State>> = const { RefCell::new(None) }; }
+/// Temporary attribution bracket; thread local, synchronous with dispatch.
+pub struct Guard(Option<State>);
+impl Guard {
+    /// Begin an owner/layer bracket only when the dump environment is enabled.
+    pub fn new(owner: &'static str, layer: u32) -> Self {
+        let Some(root) = std::env::var_os("PNP_T69_DUMP") else {
+            return Self(None);
+        };
+        let state = State {
+            owner,
+            layer,
+            service: 0,
+            engine: 0,
+            rows: String::new(),
+            root: root.into(),
+        };
+        Self(CURRENT.with(|c| c.replace(Some(state))))
+    }
+}
+impl Drop for Guard {
+    fn drop(&mut self) {
+        CURRENT.with(|c| {
+            if let Some(s) = c.replace(self.0.take()) {
+                std::fs::write(
+                    s.root.join(format!("{}-{}.calls", s.owner, s.layer)),
+                    s.rows,
+                )
+                .expect("t69 census write");
+            }
+        });
+    }
+}
+/// Note every host service, including offsets which bypass the engine.
+pub fn service(kind: &str, delta: f64) {
+    CURRENT.with(|c| {
+        if let Some(s) = c.borrow_mut().as_mut() {
+            writeln!(s.rows, "service {} {} {}", s.service, kind, delta.to_bits()).unwrap();
+            s.service += 1;
+        }
+    });
+}
+/// Serialize the exact flat engine paths, each framed as one path/one ring.
+pub fn record(opcode: u8, args: &[(u8, u64)], subj: &[Vec<Point64>], clip: &[Vec<Point64>]) {
+    CURRENT.with(|c| {
+        let mut current = c.borrow_mut();
+        let Some(s) = current.as_mut() else { return };
+        let seq = if s.owner == "CP" {
+            s.service.checked_sub(1).expect("t69 service bracket")
+        } else {
+            s.engine
+        };
+        let filename = format!("{}-{}-{}-{}.case", s.owner, s.layer, seq, s.engine);
+        let sampled = s.layer % 20 == 0 || s.layer == 239 || s.layer == 494 || s.layer == 270;
+        let vertices: usize = subj.iter().chain(clip).map(Vec::len).sum();
+        writeln!(
+            s.rows,
+            "engine {seq} {} {opcode} {vertices} {}",
+            s.engine,
+            if sampled { &filename } else { "-" }
+        )
+        .unwrap();
+        s.engine += 1;
+        if !sampled {
+            return;
+        }
+        let mut text = format!("case {} {} {opcode} {seq}\n", s.owner, s.layer);
+        for &(id, value) in args {
+            writeln!(text, "arg {id} {value}").unwrap();
+        }
+        for (name, paths) in [("subj", subj), ("clip", clip)] {
+            if name == "clip" && opcode == 0 {
+                continue;
+            }
+            writeln!(text, "{name} {}", paths.len()).unwrap();
+            for path in paths {
+                write!(text, "1 {}", path.len()).unwrap();
+                for p in path {
+                    write!(text, " {} {}", p.x, p.y).unwrap();
+                }
+                text.push('\n');
+            }
+        }
+        text.push_str("end\n");
+        std::fs::write(s.root.join(filename), text).expect("t69 geometry write");
+    });
+}
