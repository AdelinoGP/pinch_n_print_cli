+// ---------------------------------------------------------------------------
+// [PERF-T134-PROBE] Temporary sub-phase wall brackets for wayfinder ticket 134
+// (planner effective parallelism). Probe-only: removed before close; grep
+// `PERF-T134-PROBE` for every site.
+// ---------------------------------------------------------------------------
+thread_local! {
+    static T134_SPANS: std::cell::RefCell<Vec<(&'static str, u64, u64)>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+struct T134Span {
+    name: &'static str,
+    start_us: u64,
+    open: bool,
+}
+
+impl T134Span {
+    fn new(name: &'static str) -> Self {
+        // The host recognises this prefix and prints its live clipper
+        // counters synchronously, so the phase's thread-time can be recovered
+        // from the stderr stream.
+        host::log_warn(&format!("T134SNAP:S:{name}"));
+        Self {
+            name,
+            start_us: host::now_us(),
+            open: true,
+        }
+    }
+
+    fn finish(&mut self) {
+        if !self.open {
+            return;
+        }
+        let dt = host::now_us().saturating_sub(self.start_us);
+        host::log_warn(&format!("T134SNAP:E:{}", self.name));
+        T134_SPANS.with(|spans| {
+            let mut spans = spans.borrow_mut();
+            match spans.iter_mut().find(|(name, _, _)| *name == self.name) {
+                Some(entry) => {
+                    entry.1 += dt;
+                    entry.2 += 1;
+                }
+                None => spans.push((self.name, dt, 1)),
+            }
+        });
+        self.open = false;
+    }
+}
+
+impl Drop for T134Span {
+    fn drop(&mut self) {
+        self.finish();
+    }
+}
+
+struct T134GuestGuard;
+
+impl Drop for T134GuestGuard {
+    fn drop(&mut self) {
+        T134_SPANS.with(|spans| {
+            let spans = std::mem::take(&mut *spans.borrow_mut());
+            if spans.is_empty() {
+                return;
+            }
+            let mut line = String::from("t134-guest");
+            for (name, us, calls) in &spans {
+                line.push_str(&format!(" {name}={us}us/{calls}"));
+            }
+            host::log_warn(&line);
+        });
+    }
+}
