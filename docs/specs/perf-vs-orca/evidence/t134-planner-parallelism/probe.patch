diff --git a/crates/slicer-core/src/t134_probe.rs b/crates/slicer-core/src/t134_probe.rs
new file mode 100644
index 00000000..610959ae
--- /dev/null
+++ b/crates/slicer-core/src/t134_probe.rs
@@ -0,0 +1,230 @@
+//! TEMPORARY probe for wayfinder ticket 134 — planner effective parallelism.
+//!
+//! Reverted before the take closes (`probe.patch` in the ticket's evidence
+//! directory is the only artifact). Compiled into the host binary only; the
+//! wasm guest build sees an empty module via the `cfg` below.
+//!
+//! Enabled at runtime by `PNP_T134_PROBE=1`. When disabled every entry point
+//! is one relaxed atomic load plus a branch.
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+
+/// Clipper2 boolean primitive.
+pub const OP_CLIP: usize = 0;
+/// Single-pass clipper2 inflate (`offset`, and both passes of `opening` /
+/// `closing_ex`).
+pub const OP_OFFSET: usize = 1;
+/// `offset2_ex`'s first (flat) pass.
+pub const OP_OFFSET2_P1: usize = 2;
+/// `offset2_ex`'s second (tree-capturing) pass.
+pub const OP_OFFSET2_P2: usize = 3;
+
+/// Op names in [`OP_NAMES`] order.
+pub const OP_NAMES: [&str; 4] = ["clip", "offset", "offset2_p1", "offset2_p2"];
+/// Number of op kinds.
+pub const N_OPS: usize = 4;
+
+/// Field indices in a snapshot row.
+pub const F_CALLS: usize = 0;
+/// Clipper2 `execute` / `execute_tree` / `inflate_paths_64` duration.
+pub const F_SWEEP: usize = 1;
+/// Input points fed to the primitive.
+pub const F_IN_POINTS: usize = 2;
+/// Input paths fed to the primitive.
+pub const F_IN_PATHS: usize = 3;
+/// Largest single-call sweep duration seen.
+pub const F_MAX_SWEEP: usize = 4;
+/// Largest single-call input point count seen.
+pub const F_MAX_IN_POINTS: usize = 5;
+const N_FIELDS: usize = 6;
+
+static DATA: [[AtomicU64; N_FIELDS]; N_OPS] = [
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+];
+
+static BATCH_SERIAL_CALLS: AtomicU64 = AtomicU64::new(0);
+static BATCH_PARALLEL_CALLS: AtomicU64 = AtomicU64::new(0);
+static BATCH_SERIAL_REQUESTS: AtomicU64 = AtomicU64::new(0);
+static BATCH_PARALLEL_REQUESTS: AtomicU64 = AtomicU64::new(0);
+static SEQ: AtomicU64 = AtomicU64::new(0);
+static ON: OnceLock<bool> = OnceLock::new();
+
+/// Whether the probe is enabled (`PNP_T134_PROBE`).
+pub fn enabled() -> bool {
+    *ON.get_or_init(|| std::env::var_os("PNP_T134_PROBE").is_some())
+}
+
+/// Add `value` to one field of one op kind.
+pub fn add(op: usize, field: usize, value: u64) {
+    if value != 0 {
+        DATA[op][field].fetch_add(value, Relaxed);
+    }
+}
+
+/// Record one completed op. Durations are nanoseconds.
+pub fn record(op: usize, sweep_ns: u64, in_points: u64, in_paths: u64) {
+    if !enabled() {
+        return;
+    }
+    add(op, F_CALLS, 1);
+    add(op, F_SWEEP, sweep_ns);
+    add(op, F_IN_POINTS, in_points);
+    add(op, F_IN_PATHS, in_paths);
+    if sweep_ns > DATA[op][F_MAX_SWEEP].load(Relaxed) {
+        DATA[op][F_MAX_SWEEP].store(sweep_ns, Relaxed);
+    }
+    if in_points > DATA[op][F_MAX_IN_POINTS].load(Relaxed) {
+        DATA[op][F_MAX_IN_POINTS].store(in_points, Relaxed);
+    }
+}
+
+/// Record one `map_batch` decision.
+pub fn record_batch(parallel: bool, requests: usize) {
+    if !enabled() {
+        return;
+    }
+    let requests = requests as u64;
+    if parallel {
+        BATCH_PARALLEL_CALLS.fetch_add(1, Relaxed);
+        BATCH_PARALLEL_REQUESTS.fetch_add(requests, Relaxed);
+    } else {
+        BATCH_SERIAL_CALLS.fetch_add(1, Relaxed);
+        BATCH_SERIAL_REQUESTS.fetch_add(requests, Relaxed);
+    }
+}
+
+/// A consistent-ish snapshot of every counter.
+#[derive(Clone, Copy)]
+pub struct Snap {
+    ops: [[u64; N_FIELDS]; N_OPS],
+    batch_serial_calls: u64,
+    batch_parallel_calls: u64,
+    batch_serial_requests: u64,
+    batch_parallel_requests: u64,
+}
+
+/// Take a snapshot.
+pub fn snapshot() -> Snap {
+    let mut ops = [[0u64; N_FIELDS]; N_OPS];
+    for op in 0..N_OPS {
+        for field in 0..N_FIELDS {
+            ops[op][field] = DATA[op][field].load(Relaxed);
+        }
+    }
+    Snap {
+        ops,
+        batch_serial_calls: BATCH_SERIAL_CALLS.load(Relaxed),
+        batch_parallel_calls: BATCH_PARALLEL_CALLS.load(Relaxed),
+        batch_serial_requests: BATCH_SERIAL_REQUESTS.load(Relaxed),
+        batch_parallel_requests: BATCH_PARALLEL_REQUESTS.load(Relaxed),
+    }
+}
+
+fn print_counters(seq: u64, tag: &str, s: Snap) {
+    let mut line = format!("t134-snap seq={seq} tag={tag}");
+    for op in 0..N_OPS {
+        line.push_str(&format!(
+            " {}_calls={} {}_sweep_ns={} {}_in_points={} {}_in_paths={} {}_max_sweep_ns={} {}_max_in_points={}",
+            OP_NAMES[op],
+            s.ops[op][F_CALLS],
+            OP_NAMES[op],
+            s.ops[op][F_SWEEP],
+            OP_NAMES[op],
+            s.ops[op][F_IN_POINTS],
+            OP_NAMES[op],
+            s.ops[op][F_IN_PATHS],
+            OP_NAMES[op],
+            s.ops[op][F_MAX_SWEEP],
+            OP_NAMES[op],
+            s.ops[op][F_MAX_IN_POINTS],
+        ));
+    }
+    line.push_str(&format!(
+        " batch_serial_calls={} batch_parallel_calls={} batch_serial_requests={} batch_parallel_requests={}",
+        s.batch_serial_calls,
+        s.batch_parallel_calls,
+        s.batch_serial_requests,
+        s.batch_parallel_requests,
+    ));
+    eprintln!("{line}");
+}
+
+/// Print an absolute snapshot, tagged with `tag`.
+///
+/// Guest probes call this through the `log` import with a `T134SNAP:` message
+/// prefix; the host's `log` implementation recognises the prefix and calls
+/// here synchronously, so the line lands in call order.
+pub fn emit_snapshot(tag: &str) {
+    if !enabled() {
+        return;
+    }
+    let seq = SEQ.fetch_add(1, Relaxed);
+    print_counters(seq, tag, snapshot());
+}
+
+/// Print the per-op delta between two snapshots, tagged with `tag`.
+pub fn emit_delta(tag: &str, before: Snap, after: Snap) {
+    if !enabled() {
+        return;
+    }
+    let mut d = Snap {
+        ops: [[0u64; N_FIELDS]; N_OPS],
+        batch_serial_calls: after
+            .batch_serial_calls
+            .saturating_sub(before.batch_serial_calls),
+        batch_parallel_calls: after
+            .batch_parallel_calls
+            .saturating_sub(before.batch_parallel_calls),
+        batch_serial_requests: after
+            .batch_serial_requests
+            .saturating_sub(before.batch_serial_requests),
+        batch_parallel_requests: after
+            .batch_parallel_requests
+            .saturating_sub(before.batch_parallel_requests),
+    };
+    for op in 0..N_OPS {
+        for field in 0..N_FIELDS {
+            d.ops[op][field] = if field == F_MAX_SWEEP || field == F_MAX_IN_POINTS {
+                after.ops[op][field]
+            } else {
+                after.ops[op][field].saturating_sub(before.ops[op][field])
+            };
+        }
+    }
+    let seq = SEQ.fetch_add(1, Relaxed);
+    print_counters(seq, tag, d);
+}
