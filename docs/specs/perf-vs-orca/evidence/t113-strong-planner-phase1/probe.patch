+// ---------------------------------------------------------------------------
+// [PERF-T113-PROBE] Temporary substage wall brackets for wayfinder ticket 113
+// (Strong support planner Phase 1). `host::now_us` is the host clock for this
+// module call; the planner is a single serial dispatch. Probe-only: removed
+// before close; grep `PERF-T113-PROBE` for every site.
+// ---------------------------------------------------------------------------
+thread_local! {
+    static T113_SPANS: std::cell::RefCell<Vec<(&'static str, u64, u64)>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+struct T113Span {
+    name: &'static str,
+    start: u64,
+    done: bool,
+}
+
+impl T113Span {
+    fn new(name: &'static str) -> Self {
+        Self {
+            name,
+            start: host::now_us(),
+            done: false,
+        }
+    }
+
+    fn record(&self) {
+        let dt = host::now_us().saturating_sub(self.start);
+        T113_SPANS.with(|spans| {
+            let mut spans = spans.borrow_mut();
+            match spans.iter_mut().find(|(name, _, _)| *name == self.name) {
+                Some(entry) => {
+                    entry.1 += dt;
+                    entry.2 += 1;
+                }
+                None => spans.push((self.name, dt, 1)),
+            }
+        });
+    }
+
+    fn finish(mut self) {
+        self.record();
+        self.done = true;
+    }
+}
+
+impl Drop for T113Span {
+    fn drop(&mut self) {
+        if !self.done {
+            self.record();
+        }
+    }
+}
+
+struct T113CallGuard;
+
+impl Drop for T113CallGuard {
+    fn drop(&mut self) {
+        let spans = T113_SPANS.with(|spans| std::mem::take(&mut *spans.borrow_mut()));
+        if spans.is_empty() {
+            return;
+        }
+        let mut line = String::from("t113-planner-split");
+        for (name, us, calls) in &spans {
+            line.push_str(&format!(" {name}={us}us/{calls}"));
+        }
+        host::log_warn(&line);
+    }
+}
