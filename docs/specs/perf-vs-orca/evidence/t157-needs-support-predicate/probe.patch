+#[derive(Debug, Clone, Copy, Default)]
+struct T157FastPredicateStats {
+    a_polys: usize,
+    a_verts: usize,
+    b_polys: usize,
+    b_verts: usize,
+    branch: &'static str,
+    pip_tests: usize,
+}
+
+fn t157_poly_bbox(pts: &[slicer_ir::Point2]) -> Option<(i64, i64, i64, i64)> {
+    let first = pts.first()?;
+    let mut min_x = first.x;
+    let mut max_x = first.x;
+    let mut min_y = first.y;
+    let mut max_y = first.y;
+    for p in &pts[1..] {
+        if p.x < min_x {
+            min_x = p.x;
+        }
+        if p.x > max_x {
+            max_x = p.x;
+        }
+        if p.y < min_y {
+            min_y = p.y;
+        }
+        if p.y > max_y {
+            max_y = p.y;
+        }
+    }
+    Some((min_x, min_y, max_x, max_y))
+}
+
+fn t157_bboxes_strictly_overlap(
+    a: (i64, i64, i64, i64),
+    b: (i64, i64, i64, i64),
+) -> bool {
+    a.0 < b.2 && b.0 < a.2 && a.1 < b.3 && b.1 < a.3
+}
+
+/// Returns:
+/// - `1` if `pt` is strictly inside `ring`
+/// - `0` if `pt` is on an edge or vertex of `ring`
+/// - `-1` if `pt` is strictly outside `ring`
+fn t157_point_in_ring(pt: slicer_ir::Point2, ring: &[slicer_ir::Point2]) -> i8 {
+    let n = ring.len();
+    if n < 3 {
+        return -1;
+    }
+    let mut inside = false;
+    let mut j = n - 1;
+    for i in 0..n {
+        let pi = ring[i];
+        let pj = ring[j];
+        if pi.x == pt.x && pi.y == pt.y {
+            return 0;
+        }
+        let min_x = pi.x.min(pj.x);
+        let max_x = pi.x.max(pj.x);
+        let min_y = pi.y.min(pj.y);
+        let max_y = pi.y.max(pj.y);
+        if pt.x >= min_x && pt.x <= max_x && pt.y >= min_y && pt.y <= max_y {
+            let cross = (pj.x as i128 - pi.x as i128) * (pt.y as i128 - pi.y as i128)
+                - (pj.y as i128 - pi.y as i128) * (pt.x as i128 - pi.x as i128);
+            if cross == 0 {
+                return 0;
+            }
+        }
+        if (pi.y > pt.y) != (pj.y > pt.y) {
+            let dy = pj.y as i128 - pi.y as i128;
+            let lhs = (pt.x as i128 - pi.x as i128) * dy;
+            let rhs = (pj.x as i128 - pi.x as i128) * (pt.y as i128 - pi.y as i128);
+            let crosses_right = if dy > 0 { lhs < rhs } else { lhs > rhs };
+            if crosses_right {
+                inside = !inside;
+            }
+        }
+        j = i;
+    }
+    if inside { 1 } else { -1 }
+}
+
+fn t157_point_strictly_inside_expoly(
+    pt: slicer_ir::Point2,
+    expoly: &ExPolygon,
+    bbox: (i64, i64, i64, i64),
+) -> bool {
+    if pt.x <= bbox.0 || pt.x >= bbox.2 || pt.y <= bbox.1 || pt.y >= bbox.3 {
+        return false;
+    }
+    if t157_point_in_ring(pt, &expoly.contour.points) <= 0 {
+        return false;
+    }
+    for hole in &expoly.holes {
+        if t157_point_in_ring(pt, &hole.points) >= 0 {
+            return false;
+        }
+    }
+    true
+}
+
+fn t157_expolygons_intersect_fast_with_stats(
+    a: &[ExPolygon],
+    b: &[ExPolygon],
+) -> (bool, T157FastPredicateStats) {
+    let a_verts: usize = a
+        .iter()
+        .map(|ep| {
+            ep.contour.points.len()
+                + ep.holes.iter().map(|h| h.points.len()).sum::<usize>()
+        })
+        .sum();
+    let b_verts: usize = b
+        .iter()
+        .map(|ep| {
+            ep.contour.points.len()
+                + ep.holes.iter().map(|h| h.points.len()).sum::<usize>()
+        })
+        .sum();
+    let mut stats = T157FastPredicateStats {
+        a_polys: a.len(),
+        a_verts,
+        b_polys: b.len(),
+        b_verts,
+        branch: "empty",
+        pip_tests: 0,
+    };
+    if a.is_empty() || b.is_empty() {
+        return (false, stats);
+    }
+
+    let a_bboxes: Vec<Option<(i64, i64, i64, i64)>> = a
+        .iter()
+        .map(|ep| t157_poly_bbox(&ep.contour.points))
+        .collect();
+    let Some(a_union) = a_bboxes.iter().flatten().copied().reduce(|u, bb| {
+        (u.0.min(bb.0), u.1.min(bb.1), u.2.max(bb.2), u.3.max(bb.3))
+    }) else {
+        return (false, stats);
+    };
+
+    let mut b_candidates: Vec<(usize, (i64, i64, i64, i64))> = Vec::new();
+    for (bi, ep_b) in b.iter().enumerate() {
+        if let Some(bb_b) = t157_poly_bbox(&ep_b.contour.points) {
+            if t157_bboxes_strictly_overlap(a_union, bb_b) {
+                b_candidates.push((bi, bb_b));
+            }
+        }
+    }
+    if b_candidates.is_empty() {
+        stats.branch = "bbox_disjoint";
+        return (false, stats);
+    }
+
+    let mut overlapping_pairs: Vec<(
+        usize,
+        (i64, i64, i64, i64),
+        usize,
+        (i64, i64, i64, i64),
+    )> = Vec::new();
+    for (ai, bb_a_opt) in a_bboxes.iter().enumerate() {
+        let Some(bb_a) = *bb_a_opt else {
+            continue;
+        };
+        for &(bi, bb_b) in &b_candidates {
+            if t157_bboxes_strictly_overlap(bb_a, bb_b) {
+                overlapping_pairs.push((ai, bb_a, bi, bb_b));
+            }
+        }
+    }
+    if overlapping_pairs.is_empty() {
+        stats.branch = "pair_bbox_disjoint";
+        return (false, stats);
+    }
+
+    // Fast witness pass 1: check candidate vertices of B strictly inside A.
+    for &(ai, bb_a, bi, _bb_b) in &overlapping_pairs {
+        let ep_a = &a[ai];
+        let ep_b = &b[bi];
+        let pts = &ep_b.contour.points;
+        if !pts.is_empty() {
+            let step = (pts.len() / 8).max(1);
+            for idx in (0..pts.len()).step_by(step) {
+                stats.pip_tests += 1;
+                if t157_point_strictly_inside_expoly(pts[idx], ep_a, bb_a) {
+                    stats.branch = "b_vertex_in_a_sampled";
+                    return (true, stats);
+                }
+            }
+        }
+    }
+
+    // Fast witness pass 2: check sampled vertices of A strictly inside B.
+    for &(ai, _bb_a, bi, bb_b) in &overlapping_pairs {
+        let ep_a = &a[ai];
+        let ep_b = &b[bi];
+        let pts = &ep_a.contour.points;
+        if !pts.is_empty() {
+            let step = (pts.len() / 8).max(1);
+            for idx in (0..pts.len()).step_by(step) {
+                stats.pip_tests += 1;
+                if t157_point_strictly_inside_expoly(pts[idx], ep_b, bb_b) {
+                    stats.branch = "a_vertex_in_b_sampled";
+                    return (true, stats);
+                }
+            }
+        }
+    }
+
+    // Fast witness pass 3: full scan of remaining vertices of B in A, then A in B.
+    for &(ai, bb_a, bi, _bb_b) in &overlapping_pairs {
+        let ep_a = &a[ai];
+        let ep_b = &b[bi];
+        for &pt in &ep_b.contour.points {
+            stats.pip_tests += 1;
+            if t157_point_strictly_inside_expoly(pt, ep_a, bb_a) {
+                stats.branch = "b_vertex_in_a_full";
+                return (true, stats);
+            }
+        }
+    }
+    for &(ai, _bb_a, bi, bb_b) in &overlapping_pairs {
+        let ep_a = &a[ai];
+        let ep_b = &b[bi];
+        for &pt in &ep_a.contour.points {
+            stats.pip_tests += 1;
+            if t157_point_strictly_inside_expoly(pt, ep_b, bb_b) {
+                stats.branch = "a_vertex_in_b_full";
+                return (true, stats);
+            }
+        }
+    }
+
+    // Fallback: Clipper2 boolean intersection on the overlapping subset only.
+    stats.branch = "clipper_fallback";
+    let mut a_sub: Vec<ExPolygon> = Vec::new();
+    let mut b_sub: Vec<ExPolygon> = Vec::new();
+    let mut a_seen = vec![false; a.len()];
+    let mut b_seen = vec![false; b.len()];
+    for &(ai, _bb_a, bi, _bb_b) in &overlapping_pairs {
+        if !a_seen[ai] {
+            a_seen[ai] = true;
+            a_sub.push(a[ai].clone());
+        }
+        if !b_seen[bi] {
+            b_seen[bi] = true;
+            b_sub.push(b[bi].clone());
+        }
+    }
+    let val = !slicer_core::polygon_ops::intersection_ex(&a_sub, &b_sub).is_empty();
+    (val, stats)
+}
+
+std::thread_local! {
+    static T157_CALLER_TAG: std::cell::Cell<&'static str> = const { std::cell::Cell::new("unknown") };
+}
+
+/// Set the thread-local caller tag for t157 probe attribution.
+#[doc(hidden)]
+pub fn t157_set_caller_tag(tag: &'static str) -> &'static str {
+    T157_CALLER_TAG.with(|c| c.replace(tag))
+}
+
+fn t157_get_caller_tag() -> &'static str {
+    T157_CALLER_TAG.with(|c| c.get())
+}
+
+fn t157_emit_ns_fast(fast_us: u128, fast_val: bool, stats: &T157FastPredicateStats) {
+    let caller = t157_get_caller_tag();
+    eprintln!(
+        "{{\"t157_probe\":\"ns_fast\",\"caller\":\"{}\",\"fast_us\":{},\"val\":{},\"branch\":\"{}\",\"a_polys\":{},\"a_verts\":{},\"b_polys\":{},\"b_verts\":{},\"pip_tests\":{}}}",
+        caller,
+        fast_us,
+        fast_val,
+        stats.branch,
+        stats.a_polys,
+        stats.a_verts,
+        stats.b_polys,
+        stats.b_verts,
+        stats.pip_tests
+    );
+}
+
+fn t157_emit_ns_dual(
+    fast_us: u128,
+    full_us: u128,
+    fast_val: bool,
+    full_val: bool,
+    stats: &T157FastPredicateStats,
+) {
+    let caller = t157_get_caller_tag();
+    eprintln!(
+        "{{\"t157_probe\":\"ns_dual\",\"caller\":\"{}\",\"fast_us\":{},\"full_us\":{},\"fast_val\":{},\"full_val\":{},\"match\":{},\"branch\":\"{}\",\"a_polys\":{},\"a_verts\":{},\"b_polys\":{},\"b_verts\":{},\"pip_tests\":{}}}",
+        caller,
+        fast_us,
+        full_us,
+        fast_val,
+        full_val,
+        fast_val == full_val,
+        stats.branch,
+        stats.a_polys,
+        stats.a_verts,
+        stats.b_polys,
+        stats.b_verts,
+        stats.pip_tests
+    );
+}
+
