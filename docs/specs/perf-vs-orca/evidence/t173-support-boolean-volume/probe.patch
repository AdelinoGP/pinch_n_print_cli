+//! TEMPORARY probe for wayfinder ticket 173 — support-path boolean volume.
+//!
+//! Reverted before the take closes (`probe.patch` in the ticket's evidence
+//! directory is the only artifact). Compiled into the host binary only; the
+//! wasm guest build sees an empty module via the `cfg` below.
+//!
+//! Enabled at runtime by `PNP_T173_PROBE=1`. When disabled every entry point is
+//! one relaxed atomic load, so the same binary can take uninstrumented runs.
+//!
+//! # What it measures
+//!
+//! Every `slicer_core::polygon_ops` primitive (`clip_polygons`, `offset`,
+//! `offset2_ex`) is tagged with the module and stage that issued it. Guest
+//! callers set the module through their WIT import; the runtime brackets each
+//! `run_stage` with a stage guard; host built-ins additionally claim a
+//! process-wide owner (they run one at a time). A guest may tag its next call's
+//! source site with a `t173:<site>` log line; the wasm-host `log` import
+//! intercepts it and the primitive consumes it.
+//!
+//! For boolean calls it also counts the clip operand that could matter to the
+//! subject: points inside the subject's bounding box (the ceiling for any
+//! bbox-windowed/tiled operand) and points in bbox-overlapping clip polygons.
+//! These are counters, not decisions: no call changes its arguments.
+//!
+//! Rows are accumulated thread-time, never wall. Batch calls additionally emit
+//! a wall row (`t173-batch`) because a fanned-out batch's thread-time and wall
+//! are different quantities.
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+static ON: OnceLock<bool> = OnceLock::new();
+
+/// Whether the probe is enabled (`PNP_T173_PROBE`).
+pub fn enabled() -> bool {
+    *ON.get_or_init(|| std::env::var_os("PNP_T173_PROBE").is_some())
+}
+
+#[derive(Default, Clone)]
+struct Ctx {
+    module: Option<String>,
+    stage: Option<String>,
+    site: Option<String>,
+    entry: Option<&'static str>,
+    sticky_site: bool,
+}
+
+thread_local! {
+    static CTX: RefCell<Ctx> = const { RefCell::new(Ctx {
+        module: None,
+        stage: None,
+        site: None,
+        entry: None,
+        sticky_site: false,
+    }) };
+}
+
+/// Process-wide owner for host built-ins. Built-ins run one at a time (the
+/// same assumption `NativeOwnerGuard` documents), so a single slot is correct
+/// and lets their rayon workers inherit the owner.
+static BUILTIN: Mutex<Option<String>> = Mutex::new(None);
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+struct Key {
+    module: String,
+    stage: String,
+    site: String,
+    entry: String,
+    op: String,
+}
+
+#[derive(Default, Clone)]
+struct Stats {
+    calls: u64,
+    empty_calls: u64,
+    empty_thread_ns: u64,
+    in_points: u64,
+    in_paths: u64,
+    subj_points: u64,
+    clip_points: u64,
+    out_points: u64,
+    out_paths: u64,
+    near_points: u64,
+    near_polys: u64,
+    in_bbox_points: u64,
+    thread_ns: u64,
+    max_ns: u64,
+    max_in_points: u64,
+}
+
+static ACC: Mutex<BTreeMap<Key, Stats>> = Mutex::new(BTreeMap::new());
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+struct BatchKey {
+    module: String,
+    stage: String,
+    site: String,
+    entry: String,
+}
+
+#[derive(Default, Clone)]
+struct BatchStats {
+    batches: u64,
+    requests: u64,
+    wall_ns: u64,
+    max_wall_ns: u64,
+}
+
+static BATCH_ACC: Mutex<BTreeMap<BatchKey, BatchStats>> = Mutex::new(BTreeMap::new());
+
+/// RAII stage bracket for one runtime `run_stage` / built-in.
+#[must_use]
+pub struct StageGuard {
+    prev: Option<Option<String>>,
+}
+
+impl Drop for StageGuard {
+    fn drop(&mut self) {
+        if let Some(prev) = self.prev.take() {
+            CTX.with(|cell| cell.borrow_mut().stage = prev);
+        }
+    }
+}
+
+/// Bracket a stage on the current thread.
+pub fn enter_stage(stage: &str) -> StageGuard {
+    if !enabled() {
+        return StageGuard { prev: None };
+    }
+    let prev = CTX.with(|cell| {
+        let mut ctx = cell.borrow_mut();
+        let prev = ctx.stage.take();
+        ctx.stage = Some(stage.to_owned());
+        Some(prev)
+    });
+    StageGuard { prev }
+}
+
+/// RAII module/entry bracket for one WASM host import call.
+#[must_use]
+pub struct CallGuard {
+    prev: Option<Ctx>,
+}
+
+impl Drop for CallGuard {
+    fn drop(&mut self) {
+        if let Some(prev) = self.prev.take() {
+            CTX.with(|cell| *cell.borrow_mut() = prev);
+        }
+    }
+}
+
+/// Bracket a guest import: module, optional stage, site, entry kind, sticky site.
+///
+/// `sticky_site` is for batch calls, where one tag covers every request the
+/// host fans out to this worker.
+pub fn enter_call(
+    module: &str,
+    stage: Option<&str>,
+    site: Option<&str>,
+    entry: &'static str,
+    sticky_site: bool,
+) -> CallGuard {
+    if !enabled() {
+        return CallGuard { prev: None };
+    }
+    let prev = CTX.with(|cell| {
+        let mut ctx = cell.borrow_mut();
+        let prev = ctx.clone();
+        ctx.module = Some(module.to_owned());
+        // Batch workers do not inherit the module thread's stage guard.
+        if let Some(stage) = stage {
+            ctx.stage = Some(stage.to_owned());
+        }
+        // `None` preserves a site tag already left by the log interceptor.
+        if let Some(site) = site {
+            ctx.site = Some(site.to_owned());
+        }
+        ctx.entry = Some(entry);
+        ctx.sticky_site = sticky_site;
+        Some(prev)
+    });
+    CallGuard { prev }
+}
+
+/// The stage currently bracketed on this thread (batch call capture).
+pub fn current_stage() -> Option<String> {
+    if !enabled() {
+        return None;
+    }
+    CTX.with(|cell| cell.borrow().stage.clone())
+}
+
+/// Set the source site the next primitive call will be recorded under.
+pub fn set_site(site: &str) {
+    if !enabled() {
+        return;
+    }
+    CTX.with(|cell| cell.borrow_mut().site = Some(site.to_owned()));
+}
+
+/// Take the pending site tag (batch calls spread one tag over many requests).
+pub fn take_pending_site() -> Option<String> {
+    if !enabled() {
+        return None;
+    }
+    CTX.with(|cell| cell.borrow_mut().site.take())
+}
+
+/// RAII process-wide built-in owner (host built-ins only).
+#[must_use]
+pub struct BuiltinGuard {
+    active: bool,
+}
+
+impl Drop for BuiltinGuard {
+    fn drop(&mut self) {
+        if self.active {
+            *BUILTIN.lock().expect("t173 builtin poisoned") = None;
+        }
+    }
+}
+
+/// Claim the process-wide built-in owner.
+pub fn enter_builtin(module: &str) -> BuiltinGuard {
+    if !enabled() {
+        return BuiltinGuard { active: false };
+    }
+    *BUILTIN.lock().expect("t173 builtin poisoned") = Some(module.to_owned());
+    BuiltinGuard { active: true }
+}
+
+fn context() -> (String, String, String, String) {
+    CTX.with(|cell| {
+        let mut ctx = cell.borrow_mut();
+        let builtin = BUILTIN.lock().expect("t173 builtin poisoned").clone();
+        let module = ctx
+            .module
+            .clone()
+            .or(builtin)
+            .unwrap_or_else(|| "<unknown>".to_owned());
+        let stage = ctx
+            .stage
+            .clone()
+            .unwrap_or_else(|| "<unknown>".to_owned());
+        let site = if ctx.sticky_site {
+            ctx.site.clone()
+        } else {
+            ctx.site.take()
+        }
+        .unwrap_or_else(|| "<untagged>".to_owned());
+        let entry = ctx.entry.unwrap_or("native");
+        (module, stage, site, entry.to_owned())
+    })
+}
+
+/// Record one completed primitive call. `near_*` / `in_bbox_points` are
+/// clip-only counters and may be 0 for offsets.
+#[allow(clippy::too_many_arguments)]
+pub fn record(
+    op: &'static str,
+    subj_points: u64,
+    clip_points: u64,
+    in_paths: u64,
+    out_points: u64,
+    out_paths: u64,
+    near_points: u64,
+    near_polys: u64,
+    in_bbox_points: u64,
+    elapsed_ns: u64,
+) {
+    if !enabled() {
+        return;
+    }
+    let (module, stage, site, entry) = context();
+    let key = Key {
+        module,
+        stage,
+        site,
+        entry,
+        op: op.to_owned(),
+    };
+    let in_points = subj_points + clip_points;
+    let mut acc = ACC.lock().expect("t173 acc poisoned");
+    let row = acc.entry(key).or_default();
+    row.calls += 1;
+    if out_points == 0 {
+        row.empty_calls += 1;
+        row.empty_thread_ns += elapsed_ns;
+    }
+    row.in_points += in_points;
+    row.in_paths += in_paths;
+    row.subj_points += subj_points;
+    row.clip_points += clip_points;
+    row.out_points += out_points;
+    row.out_paths += out_paths;
+    row.near_points += near_points;
+    row.near_polys += near_polys;
+    row.in_bbox_points += in_bbox_points;
+    row.thread_ns += elapsed_ns;
+    row.max_ns = row.max_ns.max(elapsed_ns);
+    row.max_in_points = row.max_in_points.max(in_points);
+}
+
+/// Record one fanned-out batch's wall (the calling thread's blocked span).
+pub fn record_batch(requests: u64, wall_ns: u64) {
+    if !enabled() {
+        return;
+    }
+    let (module, stage, site, entry) = context();
+    let key = BatchKey {
+        module,
+        stage,
+        site,
+        entry,
+    };
+    let mut acc = BATCH_ACC.lock().expect("t173 batch acc poisoned");
+    let row = acc.entry(key).or_default();
+    row.batches += 1;
+    row.requests += requests;
+    row.wall_ns += wall_ns;
+    row.max_wall_ns = row.max_wall_ns.max(wall_ns);
+}
+
+/// Print every accumulated row. Called once at the end of a probe run.
+pub fn emit_all() {
+    if !enabled() {
+        return;
+    }
+    let acc = ACC.lock().expect("t173 acc poisoned");
+    let mut rows: Vec<(&Key, &Stats)> = acc.iter().collect();
+    rows.sort_by(|a, b| b.1.thread_ns.cmp(&a.1.thread_ns));
+    let total_ns: u64 = rows.iter().map(|(_, s)| s.thread_ns).sum();
+    eprintln!("t173-probe rows={} total_thread_ns={}", rows.len(), total_ns);
+    for (key, s) in rows {
+        eprintln!(
+            "t173-row module={} stage={} site={} entry={} op={} calls={} empty_calls={} empty_thread_ns={} subj_points={} clip_points={} in_points={} in_paths={} out_points={} out_paths={} near_points={} near_polys={} in_bbox_points={} thread_ns={} max_ns={} max_in_points={}",
+            key.module,
+            key.stage,
+            key.site,
+            key.entry,
+            key.op,
+            s.calls,
+            s.empty_calls,
+            s.empty_thread_ns,
+            s.subj_points,
+            s.clip_points,
+            s.in_points,
+            s.in_paths,
+            s.out_points,
+            s.out_paths,
+            s.near_points,
+            s.near_polys,
+            s.in_bbox_points,
+            s.thread_ns,
+            s.max_ns,
+            s.max_in_points,
+        );
+    }
+    let batch = BATCH_ACC.lock().expect("t173 batch acc poisoned");
+    let mut brows: Vec<(&BatchKey, &BatchStats)> = batch.iter().collect();
+    brows.sort_by(|a, b| b.1.wall_ns.cmp(&a.1.wall_ns));
+    for (key, s) in brows {
+        eprintln!(
+            "t173-batch module={} stage={} site={} entry={} batches={} requests={} wall_ns={} max_wall_ns={}",
+            key.module,
+            key.stage,
+            key.site,
+            key.entry,
+            s.batches,
+            s.requests,
+            s.wall_ns,
+            s.max_wall_ns,
+        );
+    }
+}
+
+/// Count points and rings in an expolygon set (probe helper).
+pub fn expolygon_counts(polys: &[slicer_ir::ExPolygon]) -> (u64, u64) {
+    let mut points = 0u64;
+    let mut paths = 0u64;
+    for poly in polys {
+        points += poly.contour.points.len() as u64;
+        paths += 1;
+        for hole in &poly.holes {
+            points += hole.points.len() as u64;
+            paths += 1;
+        }
+    }
+    (points, paths)
+}
+
+fn ring_points<'a>(
+    polys: &'a [slicer_ir::ExPolygon],
+) -> impl Iterator<Item = &'a slicer_ir::Point2> + 'a {
+    polys.iter().flat_map(|poly| {
+        poly.contour
+            .points
+            .iter()
+            .chain(poly.holes.iter().flat_map(|hole| hole.points.iter()))
+    })
+}
+
+/// Clip-operand locality counters for one boolean call.
+///
+/// - `near_points` / `near_polys`: clip points and polygons whose bounding box
+///   intersects the subject's bounding box (polygon granularity).
+/// - `in_bbox_points`: clip points that lie inside the subject's bounding box
+///   (the ceiling for a bbox-windowed or tiled operand — points outside the
+///   subject bbox cannot affect a difference or intersection).
+pub fn clip_locality(subject: &[slicer_ir::ExPolygon], clip: &[slicer_ir::ExPolygon]) -> (u64, u64, u64) {
+    let mut bbox = (i64::MAX, i64::MAX, i64::MIN, i64::MIN);
+    for p in ring_points(subject) {
+        bbox.0 = bbox.0.min(p.x);
+        bbox.1 = bbox.1.min(p.y);
+        bbox.2 = bbox.2.max(p.x);
+        bbox.3 = bbox.3.max(p.y);
+    }
+    if bbox.0 == i64::MAX {
+        return (0, 0, 0);
+    }
+    let mut near_points = 0u64;
+    let mut near_polys = 0u64;
+    let mut in_bbox = 0u64;
+    for poly in clip {
+        let mut poly_bbox = (i64::MAX, i64::MAX, i64::MIN, i64::MIN);
+        let mut points = 0u64;
+        for p in std::iter::once(&poly.contour).chain(poly.holes.iter()) {
+            points += p.points.len() as u64;
+            for q in &p.points {
+                poly_bbox.0 = poly_bbox.0.min(q.x);
+                poly_bbox.1 = poly_bbox.1.min(q.y);
+                poly_bbox.2 = poly_bbox.2.max(q.x);
+                poly_bbox.3 = poly_bbox.3.max(q.y);
+                if q.x >= bbox.0 && q.x <= bbox.2 && q.y >= bbox.1 && q.y <= bbox.3 {
+                    in_bbox += 1;
+                }
+            }
+        }
+        if poly_bbox.0 != i64::MAX
+            && poly_bbox.0 <= bbox.2
+            && poly_bbox.2 >= bbox.0
+            && poly_bbox.1 <= bbox.3
+            && poly_bbox.3 >= bbox.1
