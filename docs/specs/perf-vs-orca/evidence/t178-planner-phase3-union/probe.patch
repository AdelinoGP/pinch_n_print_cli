@@ -0,0 +1,302 @@
+//! TEMPORARY probe for wayfinder ticket 178 — Planner Phase-3 batched union
+//! attribution and mechanism screen.
+//!
+//! Reverted before ticket closure (`probe.patch` in `evidence/t178-planner-phase3-union/`
+//! is the preserved artifact). Gated on `PNP_T178_TIMING_OUT` / `PNP_T178_DUMP_OUT`.
+
+use std::fs::{File, OpenOptions};
+use std::io::{BufWriter, Write};
+use std::sync::{Mutex, OnceLock};
+
+use slicer_ir::ExPolygon;
+
+#[derive(Clone, Debug)]
+pub struct Phase3ReqMeta {
+    pub layer: i32,
+    pub role: u8,
+    pub avg_nodes: u32,
+    pub simplify_tol_bits: u64,
+    pub kept_count: u32,
+    pub clip_count: u32,
+    pub kept_flags: Vec<u8>,
+}
+
+pub struct Phase3BatchReqResult {
+    pub req_idx: usize,
+    pub clip_ns: u64,
+    pub total_req_ns: u64,
+    pub in_polys: usize,
+    pub in_holes: usize,
+    pub in_verts: usize,
+    pub out_polys: usize,
+    pub out_holes: usize,
+    pub out_verts: usize,
+    pub dumped_inputs: Option<Vec<ExPolygon>>,
+    pub dumped_outputs: Option<Vec<ExPolygon>>,
+}
+
+struct ProbeConfig {
+    timing_out: Option<String>,
+    dump_out: Option<String>,
+}
+
+struct ProbeState {
+    in_phase3: bool,
+    batch_seq: u32,
+    chunk_offset: usize,
+    singletons_skipped: u32,
+    pending_meta: Vec<Phase3ReqMeta>,
+    dump_header_written: bool,
+}
+
+static CONFIG: OnceLock<ProbeConfig> = OnceLock::new();
+static STATE: Mutex<ProbeState> = Mutex::new(ProbeState {
+    in_phase3: false,
+    batch_seq: 0,
+    chunk_offset: 0,
+    singletons_skipped: 0,
+    pending_meta: Vec::new(),
+    dump_header_written: false,
+});
+
+fn config() -> &'static ProbeConfig {
+    CONFIG.get_or_init(|| ProbeConfig {
+        timing_out: std::env::var("PNP_T178_TIMING_OUT")
+            .ok()
+            .filter(|s| !s.is_empty()),
+        dump_out: std::env::var("PNP_T178_DUMP_OUT")
+            .ok()
+            .filter(|s| !s.is_empty()),
+    })
+}
+
+pub fn enabled() -> bool {
+    let c = config();
+    c.timing_out.is_some() || c.dump_out.is_some()
+}
+
+pub fn dump_enabled() -> bool {
+    config().dump_out.is_some()
+}
+
+pub fn in_phase3() -> bool {
+    if !enabled() {
+        return false;
+    }
+    STATE.lock().map(|s| s.in_phase3).unwrap_or(false)
+}
+
+/// Handle a `t178:` log line from `tree-support-planner`.
+/// Always returns `true` if the message had the `t178:` prefix so callers can
+/// suppress it from production logs.
+pub fn handle_log(message: &str) -> bool {
+    let Some(rest) = message.strip_prefix("t178:") else {
+        return false;
+    };
+    if !enabled() {
+        return true;
+    }
+    if let Some(payload) = rest.strip_prefix("phase3_start:") {
+        let mut parts = payload.split('|');
+        let singletons: u32 = parts.next().and_then(|s| s.parse().ok()).unwrap_or(0);
+        let mut metas = Vec::new();
+        for item in parts {
+            if item.is_empty() {
+                continue;
+            }
+            let f: Vec<&str> = item.split(',').collect();
+            if f.len() >= 7 {
+                let layer: i32 = f[0].parse().unwrap_or(-1);
+                let role: u8 = f[1].parse().unwrap_or(255);
+                let avg_nodes: u32 = f[2].parse().unwrap_or(0);
+                let simplify_tol_bits: u64 = f[3].parse().unwrap_or(0);
+                let kept_count: u32 = f[4].parse().unwrap_or(0);
+                let clip_count: u32 = f[5].parse().unwrap_or(0);
+                let kept_flags: Vec<u8> = f[6]
+                    .bytes()
+                    .map(|b| if b == b'1' { 1 } else { 0 })
+                    .collect();
+                metas.push(Phase3ReqMeta {
+                    layer,
+                    role,
+                    avg_nodes,
+                    simplify_tol_bits,
+                    kept_count,
+                    clip_count,
+                    kept_flags,
+                });
+            }
+        }
+        if let Ok(mut st) = STATE.lock() {
+            st.in_phase3 = true;
+            st.chunk_offset = 0;
+            st.singletons_skipped = singletons;
+            st.pending_meta = metas;
+        }
+    } else if rest == "phase3_end" {
+        if let Ok(mut st) = STATE.lock() {
+            st.in_phase3 = false;
+            st.pending_meta.clear();
+            st.chunk_offset = 0;
+        }
+    }
+    true
+}
+
+pub fn count_expolys(polys: &[ExPolygon]) -> (usize, usize, usize) {
+    let mut holes = 0usize;
+    let mut verts = 0usize;
+    for p in polys {
+        verts += p.contour.points.len();
+        holes += p.holes.len();
+        for h in &p.holes {
+            verts += h.points.len();
+        }
+    }
+    (polys.len(), holes, verts)
+}
+
+fn write_expolys<W: Write>(w: &mut W, polys: &[ExPolygon]) -> std::io::Result<()> {
+    w.write_all(&(polys.len() as u32).to_le_bytes())?;
+    for p in polys {
+        w.write_all(&(p.contour.points.len() as u32).to_le_bytes())?;
+        for pt in &p.contour.points {
+            w.write_all(&pt.x.to_le_bytes())?;
+            w.write_all(&pt.y.to_le_bytes())?;
+        }
+        w.write_all(&(p.holes.len() as u32).to_le_bytes())?;
+        for h in &p.holes {
+            w.write_all(&(h.points.len() as u32).to_le_bytes())?;
+            for pt in &h.points {
+                w.write_all(&pt.x.to_le_bytes())?;
+                w.write_all(&pt.y.to_le_bytes())?;
+            }
+        }
+    }
+    Ok(())
+}
+
+pub fn record_batch(
+    batch_wall_ns: u64,
+    mode: crate::batch::BatchMode,
+    mut results: Vec<Phase3BatchReqResult>,
+) {
+    let cfg = config();
+    let Ok(mut st) = STATE.lock() else {
+        return;
+    };
+    let batch_idx = st.batch_seq;
+    st.batch_seq += 1;
+    let offset = st.chunk_offset;
+    st.chunk_offset += results.len();
+    let singletons = if offset == 0 {
+        st.singletons_skipped
+    } else {
+        0
+    };
+    results.sort_by_key(|r| r.req_idx);
+
+    if let Some(path) = &cfg.timing_out {
+        if let Ok(file) = OpenOptions::new().create(true).append(true).open(path) {
+            let mut w = BufWriter::new(file);
+            let mode_s = match mode {
+                crate::batch::BatchMode::Serial => "serial",
+                crate::batch::BatchMode::Parallel => "parallel",
+            };
+            let _ = write!(
+                w,
+                "{{\"batch_idx\":{},\"batch_wall_ns\":{},\"mode\":\"{}\",\"singletons_skipped\":{},\"requests\":[",
+                batch_idx, batch_wall_ns, mode_s, singletons
+            );
+            for (k, r) in results.iter().enumerate() {
+                if k > 0 {
+                    let _ = write!(w, ",");
+                }
+                let meta = st.pending_meta.get(offset + r.req_idx);
+                let (layer, role, avg_nodes, simplify_bits, kept_c, clip_c) = meta
+                    .map(|m| {
+                        (
+                            m.layer,
+                            m.role,
+                            m.avg_nodes,
+                            m.simplify_tol_bits,
+                            m.kept_count,
+                            m.clip_count,
+                        )
+                    })
+                    .unwrap_or((-1, 255, 0, 0, 0, 0));
+                let _ = write!(
+                    w,
+                    "{{\"req_idx\":{},\"layer\":{},\"role\":{},\"avg_nodes\":{},\"simplify_tol_bits\":{},\"kept_count\":{},\"clip_count\":{},\"in_polys\":{},\"in_holes\":{},\"in_verts\":{},\"out_polys\":{},\"out_holes\":{},\"out_verts\":{},\"clip_ns\":{},\"total_req_ns\":{}}}",
+                    r.req_idx,
+                    layer,
+                    role,
+                    avg_nodes,
+                    simplify_bits,
+                    kept_c,
+                    clip_c,
+                    r.in_polys,
+                    r.in_holes,
+                    r.in_verts,
+                    r.out_polys,
+                    r.out_holes,
+                    r.out_verts,
+                    r.clip_ns,
+                    r.total_req_ns
+                );
+            }
+            let _ = writeln!(w, "]}}");
+            let _ = w.flush();
+        }
+    }
+
+    if let Some(path) = &cfg.dump_out {
+        let file_res = if !st.dump_header_written {
+            File::create(path)
+        } else {
+            OpenOptions::new().create(true).append(true).open(path)
+        };
+        if let Ok(file) = file_res {
+            let mut w = BufWriter::new(file);
+            if !st.dump_header_written {
+                let _ = w.write_all(b"T178P3V1");
+                st.dump_header_written = true;
+            }
+            let _ = w.write_all(&batch_idx.to_le_bytes());
+            let _ = w.write_all(&batch_wall_ns.to_le_bytes());
+            let _ = w.write_all(&(results.len() as u32).to_le_bytes());
+            for r in &results {
+                let meta = st.pending_meta.get(offset + r.req_idx);
+                let (layer, role, avg_nodes, simplify_bits, kept_c, clip_c, kept_flags) = meta
+                    .map(|m| {
+                        (
+                            m.layer,
+                            m.role,
+                            m.avg_nodes,
+                            m.simplify_tol_bits,
+                            m.kept_count,
+                            m.clip_count,
+                            m.kept_flags.as_slice(),
+                        )
+                    })
+                    .unwrap_or((-1, 255, 0, 0, 0, 0, &[]));
+                let _ = w.write_all(&layer.to_le_bytes());
+                let _ = w.write_all(&[role]);
+                let _ = w.write_all(&avg_nodes.to_le_bytes());
+                let _ = w.write_all(&simplify_bits.to_le_bytes());
+                let _ = w.write_all(&kept_c.to_le_bytes());
+                let _ = w.write_all(&clip_c.to_le_bytes());
+                let _ = w.write_all(&r.clip_ns.to_le_bytes());
+                let _ = w.write_all(&r.total_req_ns.to_le_bytes());
+                let _ = w.write_all(&(kept_flags.len() as u32).to_le_bytes());
+                let _ = w.write_all(kept_flags);
+                let empty: Vec<ExPolygon> = Vec::new();
+                let ins = r.dumped_inputs.as_ref().unwrap_or(&empty);
+                let outs = r.dumped_outputs.as_ref().unwrap_or(&empty);
+                let _ = write_expolys(&mut w, ins);
+                let _ = write_expolys(&mut w, outs);
+            }
+            let _ = w.flush();
+        }
+    }
+}
