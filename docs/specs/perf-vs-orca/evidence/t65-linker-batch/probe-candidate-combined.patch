+        // run the batch over the valid subjects and index back by position.
+        let valid_positions: Vec<usize> = polylines
+            .iter()
+            .enumerate()
+            .filter(|(_, polyline)| polyline.len() >= 2)
+            .map(|(position, _)| position)
+            .collect();
