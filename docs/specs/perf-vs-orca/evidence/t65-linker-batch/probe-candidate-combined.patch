+// [T65-PROBE] wayfinder ticket 65; removed before any commit. Counters for
+// the in-guest batch-execute oracle; the linker's probe module flushes them
+// once per layer through the module-log channel.
+///
+/// Probe-only; the t65 probe patch drops the whole module together with its
+/// callers.
+pub mod probe_t65 {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static SINGLES: AtomicU64 = AtomicU64::new(0);
+    static FALLBACKS: AtomicU64 = AtomicU64::new(0);
+    static REPAIRS: AtomicU64 = AtomicU64::new(0);
+
+    /// Counts a single-subject early-out (batch bypassed, no ambiguity).
+    pub fn singles_bump() {
+        SINGLES.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// Counts an unattributable / engine-failure whole-call fallback fire.
+    pub fn fallback_bump() {
+        FALLBACKS.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// Counts one ambiguity-repaired subject.
+    pub fn repair_bump() {
+        REPAIRS.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// Takes all three counts (resetting them); called once per invocation
+    /// by the linker's probe replay. Single-threaded per module instance,
+    /// so the take-then-bump race window does not exist on this workload.
+    pub fn take_counts() -> (u64, u64, u64) {
+        (
+            SINGLES.swap(0, Ordering::Relaxed),
+            FALLBACKS.swap(0, Ordering::Relaxed),
+            REPAIRS.swap(0, Ordering::Relaxed),
+        )
+    }
 }
 
