  "oracle_manifest": "[package]\nname = \"slicer-core-oracle\"\nversion = \"0.1.0\"\nedition = \"2021\"\nauthors = [\"Pinch 'n Print Team\"]\n\n[features]\ndefault = []\nhost-algos = [\"dep:rayon\", \"dep:boostvoronoi\"]\nperimeter-spatial-test-support = []\n# Opt-in only for the synthetic panic regression. Keeping this off the\n# workspace's normal test feature set prevents boostvoronoi diagnostics from\n# leaking into unrelated crates' test harnesses.\nvoronoi-panic-regression = [\"boostvoronoi/console_debug\"]\n\n[dependencies]\nclipper2-rust = { package = \"clipper2-rust-oracle\", path = \"../clipper2-original\", version = \"=1.1.0\" }\nlog = \"0.4\"\nrstar = \"0.12\"\nrayon = { version = \"1.10\", optional = true }\nboostvoronoi = { version = \"0.12\", optional = true }\nslicer-ir = { path = \"../../crates/slicer-ir\" }\n# Region mapping re-resolves per-region configs through the typed scope\n# resolver when a layer range covers the layer's top Z (packet\n# `config-scope-resolution_09`). `slicer-config` depends on `slicer-ir` only,\n# so this adds no cycle and compiles for `wasm32`.\nslicer-config = { path = \"../../crates/slicer-config\" }\nserde = { version = \"1\", features = [\"derive\"] }\n\n\n[workspace]\n",
  "difference": "package/dependency identity only; unchanged production algorithms with pristine independent engine"
}
