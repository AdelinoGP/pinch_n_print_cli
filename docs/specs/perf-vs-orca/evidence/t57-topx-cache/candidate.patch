+//! Test-only cache contract; not compiled into timing artifacts.
+use super::*;
+
+fn edge() -> Active {
+    Active {
+        bot: Point64::new(0, 14),
+        top: Point64::new(7, 0),
+        dx: -0.5,
+        vertex_top: 3,
+        ..Active::new()
+    }
+}
+
+/// Executes actual cache hits, every key guard, fallback and engine lifetime boundaries.
+pub fn run_checks() -> [usize; 3] {
+    let mut base = ClipperBase::new();
+    let idx = base.new_active();
+    base.active_arena[idx] = edge();
+    base.actives = Some(idx);
+    base.adjust_curr_x_and_copy_to_sel(7);
+    assert_eq!(
+        base.active_arena[idx].curr_x, 4,
+        "analytical half-to-even projection"
+    );
+    assert_eq!(base.topx_cache_counts, [1, 0, 0]);
+    base.active_arena[idx].curr_x = -999; // intersection overwrite must not become the cached answer
+    base.do_top_of_scanbeam(7);
+    assert_eq!(base.active_arena[idx].curr_x, 4);
+    assert_eq!(
+        base.topx_cache_counts,
+        [1, 1, 0],
+        "actual scanbeam-top cache hit"
+    );
+
+    let original = base.scanbeam_projections[idx].unwrap();
+    let mutations: [fn(&mut Active); 7] = [
+        |e| e.bot.x += 1,
+        |e| e.bot.y += 1,
+        |e| e.top.x += 1,
+        |e| e.top.y += 1,
+        |e| e.dx = -0.625,
+        |e| e.vertex_top += 1,
+        |e| e.dx = f64::from_bits(e.dx.to_bits() ^ 1),
+    ];
+    for mutate in mutations {
+        base.active_arena[idx] = edge();
+        mutate(&mut base.active_arena[idx]);
+        base.scanbeam_projections[idx] = Some(original);
+        assert!(
+            original.get(idx, &base.active_arena[idx], 7).is_none(),
+            "changed geometry/slope/vertex must reject"
+        );
+        let before = base.topx_cache_counts;
+        assert_eq!(
+            base.scanbeam_projection_or_original(idx, 7),
+            top_x(&base.active_arena[idx], 7)
+        );
+        assert_eq!(base.topx_cache_counts[1], before[1]);
+        assert_eq!(
+            base.topx_cache_counts[2],
+            before[2] + 1,
+            "actual key-mismatch fallback"
+        );
+    }
+    base.active_arena[idx] = edge();
+    for (y, record) in [
+        (6, Some(original)),
+        (7, None),
+        (
+            7,
+            Some(ScanbeamProjection {
+                edge_idx: 99,
+                ..original
+            }),
+        ),
+    ] {
+        base.scanbeam_projections[idx] = record;
+        let before = base.topx_cache_counts[2];
+        assert_eq!(
+            base.scanbeam_projection_or_original(idx, y),
+            top_x(&base.active_arena[idx], y)
+        );
+        assert_eq!(
+            base.topx_cache_counts[2],
+            before + 1,
+            "y/missing/identity fallback"
+        );
+    }
+    // Arena indices may be recycled after clear/cleanup; reset is also an explicit cache boundary.
+    for boundary in [
+        ClipperBase::reset,
+        ClipperBase::clean_up,
+        ClipperBase::clear,
+    ] {
+        base.active_arena.clear();
+        let idx = base.new_active();
+        base.active_arena[idx] = edge();
+        base.actives = Some(idx);
+        base.adjust_curr_x_and_copy_to_sel(7);
+        boundary(&mut base);
+        assert!(
+            base.scanbeam_projections.is_empty(),
+            "lifetime must discard cached records"
+        );
+        base.active_arena.clear();
+        let recycled = base.new_active();
+        assert_eq!(recycled, 0);
+        base.active_arena[recycled] = edge();
+        let before = base.topx_cache_counts[2];
+        assert_eq!(base.scanbeam_projection_or_original(recycled, 7), 4);
+        assert_eq!(
+            base.topx_cache_counts[2],
+            before + 1,
+            "recycled slot cannot hit old cache"
+        );
+    }
+    // Exact existing branches and rounding, including terminal, horizontal and vertical edges.
+    for (bot, top, y, expected) in [
+        ((0, 14), (7, 0), 14, 0),
+        ((0, 14), (7, 0), 0, 7),
+        ((0, 14), (7, 0), 13, 0),
+        ((0, 14), (7, 0), 11, 2),
+        ((0, 14), (-7, 0), 13, 0),
+        ((0, 14), (-7, 0), 11, -2),
+        ((5, 14), (5, 0), 7, 5),
+        ((2, 0), (8, 0), 0, 8),
+        ((16_777_217, 14), (16_777_224, 0), 7, 16_777_221),
+    ] {
+        let mut e = Active {
+            bot: Point64::new(bot.0, bot.1),
+            top: Point64::new(top.0, top.1),
+            ..Active::new()
+        };
+        set_dx(&mut e);
+        let projected = top_x(&e, y);
+        assert_eq!(projected, expected, "analytical endpoint/rounding branch");
+        assert_eq!(
+            ScanbeamProjection::capture(0, &e, y, projected).get(0, &e, y),
+            Some(expected)
+        );
+    }
+    let counts = base.topx_cache_counts;
+    assert!(counts[0] > 0 && counts[1] > 0 && counts[2] > 0);
+    counts
+}
+
+#[test]
+fn topx_projection_full_key_and_lifetime_contract() {
+    let counts = run_checks();
+    assert_eq!(counts[1], 1);
+    assert_eq!(counts[2], 13);
+}
