 use std::path::{Path, PathBuf};
 use std::process::Command;
 use std::time::{SystemTime, UNIX_EPOCH};
+
+#[cfg(test)]
+mod t57_dependency_closure {
+    use super::*;
+
+    #[test]
+    fn t57_explicit_clipper_source_is_fingerprint_sensitive_in_each_affected_guest() {
+        let root = workspace_root();
+        let engine = root
+            .join(".local-libs/clipper2-rust/src/engine.rs")
+            .canonicalize()
+            .unwrap();
+        let (guests, skips) = discover_guests(&root);
+        // The API returns skip reasons, not errors; non-cdylib witness libraries are not guests.
+        // Validate each skipped manifest against its actual target declaration, never ignore read/parse failures.
+        for skip in &skips {
+            let manifest = skip
+                .strip_prefix("SKIP: ")
+                .unwrap()
+                .strip_suffix(" ([lib].crate-type does not contain cdylib)")
+                .expect("unexpected guest rejection");
+            let declared: toml::Table =
+                toml::from_str(&fs::read_to_string(root.join(manifest)).unwrap()).unwrap();
+            let kinds = declared
+                .get("lib")
+                .and_then(|v| v.get("crate-type"))
+                .and_then(toml::Value::as_array);
+            assert!(
+                !kinds.is_some_and(|xs| xs.iter().any(|v| v.as_str() == Some("cdylib"))),
+                "actual guest was skipped"
+            );
+        }
+        assert!(!guests.is_empty());
+        let mut cache = ClosureCache::new();
+        let mut covered = Vec::new();
+        for guest in guests {
+            let paths = guest_closure_input_paths(&guest, &mut cache).unwrap();
+            let core = root
+                .join("crates/slicer-core/src/lib.rs")
+                .canonicalize()
+                .unwrap();
+            if paths.contains(&core) {
+                assert!(
+                    paths.contains(&engine),
+                    "core-dependent guest omitted copied engine: {}",
+                    guest.crate_name
+                );
+            }
+            if paths.contains(&engine) {
+                let snapshot = snapshot_from_paths(&root, &paths);
+                let mut changed = snapshot.entries.clone();
+                let entry = changed
+                    .iter_mut()
+                    .find(|e| e.path == relative_input_path(&root, &engine))
+                    .unwrap();
+                entry
+                    .bytes
+                    .extend_from_slice(b"\n// deliberate engine-source edit\n");
+                assert_ne!(
+                    snapshot.fingerprint,
+                    fingerprint_entries(&changed),
+                    "source edit must invalidate {}",
+                    guest.crate_name
+                );
+                covered.push(guest.crate_name);
+            }
+        }
+        assert!(
+            covered.iter().any(|name| name.contains("classic")),
+            "classic guest not tracked"
+        );
+        assert!(
+            covered.iter().any(|name| name.contains("arachne")),
+            "Arachne guest not tracked"
+        );
+        assert!(
+            covered.iter().any(|name| name.contains("infill")),
+            "linker guest not tracked"
+        );
+        println!("T57_CLOSURE_GUESTS {}", covered.join(","));
+    }
+}
 
