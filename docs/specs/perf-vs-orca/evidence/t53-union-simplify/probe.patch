+// PERF-T53-PROBE: temporary diagnostics, no geometry changes.
+std::thread_local! {
+    static T53_ID: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+    static T53_SAMPLES: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+    static T53_LAYER_SAMPLE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+fn t53_shape(polys: &[ExPolygon]) -> [usize; 4] {
+    let mut shape = [polys.len(), 0, 0, 0];
+    for ex in polys {
+        shape[1] += ex.holes.len();
+        for ring in std::iter::once(&ex.contour).chain(ex.holes.iter()) {
+            shape[2] += ring.points.len();
+            shape[3] = shape[3].max(ring.points.len());
+        }
+    }
+    shape
+}
+
+fn t53_geometry(polys: &[ExPolygon]) -> String {
+    // Exact integer coordinates, polygon/ring/vertex order retained; no float conversion.
+    let rings = |ex: &ExPolygon| -> String {
+        let ring = |p: &Polygon| -> String {
+            format!(
+                "[{}]",
+                p.points
+                    .iter()
+                    .map(|p| format!("[{},{}]", p.x, p.y))
+                    .collect::<Vec<_>>()
+                    .join(",")
+            )
+        };
+        format!(
+            "[{}]",
+            std::iter::once(&ex.contour)
+                .chain(ex.holes.iter())
+                .map(ring)
+                .collect::<Vec<_>>()
+                .join(",")
+        )
+    };
+    format!(
+        "[{}]",
+        polys.iter().map(rings).collect::<Vec<_>>().join(",")
+    )
+}
