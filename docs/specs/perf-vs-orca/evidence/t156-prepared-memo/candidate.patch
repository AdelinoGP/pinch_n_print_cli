+        .as_ptr();
+    let source_ptr = arena
+        .prepared_perimeter_source_regions()
+        .expect("perimeter source prepared")
+        .as_ptr();
+
+    sync_perimeter_infill_areas_into_slice(&mut arena, 0).expect("fill-only sync");
+
+    let ordinary = arena
+        .prepared_regions()
+        .expect("fill-only sync must preserve the ordinary derivation");
+    let source = arena
+        .prepared_perimeter_source_regions()
+        .expect("fill-only sync must preserve the perimeter-source derivation");
+    assert_eq!(
+        ordinary.len(),
+        2,
+        "the staged two-region slice stays intact"
+    );
+    assert!(
+        arena
+            .slice()
+            .expect("slice stays staged")
+            .regions
+            .iter()
+            .all(|region| !region.sparse_infill_area.is_empty()),
+        "the sync must have assigned the fill roles, not returned early"
+    );
+    assert!(
+        std::ptr::eq(ordinary_ptr, ordinary.as_ptr()),
+        "the fill-only sync must not pay for a second ordinary derivation"
+    );
+    assert!(
+        std::ptr::eq(source_ptr, source.as_ptr()),
+        "the fill-only sync must not pay for a second perimeter-source derivation"
+    );
+}
+
+/// A footprint split changes region count/order and base `polygons`, so the
+/// same public sync must invalidate both derivations on that path instead.
+#[test]
+fn modifier_footprint_sync_clears_both_prepared_region_projections() {
+    let mut slice = coinciding_slice();
+    slice.regions.push(region(
+        "obj",
+        MODIFIER_FOOTPRINT_REGION_ID,
+        vec![rect(0.0, 0.0, 2.0, 10.0)],
+    ));
+    let mut arena = LayerArena::new();
+    arena.set_slice(slice.clone()).expect("stage the slice");
+    stage_perimeters(&mut arena, &slice);
+    arena.ensure_prepared_regions(None);
+    arena.ensure_prepared_perimeter_source_regions(None);
+    assert!(arena.prepared_regions().is_some());
+    assert!(arena.prepared_perimeter_source_regions().is_some());
+
+    sync_perimeter_infill_areas_into_slice(&mut arena, 0).expect("modifier footprint sync");
+
+    let regions = &arena.slice().expect("slice stays staged").regions;
+    assert!(
+        regions
+            .iter()
+            .all(|region| region.region_id != MODIFIER_FOOTPRINT_REGION_ID),
+        "the footprint must be consumed, not merely followed by a clear"
+    );
+    assert!(
+        regions
+            .iter()
+            .any(|region| slicer_ir::is_modifier_namespace_id(region.region_id)),
+        "the split must actually mint the child region"
+    );
+    assert!(
+        arena.prepared_regions().is_none(),
+        "the split changes the ordinary derivation's region list and polygons"
+    );
+    assert!(
+        arena.prepared_perimeter_source_regions().is_none(),
+        "the split also changes the wall-owning projection's inputs"
+    );
+}
