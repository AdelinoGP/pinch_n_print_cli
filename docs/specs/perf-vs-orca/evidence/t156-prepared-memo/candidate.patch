+fn stage_perimeters(arena: &mut LayerArena, slice: &SliceIR) {
+    arena
+        .set_perimeter(PerimeterIR {
+            global_layer_index: slice.global_layer_index,
+            regions: slice
+                .regions
+                .iter()
+                .filter(|region| region.region_id != MODIFIER_FOOTPRINT_REGION_ID)
+                .map(|region| PerimeterRegion {
+                    object_id: region.object_id.clone(),
+                    region_id: region.region_id,
+                    variant_chain: region.variant_chain.clone(),
+                    infill_areas: region.polygons.clone(),
+                    ..PerimeterRegion::default()
+                })
+                .collect(),
+            ..PerimeterIR::default()
+        })
+        .expect("stage perimeters");
