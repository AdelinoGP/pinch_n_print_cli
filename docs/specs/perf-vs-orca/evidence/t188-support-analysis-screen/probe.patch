diff --git a/crates/slicer-core/src/t188_probe.rs b/crates/slicer-core/src/t188_probe.rs
new file mode 100644
--- /dev/null
+++ b/crates/slicer-core/src/t188_probe.rs
@@ -0,0 +1,184 @@
+#![allow(missing_docs)]
+//! t188 TEMPORARY observation-only probe (never landed; reverted before resolution).
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Mutex;
+use std::time::Instant;
+
+use slicer_ir::ExPolygon;
+
+pub const N: usize = 24;
+pub const NAMES: [&str; N] = [
+    "grown_offset",
+    "trimmed_diff",
+    "expand_back_offset",
+    "expand_back_intersect_diff",
+    "blockers_diff",
+    "bridge_margin",
+    "erosion_offset",
+    "xy_expansion_offset",
+    "final_union",
+    "cantilever_offset",
+    "cantilever_diff",
+    "derive_needs_support",
+    "contact_item_total",
+    "enforced_blocked_intersections",
+    "ppo_world_mesh",
+    "ppo_make_lines",
+    "ppo_chain",
+    "object_layer_union",
+    "ppo_chain_per_layer",
+    "trimmed_nonempty",
+    "erosion_dropped",
+    "contacts_nonempty",
+    "cantilever_nonempty",
+    "grown_zero_offset_diff",
+];
+
+#[allow(clippy::declare_interior_mutable_const)]
+const Z: AtomicU64 = AtomicU64::new(0);
+pub static NS: [AtomicU64; N] = [Z; N];
+pub static CNT: [AtomicU64; N] = [Z; N];
+pub static VIN: [AtomicU64; N] = [Z; N];
+pub static VOUT: [AtomicU64; N] = [Z; N];
+pub static MAXNS: [AtomicU64; N] = [Z; N];
+pub static IN_PPO: AtomicBool = AtomicBool::new(false);
+pub static IN_SA: AtomicBool = AtomicBool::new(false);
+
+#[derive(Clone, Debug)]
+pub struct LayerContactSample {
+    pub layer_index: u32,
+    pub total_ns: u64,
+    pub grown_ns: u64,
+    pub trimmed_diff_ns: u64,
+    pub expand_back_ns: u64,
+    pub erosion_ns: u64,
+    pub final_union_ns: u64,
+    pub cantilever_off_ns: u64,
+    pub cantilever_diff_ns: u64,
+    pub lower_verts: u64,
+    pub region_verts: u64,
+    pub trimmed_verts: u64,
+    pub contact_verts: u64,
+    pub cantilever_hit: bool,
+    pub region_eq_lower: bool,
+}
+
+pub static LAYER_SAMPLES: Mutex<Vec<LayerContactSample>> = Mutex::new(Vec::new());
+
+pub fn enabled() -> bool {
+    std::env::var_os("T188_PROBE_OUT").is_some()
+}
+
+pub fn verts(p: &[ExPolygon]) -> u64 {
+    p.iter()
+        .map(|e| {
+            e.contour.points.len() as u64
+                + e.holes.iter().map(|h| h.points.len() as u64).sum::<u64>()
+        })
+        .sum()
+}
+
+pub fn add(i: usize, start: Instant, vin: u64, vout: u64) {
+    let ns = start.elapsed().as_nanos() as u64;
+    NS[i].fetch_add(ns, Ordering::Relaxed);
+    CNT[i].fetch_add(1, Ordering::Relaxed);
+    VIN[i].fetch_add(vin, Ordering::Relaxed);
+    VOUT[i].fetch_add(vout, Ordering::Relaxed);
+    MAXNS[i].fetch_max(ns, Ordering::Relaxed);
+}
+
+pub fn inc(i: usize, v: u64) {
+    CNT[i].fetch_add(v, Ordering::Relaxed);
+}
+
+pub fn push_layer_sample(s: LayerContactSample) {
+    if let Ok(mut guard) = LAYER_SAMPLES.lock() {
+        guard.push(s);
+    }
+}
+
+pub fn reset() {
+    for i in 0..N {
+        NS[i].store(0, Ordering::Relaxed);
+        CNT[i].store(0, Ordering::Relaxed);
+        VIN[i].store(0, Ordering::Relaxed);
+        VOUT[i].store(0, Ordering::Relaxed);
+        MAXNS[i].store(0, Ordering::Relaxed);
+    }
+    if let Ok(mut guard) = LAYER_SAMPLES.lock() {
+        guard.clear();
+    }
+}
+
+pub fn ops_json() -> String {
+    let mut parts = Vec::new();
+    for i in 0..N {
+        let c = CNT[i].load(Ordering::Relaxed);
+        if c == 0 {
+            continue;
+        }
+        parts.push(format!(
+            "\"{}\":{{\"ns\":{},\"count\":{},\"vin\":{},\"vout\":{},\"max_ns\":{}}}",
+            NAMES[i],
+            NS[i].load(Ordering::Relaxed),
+            c,
+            VIN[i].load(Ordering::Relaxed),
+            VOUT[i].load(Ordering::Relaxed),
+            MAXNS[i].load(Ordering::Relaxed)
+        ));
+    }
+    format!("{{{}}}", parts.join(","))
+}
+
+pub fn top_layers_json(limit: usize) -> String {
+    let mut samples = LAYER_SAMPLES.lock().map(|g| g.clone()).unwrap_or_default();
+    samples.sort_by(|a, b| b.total_ns.cmp(&a.total_ns));
+    let mut parts = Vec::new();
+    for s in samples.into_iter().take(limit) {
+        parts.push(format!(
+            "{{\"layer\":{},\"total_ns\":{},\"grown_ns\":{},\"trimmed_diff_ns\":{},\"expand_back_ns\":{},\"erosion_ns\":{},\"final_union_ns\":{},\"cantilever_off_ns\":{},\"cantilever_diff_ns\":{},\"lower_verts\":{},\"region_verts\":{},\"trimmed_verts\":{},\"contact_verts\":{},\"cantilever_hit\":{},\"region_eq_lower\":{}}}",
+            s.layer_index,
+            s.total_ns,
+            s.grown_ns,
+            s.trimmed_diff_ns,
+            s.expand_back_ns,
+            s.erosion_ns,
+            s.final_union_ns,
+            s.cantilever_off_ns,
+            s.cantilever_diff_ns,
+            s.lower_verts,
+            s.region_verts,
+            s.trimmed_verts,
+            s.contact_verts,
+            s.cantilever_hit,
+            s.region_eq_lower
+        ));
+    }
+    format!("[{}]", parts.join(","))
+}
+
+pub fn layer_summary_json() -> String {
+    let samples = LAYER_SAMPLES.lock().map(|g| g.clone()).unwrap_or_default();
+    let total = samples.len();
+    let eq_lower = samples.iter().filter(|s| s.region_eq_lower).count();
+    let cantilever_hits = samples.iter().filter(|s| s.cantilever_hit).count();
+    let trimmed_pos = samples.iter().filter(|s| s.trimmed_verts > 0).count();
+    let contacts_pos = samples.iter().filter(|s| s.contact_verts > 0).count();
+    let sum_total_ns: u64 = samples.iter().map(|s| s.total_ns).sum();
+    let max_total_ns: u64 = samples.iter().map(|s| s.total_ns).max().unwrap_or(0);
+    let mut sorted_ns: Vec<u64> = samples.iter().map(|s| s.total_ns).collect();
+    sorted_ns.sort_unstable();
+    let p50 = sorted_ns.get(sorted_ns.len() / 2).copied().unwrap_or(0);
+    let p90 = sorted_ns
+        .get((sorted_ns.len() * 9) / 10)
+        .copied()
+        .unwrap_or(0);
+    let p99 = sorted_ns
+        .get((sorted_ns.len() * 99) / 100)
+        .copied()
+        .unwrap_or(0);
+    format!(
+        "{{\"layers\":{},\"region_eq_lower\":{},\"trimmed_nonempty\":{},\"contacts_nonempty\":{},\"cantilever_hits\":{},\"sum_total_ns\":{},\"max_total_ns\":{},\"p50_ns\":{},\"p90_ns\":{},\"p99_ns\":{}}}",
+        total, eq_lower, trimmed_pos, contacts_pos, cantilever_hits, sum_total_ns, max_total_ns, p50, p90, p99
+    )
+}
