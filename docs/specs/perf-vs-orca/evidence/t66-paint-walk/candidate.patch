+/// True if `segment_annotations` carries at least one `Some(_)` paint value
+/// under a support-relevant semantic (`SupportBlocker` or
+/// `SupportEnforcer`).
+///
+/// `support_eligibility` classifies exclusively from these two map entries
+/// (plus the region-area floor), so when this predicate is false for every
+/// region of an attached slice, `support_eligibility` returns
+/// `DefaultEligible` for any region polygon set. A caller that aggregates
+/// per-region eligibility over a whole slice (e.g.
+/// `PaintRegionLayerView::paint_policy_for` in `crates/slicer-sdk/src/traits.rs`)
+/// may therefore answer `DefaultEligible` without any geometry work when no
+/// region carries support paint — the annotations-empty fast path of
+/// wayfinder ticket 66. The predicate is deliberately conservative: it
+/// returns true whenever a `Some(_)` value exists even if the region-area
+/// floor would suppress the classification, which costs an unskipped walk
+/// but can never change an answer.
+pub fn has_support_paint(
+    segment_annotations: &HashMap<PaintSemantic, Vec<Vec<Option<PaintValue>>>>,
+) -> bool {
+    entries_has_some_paint(segment_annotations.get(&PaintSemantic::SupportBlocker))
+        || entries_has_some_paint(segment_annotations.get(&PaintSemantic::SupportEnforcer))
+}
+
 /// True if `region`'s `segment_annotations[semantic]` map entry contains at
