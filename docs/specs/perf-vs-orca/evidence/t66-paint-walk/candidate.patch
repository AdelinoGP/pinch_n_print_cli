+#[test]
+fn has_support_paint_detects_support_semantics_only() {
+    // A `Some(_)` value under either support semantic is support paint.
+    assert!(has_support_paint(&annotations_with(
+        PaintSemantic::SupportBlocker,
+        1
+    )));
+    assert!(has_support_paint(&annotations_with(
+        PaintSemantic::SupportEnforcer,
+        1
+    )));
+
+    // No map, or only non-support semantics, is not support paint — the
+    // fast path must not be reachable from paint this classifier cannot read.
+    let empty: HashMap<PaintSemantic, Vec<Vec<Option<PaintValue>>>> = HashMap::new();
+    assert!(!has_support_paint(&empty));
+    assert!(!has_support_paint(&annotations_with(
+        PaintSemantic::Material,
+        1
+    )));
+    assert!(!has_support_paint(&annotations_with(
+        PaintSemantic::FuzzySkin,
+        1
+    )));
+    assert!(!has_support_paint(&annotations_with(
+        PaintSemantic::Custom("nozzle".to_string()),
+        1
+    )));
+}
+
+#[test]
+fn has_support_paint_requires_a_some_value() {
+    // Key present but every value `None`: no paint, never triggers the
+    // fast-path skip — the same emptiness `support_eligibility` sees.
+    let mut none_only = HashMap::new();
+    none_only.insert(
+        PaintSemantic::SupportBlocker,
+        vec![vec![None, None], vec![None]],
+    );
+    assert!(!has_support_paint(&none_only));
+
+    // A present-but-empty polygon list is also no paint.
+    let mut empty_polys = HashMap::new();
+    empty_polys.insert(PaintSemantic::SupportEnforcer, Vec::new());
+    assert!(!has_support_paint(&empty_polys));
+}
+
+#[test]
+fn no_support_paint_implies_default_eligible_for_any_polygons() {
+    // Exactness invariant behind the annotations-empty fast path (ticket 66):
+    // when `has_support_paint` is false, `support_eligibility` returns
+    // `DefaultEligible` for every polygon set (here a region well above the
+    // area floor). If the classifier ever starts reading another semantic
+    // or another paint entry, this fails and the fast path must be revisited.
+    let cases: [HashMap<PaintSemantic, Vec<Vec<Option<PaintValue>>>>; 4] = [
+        HashMap::new(),
+        annotations_with(PaintSemantic::Material, 1),
+        annotations_with(PaintSemantic::FuzzySkin, 1),
+        annotations_with(PaintSemantic::Custom("nozzle".to_string()), 1),
+    ];
+    for annotations in cases {
+        assert!(
+            !has_support_paint(&annotations),
+            "fixture case must be support-paint free"
+        );
+        assert_eq!(
+            support_eligibility(&[ten_mm_square()], &annotations),
+            SupportPaintPolicy::DefaultEligible,
+            "a support-paint-free slice must classify as DefaultEligible"
+        );
+    }
+}
+
+#[test]
+fn has_support_paint_is_conservative_under_the_area_floor() {
+    // The predicate may stay true while the classifier's area floor
+    // suppresses the result (10×10 units = 100 units² < 200 units²): the
+    // fast path then keeps the walk, which costs work but cannot change an
+    // answer. The same annotations classify a non-degenerate square, so the
+    // predicate is not vacuously true.
+    let below_floor = ExPolygon {
+        contour: Polygon {
+            points: vec![
+                Point2 { x: 0, y: 0 },
+                Point2 { x: 10, y: 0 },
+                Point2 { x: 10, y: 10 },
+                Point2 { x: 0, y: 10 },
+            ],
+        },
+        holes: Vec::new(),
+    };
+    let annotations = annotations_with(PaintSemantic::SupportBlocker, 1);
+    assert!(has_support_paint(&annotations));
+    assert_eq!(
+        support_eligibility(&[below_floor], &annotations),
+        SupportPaintPolicy::DefaultEligible
+    );
+    assert_eq!(
+        support_eligibility(&[ten_mm_square()], &annotations),
+        SupportPaintPolicy::Blocked
+    );
+}
