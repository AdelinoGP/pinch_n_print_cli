@@ -0,0 +1,246 @@
+//! TEMPORARY probe for wayfinder ticket 131 — per-op cost decomposition.
+//!
+//! Reverted before the take closes (`probe.patch` in the ticket's evidence
+//! directory is the only artifact). Compiled into the host binary only; the
+//! wasm guest build sees the no-op stub via the `cfg` below.
+//!
+//! Enabled at runtime by `PNP_T131_PROBE=1`. When disabled every entry point
+//! is one relaxed atomic load plus a branch, so a probe binary can also be
+//! used for an uninstrumented run.
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+
+/// Clipper2 boolean primitive.
+pub const OP_CLIP: usize = 0;
+/// Single-pass clipper2 inflate (`offset`, and both passes of `opening` /
+/// `closing_ex`).
+pub const OP_OFFSET: usize = 1;
+/// `offset2_ex`'s first (flat) pass.
+pub const OP_OFFSET2_P1: usize = 2;
+/// `offset2_ex`'s second (tree-capturing) pass.
+pub const OP_OFFSET2_P2: usize = 3;
+
+/// Op names in [`OP_NAMES`] order.
+pub const OP_NAMES: [&str; 4] = ["clip", "offset", "offset2_p1", "offset2_p2"];
+/// Number of op kinds.
+pub const N_OPS: usize = 4;
+
+/// Field indices in a snapshot row.
+pub const F_CALLS: usize = 0;
+pub const F_WIT_IN: usize = 1;
+pub const F_CONV_IN: usize = 2;
+pub const F_SWEEP: usize = 3;
+pub const F_REBUILD: usize = 4;
+pub const F_WIT_OUT: usize = 5;
+pub const F_IN_POINTS: usize = 6;
+pub const F_IN_PATHS: usize = 7;
+pub const F_OUT_POINTS: usize = 8;
+pub const F_OUT_PATHS: usize = 9;
+pub const F_MAX_IN_POINTS: usize = 10;
+const N_FIELDS: usize = 11;
+
+static DATA: [[AtomicU64; N_FIELDS]; N_OPS] = [
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+    [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ],
+];
+
+static ON: OnceLock<bool> = OnceLock::new();
+
+/// Whether the probe is enabled (`PNP_T131_PROBE`).
+pub fn enabled() -> bool {
+    *ON.get_or_init(|| std::env::var_os("PNP_T131_PROBE").is_some())
+}
+
+/// Add `value` to one field of one op kind.
+pub fn add(op: usize, field: usize, value: u64) {
+    if value != 0 {
+        DATA[op][field].fetch_add(value, Relaxed);
+    }
+}
+
+/// Record one completed op's split. Durations are nanoseconds.
+pub fn record(
+    op: usize,
+    conv_in_ns: u64,
+    sweep_ns: u64,
+    rebuild_ns: u64,
+    in_points: u64,
+    in_paths: u64,
+    out_points: u64,
+    out_paths: u64,
+) {
+    add(op, F_CALLS, 1);
+    add(op, F_CONV_IN, conv_in_ns);
+    add(op, F_SWEEP, sweep_ns);
+    add(op, F_REBUILD, rebuild_ns);
+    add(op, F_IN_POINTS, in_points);
+    add(op, F_IN_PATHS, in_paths);
+    add(op, F_OUT_POINTS, out_points);
+    add(op, F_OUT_PATHS, out_paths);
+    if in_points > DATA[op][F_MAX_IN_POINTS].load(Relaxed) {
+        DATA[op][F_MAX_IN_POINTS].store(in_points, Relaxed);
+    }
+}
+
+/// A consistent-ish snapshot of every op/field counter.
+pub fn snapshot() -> [[u64; N_FIELDS]; N_OPS] {
+    let mut out = [[0u64; N_FIELDS]; N_OPS];
+    for op in 0..N_OPS {
+        for field in 0..N_FIELDS {
+            out[op][field] = DATA[op][field].load(Relaxed);
+        }
+    }
+    out
+}
+
+/// Print the per-op delta between two snapshots, tagged with `stage`.
+pub fn emit_stage(stage: &str, before: [[u64; N_FIELDS]; N_OPS], after: [[u64; N_FIELDS]; N_OPS]) {
+    for op in 0..N_OPS {
+        let calls = after[op][F_CALLS].saturating_sub(before[op][F_CALLS]);
+        if calls == 0 {
+            continue;
+        }
+        let d = |f: usize| after[op][f].saturating_sub(before[op][f]);
+        eprintln!(
+            "t131-stage stage={} op={} calls={} wit_in_ns={} conv_in_ns={} sweep_ns={} rebuild_ns={} wit_out_ns={} in_points={} in_paths={} out_points={} out_paths={}",
+            stage,
+            OP_NAMES[op],
+            calls,
+            d(F_WIT_IN),
+            d(F_CONV_IN),
+            d(F_SWEEP),
+            d(F_REBUILD),
+            d(F_WIT_OUT),
+            d(F_IN_POINTS),
+            d(F_IN_PATHS),
+            d(F_OUT_POINTS),
+            d(F_OUT_PATHS),
+        );
+    }
+}
+
+/// Print a whole-cell total row (used for the per-layer and postpass phases).
+pub fn emit_total(stage: &str, before: [[u64; N_FIELDS]; N_OPS], after: [[u64; N_FIELDS]; N_OPS]) {
+    emit_stage(stage, before, after);
+}
+
+/// Content census of one polygon payload: `(polygons, points, hash, bbox)`.
+///
+/// `hash` is an FNV-1a fold over every point's `(x, y)` and every ring
+/// boundary marker, so two payloads hash equal only if their ring structure
+/// and coordinates are equal. `bbox` is `(minx, miny, maxx, maxy)` in scaled
+/// units; an empty payload gets `(0, 0, 0, 0)`.
+pub fn payload_census(polys: &[slicer_ir::ExPolygon]) -> (usize, usize, u64, (i64, i64, i64, i64)) {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut points = 0usize;
+    let mut bbox = (i64::MAX, i64::MAX, i64::MIN, i64::MIN);
+    let mut fold = |hash: &mut u64, value: i64| {
+        for byte in value.to_le_bytes() {
+            *hash ^= u64::from(byte);
+            *hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    };
+    for poly in polys {
+        for ring in std::iter::once(&poly.contour).chain(poly.holes.iter()) {
+            fold(&mut hash, -1);
+            for p in &ring.points {
+                fold(&mut hash, p.x);
+                fold(&mut hash, p.y);
+                bbox.0 = bbox.0.min(p.x);
+                bbox.1 = bbox.1.min(p.y);
+                bbox.2 = bbox.2.max(p.x);
+                bbox.3 = bbox.3.max(p.y);
+                points += 1;
+            }
+        }
+    }
+    if points == 0 {
+        bbox = (0, 0, 0, 0);
+    }
+    (polys.len(), points, hash, bbox)
+}
+
+/// One singular `offset_polygons` host-import call: content census plus wall.
+/// `hash`/`bbox` identify the payload so the reducer can count exact repeats
+/// (a memo ceiling). Printed only when the probe is enabled.
+pub fn emit_offset_call(
+    delta_mm: f32,
+    miter_limit: Option<f32>,
+    arc_tolerance_mm: f32,
+    polys: usize,
+    points: usize,
+    hash: u64,
+    bbox: (i64, i64, i64, i64),
+    call_ns: u64,
+) {
+    if !enabled() {
+        return;
+    }
+    eprintln!(
+        "t131-s6op delta_mm={:.6} miter={} arc={:.6} polys={} points={} hash={:016x} bbox={},{},{},{} call_ns={}",
+        delta_mm,
+        miter_limit.map_or_else(|| "none".to_string(), |v| format!("{v:.6}")),
+        arc_tolerance_mm,
+        polys,
+        points,
+        hash,
+        bbox.0,
+        bbox.1,
+        bbox.2,
+        bbox.3,
+        call_ns,
+    );
+}
