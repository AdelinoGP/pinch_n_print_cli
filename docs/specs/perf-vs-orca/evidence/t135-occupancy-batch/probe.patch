@@ -0,0 +1,53 @@
+//! TEMPORARY probe for wayfinder ticket 135 Stage 2 — cross-layer occupancy
+//! batch fan-out.
+//!
+//! Compiled into the host binary only and enabled at runtime by
+//! `PNP_T135_PROBE=1`; the wasm guest never sees it. The take reverts it before
+//! the campaign, so the evidence directory's `probe.patch` is the only artifact.
+//!
+//! One line is printed per `offset_polygons_batch` host call. `thread_ns` is the
+//! sum of the per-request durations (each request runs on one rayon worker);
+//! `wall_ns` is the duration of the whole call. Their ratio is the batch's own
+//! fan-out. The occupancy batch is identified by `miter_some=0` (the foreign
+//! keep-out and seam insets all pass `Some(3.0)`), `delta_mm > 0` and
+//! `requests >= 2`.
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use crate::batch::BatchMode;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+
+static THREAD_NS: AtomicU64 = AtomicU64::new(0);
+static ON: OnceLock<bool> = OnceLock::new();
+
+/// Whether the probe is enabled (`PNP_T135_PROBE`).
+pub fn enabled() -> bool {
+    *ON.get_or_init(|| std::env::var_os("PNP_T135_PROBE").is_some())
+}
+
+/// Add one request's duration to the current call's thread-time.
+pub fn add_thread_ns(ns: u64) {
+    if enabled() {
+        THREAD_NS.fetch_add(ns, Relaxed);
+    }
+}
+
+/// Print one completed batch call and reset the thread-time accumulator.
+pub fn emit_call(
+    requests: usize,
+    delta_mm: f32,
+    miter_some: bool,
+    mode: BatchMode,
+    total_vertices: u64,
+    wall_ns: u64,
+) {
+    if !enabled() {
+        return;
+    }
+    let thread_ns = THREAD_NS.swap(0, Relaxed);
+    eprintln!(
+        "t135-batch requests={requests} delta_mm={delta_mm:.6} miter_some={} mode={mode:?} total_vertices={total_vertices} wall_ns={wall_ns} thread_ns={thread_ns}",
+        u8::from(miter_some)
+    );
+}
