diff --git a/crates/slicer-wasm-host/src/t136_probe.rs b/crates/slicer-wasm-host/src/t136_probe.rs
new file mode 100644
index 00000000..0f1a227d
--- /dev/null
+++ b/crates/slicer-wasm-host/src/t136_probe.rs
@@ -0,0 +1,179 @@
+//! TEMPORARY probe for wayfinder ticket 136 — planner clip-batch fan-out.
+//!
+//! Compiled into the host binary only and enabled at runtime by
+//! `PNP_T136_PROBE=1`; the wasm guest never sees it. The take reverts it before
+//! close, so the evidence directory's `probe.patch` is the only artifact.
+//!
+//! # What it measures
+//!
+//! One `t136-batch` line per `clip_polygons_batch` host call and one
+//! `t136-segment` line per guest phase segment. The guest emits the segment
+//! boundaries (`T136PHASE:` / `T136WALL:`) and its own chunk timings
+//! (`T136CHUNK:`) through `host::log_warn`; this module echoes them
+//! synchronously, so the stderr stream is execution order and a segment's
+//! guest wall can be compared with the host calls issued inside it.
+//!
+//! Per call: `thread_ns` is the sum of the per-request closure durations (each
+//! runs on one rayon worker and includes both WIT conversions plus the clipper
+//! op), `max_ns` the longest single request, `ideal_ns` the call's own
+//! critical-path floor `max(thread/12, max)`.
+//!
+//! Per segment the same sums are accumulated, so the decomposition is exact at
+//! each level:
+//!
+//! ```text
+//! guest_wall_ns           guest-side span around the segment
+//!   - wall_sum_ns         host calls issued inside it
+//!   = guest_serial_ns     request building, marshalling, decode, assembly
+//! wall_sum_ns
+//!   - ideal_ns            critical-path floor of the chunking
+//!   = dispatch_excess_ns  rayon wake-up, imbalance, per-call floor
+//! ```
+//!
+//! `sdk_ns` on the chunk lines adds the third level: `sdk_ns - wall_sum_ns` is
+//! the wasm-side marshalling and result decoding around the host call.
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use crate::batch::BatchMode;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{Mutex, OnceLock};
+
+static ON: OnceLock<bool> = OnceLock::new();
+static THREADS: OnceLock<u64> = OnceLock::new();
+static CALL_SUM_NS: AtomicU64 = AtomicU64::new(0);
+static CALL_MAX_NS: AtomicU64 = AtomicU64::new(0);
+static CALL_VERTICES: AtomicU64 = AtomicU64::new(0);
+
+/// Whether the probe is enabled (`PNP_T136_PROBE`).
+pub fn enabled() -> bool {
+    *ON.get_or_init(|| std::env::var_os("PNP_T136_PROBE").is_some())
+}
+
+/// Fan-out width the floors are quoted against — the rayon pool size.
+fn threads() -> u64 {
+    *THREADS.get_or_init(|| {
+        std::env::var("RAYON_NUM_THREADS")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .filter(|n: &u64| *n > 0)
+            .unwrap_or(1)
+    })
+}
+
+#[derive(Default)]
+struct Segment {
+    name: String,
+    calls: u64,
+    requests: u64,
+    vertices: u64,
+    wall_ns: u64,
+    thread_ns: u64,
+    max_ns: u64,
+    ideal_ns: u64,
+}
+
+#[derive(Default)]
+struct State {
+    phase: String,
+    seq: u64,
+    segment: Segment,
+}
+
+static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+
+fn state() -> &'static Mutex<State> {
+    STATE.get_or_init(|| Mutex::new(State::default()))
+}
+
+/// Reset the per-call accumulators before `map_batch` fans out.
+pub fn begin_call() {
+    if !enabled() {
+        return;
+    }
+    CALL_SUM_NS.store(0, Relaxed);
+    CALL_MAX_NS.store(0, Relaxed);
+    CALL_VERTICES.store(0, Relaxed);
+}
+
+/// Record one completed request: its closure duration and its operand size.
+pub fn record_request(ns: u64, vertices: u64) {
+    if !enabled() {
+        return;
+    }
+    CALL_SUM_NS.fetch_add(ns, Relaxed);
+    CALL_MAX_NS.fetch_max(ns, Relaxed);
+    CALL_VERTICES.fetch_add(vertices, Relaxed);
+}
+
+/// Print one completed host call and fold it into the current segment.
+pub fn end_call(requests: usize, mode: BatchMode, wall_ns: u64) {
+    if !enabled() {
+        return;
+    }
+    let thread_ns = CALL_SUM_NS.swap(0, Relaxed);
+    let max_ns = CALL_MAX_NS.swap(0, Relaxed);
+    let vertices = CALL_VERTICES.swap(0, Relaxed);
+    let ideal_ns = (thread_ns / threads()).max(max_ns);
+    let mut st = state().lock().expect("t136 probe state poisoned");
+    st.seq += 1;
+    let seq = st.seq;
+    let phase = st.phase.clone();
+    eprintln!(
+        "t136-batch phase={phase} seq={seq} requests={requests} mode={mode:?} vertices={vertices} wall_ns={wall_ns} thread_ns={thread_ns} max_ns={max_ns} ideal_ns={ideal_ns}"
+    );
+    let seg = &mut st.segment;
+    seg.calls += 1;
+    seg.requests += requests as u64;
+    seg.vertices += vertices;
+    seg.wall_ns += wall_ns;
+    seg.thread_ns += thread_ns;
+    seg.max_ns = seg.max_ns.max(max_ns);
+    seg.ideal_ns += ideal_ns;
+}
+
+/// Start a new guest phase segment (`T136PHASE:<name>`).
+pub fn set_phase(name: &str) {
+    if !enabled() {
+        return;
+    }
+    let mut st = state().lock().expect("t136 probe state poisoned");
+    st.phase = name.to_string();
+    st.segment = Segment {
+        name: name.to_string(),
+        ..Segment::default()
+    };
+}
+
+/// Close the current segment with the guest's own wall and print it
+/// (`T136WALL:<name>:<ns>`).
+pub fn end_segment(name: &str, guest_wall_ns: u64) {
+    if !enabled() {
+        return;
+    }
+    let mut st = state().lock().expect("t136 probe state poisoned");
+    // The marker names the segment being closed; trust it over the state name
+    // so a missing `T136PHASE` cannot silently merge two segments.
+    st.segment.name = name.to_string();
+    let seg = std::mem::take(&mut st.segment);
+    eprintln!(
+        "t136-segment name={} calls={} requests={} vertices={} wall_sum_ns={} thread_ns={} max_ns={} ideal_ns={} guest_wall_ns={}",
+        seg.name,
+        seg.calls,
+        seg.requests,
+        seg.vertices,
+        seg.wall_ns,
+        seg.thread_ns,
+        seg.max_ns,
+        seg.ideal_ns,
+        guest_wall_ns
+    );
+}
+
+/// Echo a guest chunk timing (`T136CHUNK:<phase>:<idx>:<requests>:<sdk_ns>`).
+pub fn chunk(phase: &str, index: u64, requests: u64, sdk_ns: u64) {
+    if !enabled() {
+        return;
+    }
+    eprintln!("t136-chunk phase={phase} idx={index} requests={requests} sdk_ns={sdk_ns}");
+}
