 const EMIT_BATCH_LAYERS: usize = 4;
 
+// ---------------------------------------------------------------------------
+// [PERF-T136-PROBE] Temporary segment brackets for wayfinder ticket 136
+// (planner clip-batch fan-out). Probe-only: removed before close; grep
+// `PERF-T136-PROBE` for every site. The host echoes these markers
+// synchronously, so a segment's guest wall can be compared with the host calls
+// issued inside it.
+// ---------------------------------------------------------------------------
+thread_local! {
+    static T136_LAST: std::cell::Cell<Option<(&'static str, u64)>> =
+        const { std::cell::Cell::new(None) };
+    static T136_CURRENT: std::cell::Cell<&'static str> = const { std::cell::Cell::new("none") };
+}
+
+/// Close the open segment and open `name`.
+fn t136_mark(name: &'static str) {
+    let now = host::now_us();
+    if let Some((prev, start)) = T136_LAST.with(std::cell::Cell::get) {
+        host::log_warn(&format!(
+            "T136WALL:{prev}:{}",
+            now.saturating_sub(start) * 1_000
+        ));
+    }
+    T136_LAST.with(|cell| cell.set(Some((name, now))));
+    T136_CURRENT.with(|cell| cell.set(name));
+    host::log_warn(&format!("T136PHASE:{name}"));
+}
+
+/// Close the last open segment.
+fn t136_end() {
+    let now = host::now_us();
+    if let Some((prev, start)) = T136_LAST.with(std::cell::Cell::get) {
+        host::log_warn(&format!(
+            "T136WALL:{prev}:{}",
+            now.saturating_sub(start) * 1_000
+        ));
+    }
+    T136_LAST.with(|cell| cell.set(None));
+    T136_CURRENT.with(|cell| cell.set("none"));
+    host::log_warn("T136PHASE:end");
+}
