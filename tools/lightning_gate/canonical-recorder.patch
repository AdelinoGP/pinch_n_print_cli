+template <typename Domain>
+const Domain &lookup_domains(const std::vector<std::map<const LayerRegion *, Domain>> &domains,
+                             size_t                                                       layer_index,
+                             const LayerRegion                                           *region)
+{
+    static const Domain empty;
+    if (layer_index >= domains.size())
+        return empty;
+    const auto it = domains[layer_index].find(region);
+    return it == domains[layer_index].end() ? empty : it->second;
+}
