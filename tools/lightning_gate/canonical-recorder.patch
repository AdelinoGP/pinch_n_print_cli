+void record_grounding(const Point &unsupported,
+                      const Point &boundary_point,
+                      const Point &edge_from,
+                      const Point &edge_to,
+                      const NodeSPtr &tree_node,
+                      coord_t weighted_distance,
+                      bool boundary_winner,
+                      const char *site,
+                      bool has_boundary_candidate)
+{
+    if (!enabled() || !t_grounding_context.active)
+        return;
+
+    nlohmann::json j = context_prefix("grounding", site);
+    j["unsupported_mm"] = point_mm_json(unsupported);
+    if (has_boundary_candidate) {
+        j["boundary_point_mm"] = point_mm_json(boundary_point);
+        j["edge_from_mm"]      = point_mm_json(edge_from);
+        j["edge_to_mm"]        = point_mm_json(edge_to);
+    } else {
+        j["boundary_point_mm"] = nullptr;
+        j["edge_from_mm"]      = nullptr;
+        j["edge_to_mm"]        = nullptr;
+    }
+    j["boundary_winner"]  = boundary_winner;
+    j["weighted_distance"] = weighted_distance;
+    j["tree_node_ptr"]    = node_ptr(tree_node);
+
+    append_jsonl(output_dir() + "/" + case_name() + ".object_" +
+                     std::to_string(t_grounding_context.value.object_id) + ".grounding.jsonl",
+                 j);
+}
+
+void record_attachment(const Point &unsupported,
+                       const NodeSPtr &parent,
+                       const NodeSPtr &child,
+                       bool new_root,
+                       const char *site)
+{
+    if (!enabled() || !t_grounding_context.active)
+        return;
+
+    nlohmann::json j = context_prefix("attachment", site);
+    j["unsupported_mm"] = point_mm_json(unsupported);
+    j["parent_ptr"]      = node_ptr(parent);
+    j["child_ptr"]       = node_ptr(child);
+    j["new_root"]        = new_root;
+    j["parent_point_mm"] = parent ? point_mm_json(parent->getLocation()) : nlohmann::json(nullptr);
+    j["child_point_mm"]  = child ? point_mm_json(child->getLocation()) : nlohmann::json(nullptr);
+
+    append_jsonl(output_dir() + "/" + case_name() + ".object_" +
+                     std::to_string(t_grounding_context.value.object_id) + ".grounding.jsonl",
+                 j);
+}
+
+void capture_source(const PrintObject &print_object, const char *phase)
+{
+    if (!enabled())
+        return;
+
+    nlohmann::json j;
+    j["schema_version"] = 1;
+    j["case_id"]        = case_name();
+    j["phase"]          = phase;
+    j["object_id"]      = print_object.get_id();
+    j["object_name"]    = model_object_name(print_object);
+    j["object_config"]  = config_json(print_object.config(),
+        {"layer_height", "line_width", "nozzle_diameter"});
+    j["print_config"]   = config_json(print_object.print()->config(), {"nozzle_diameter"});
+    std::vector<std::pair<const Surface *, SourceSurfaceRef>> catalog;
+    j["regions"]        = source_regions_json(print_object, catalog);
+    register_source_catalog(print_object.get_id(), catalog);
+    write_json(output_dir() + "/" + case_name() + "." + object_tag(print_object) + ".source.json", j);
+}
