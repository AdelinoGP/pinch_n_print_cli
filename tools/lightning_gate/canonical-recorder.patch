+nlohmann::json region_surfaces_json(const Slic3r::LayerRegion &region)
+{
+    nlohmann::json surfaces = nlohmann::json::array();
+    for (const Surface &surface : region.fill_surfaces.surfaces) {
+        nlohmann::json s;
+        s["surface_type"] = surface_type_name(surface.surface_type);
+        s["expolygon"]    = expolygon_json(surface.expolygon);
