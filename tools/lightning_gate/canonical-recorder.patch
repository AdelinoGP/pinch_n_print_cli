+namespace {
+
+// Areas are computed in canonical scaled units²; report them in mm² like every other recorded
+// spatial value.
+double unscale_area(double scaled_area)
+{
+    return scaled_area * SCALING_FACTOR * SCALING_FACTOR;
+}
+
+nlohmann::json snapshot_layers_json(const LightningPlannerSnapshot &snapshot)
+{
+    nlohmann::json layers = nlohmann::json::array();
+    for (const FixtureLayerDomains &layer : snapshot.layers) {
+        nlohmann::json l;
+        l["local_layer_index"]  = layer.local_layer_index;
+        l["global_layer_index"] = layer.global_layer_index;
+        l["z_mm"]               = layer.z_mm;
+        l["height_mm"]          = layer.height_mm;
+        nlohmann::json regions = nlohmann::json::array();
+        for (const FixtureRegionDomains &region : layer.regions) {
+            nlohmann::json r;
+            r["region_id"] = region.region_id;
+            r["internal"]  = expolygons_json(region.internal);
+            r["voids"]     = expolygons_json(region.voids);
+            regions.push_back(std::move(r));
+        }
+        l["regions"] = std::move(regions);
+        layers.push_back(std::move(l));
+    }
+    return layers;
+}
+
+// Canonical, key-sorted dump of the whole snapshot. Both the fingerprint and the mutation check
+// are computed from exactly this serialization, so they cannot disagree about what the snapshot
+// contained.
+nlohmann::json snapshot_json(const LightningPlannerSnapshot &snapshot)
+{
+    nlohmann::json j;
+    j["object_name"] = snapshot.object_name;
+    j["object_id"]   = snapshot.object_id;
+    j["seed_policy"] = snapshot.seed_policy;
+    j["layers"]      = snapshot_layers_json(snapshot);
+
+    nlohmann::json faithful = nlohmann::json::array();
+    for (const Polygons &layer : snapshot.faithful_infill_outlines)
+        faithful.push_back(polygons_json(layer));
+    j["faithful_infill_outlines"] = std::move(faithful);
+
+    nlohmann::json final_outlines = nlohmann::json::array();
+    for (const Polygons &layer : snapshot.final_infill_outlines)
+        final_outlines.push_back(polygons_json(layer));
+    j["final_infill_outlines"] = std::move(final_outlines);
+
+    LightningScalars scalars;
+    scalars.infill_extrusion_width     = float(snapshot.infill_extrusion_width);
+    scalars.supporting_radius          = snapshot.supporting_radius;
+    scalars.wall_supporting_radius     = snapshot.wall_supporting_radius;
+    scalars.prune_length               = snapshot.prune_length;
+    scalars.straightening_max_distance = snapshot.straightening_max_distance;
+    j["scalars_resolved"] = snapshot.scalars_resolved;
+    j["scalars"]          = scalars_json(scalars);
+    if (snapshot.scalars_resolved)
+        j["resolved_inputs"] = resolved_inputs_json(snapshot.resolved_inputs);
+    return j;
+}
+
+// FNV-1a 64 bit over the canonical JSON dump. A fingerprint is a change detector, not a claim of
+// cryptographic collision resistance.
+std::string snapshot_fingerprint(const LightningPlannerSnapshot &snapshot)
+{
+    const std::string dump = snapshot_json(snapshot).dump();
+    uint64_t          hash = 1469598103934665603ull;
+    for (unsigned char c : dump) {
+        hash ^= static_cast<uint64_t>(c);
+        hash *= 1099511628211ull;
+    }
+    char buffer[17];
+    std::snprintf(buffer, sizeof(buffer), "%016llx", static_cast<unsigned long long>(hash));
+    return std::string(buffer);
+}
+
+size_t polygon_count(const std::vector<Polygons> &outlines)
+{
+    size_t count = 0;
+    for (const Polygons &layer : outlines)
+        count += layer.size();
+    return count;
+}
+
+nlohmann::json generator_graph_json(const Generator &generator, bool include_ptr)
+{
+    std::vector<Layer> layers;
+    layers.reserve(generator.layerCount());
+    for (size_t layer_id = 0; layer_id < generator.layerCount(); ++layer_id)
+        layers.push_back(generator.getTreesForLayer(layer_id));
+    return graph_json(layers, include_ptr);
+}
+
+struct GraphCounts
+{
+    size_t node_count { 0 };
+    size_t edge_count { 0 };
+    size_t root_count { 0 };
+};
+
+GraphCounts graph_counts(const nlohmann::json &graph)
+{
+    GraphCounts counts;
+    if (!graph.is_array())
+        return counts;
+    for (const nlohmann::json &layer : graph) {
+        if (!layer.contains("nodes") || !layer.contains("edges") || !layer.contains("root_count"))
+            continue;
+        counts.node_count += layer["nodes"].size();
+        counts.edge_count += layer["edges"].size();
+        counts.root_count += layer["root_count"].get<size_t>();
+    }
+    return counts;
+}
+
+nlohmann::json graph_entry(const nlohmann::json &graph)
+{
+    const GraphCounts counts = graph_counts(graph);
+    nlohmann::json    entry;
+    entry["node_count"] = counts.node_count;
+    entry["edge_count"] = counts.edge_count;
+    entry["root_count"] = counts.root_count;
+    entry["graph"]      = graph;
+    return entry;
+}
+
+// Bounded diagnostic for a faithful/production mismatch: the first differing layer plus at most one
+// differing node and one differing edge. Never a full diff.
+nlohmann::json first_graph_mismatch(const nlohmann::json &production, const nlohmann::json &faithful)
+{
+    nlohmann::json summary;
+    summary["production_layer_count"] = production.is_array() ? production.size() : 0;
+    summary["faithful_layer_count"]   = faithful.is_array() ? faithful.size() : 0;
+
+    const size_t layer_count = production.is_array() && faithful.is_array()
+        ? std::min(production.size(), faithful.size()) : 0;
+    size_t first_layer = 0;
+    bool   found       = false;
+    for (size_t layer_index = 0; layer_index < layer_count; ++layer_index) {
+        if (production[layer_index] != faithful[layer_index]) {
+            first_layer = layer_index;
+            found       = true;
+            break;
+        }
+    }
+    if (!found && summary["production_layer_count"] != summary["faithful_layer_count"]) {
+        first_layer = layer_count;
+        found       = true;
+    }
+    if (!found)
+        return summary;
+
+    summary["first_differing_layer"] = first_layer;
+    if (first_layer < layer_count) {
+        const nlohmann::json &p = production[first_layer];
+        const nlohmann::json &f = faithful[first_layer];
+        summary["production_root_count"] = p.value("root_count", 0);
+        summary["faithful_root_count"]   = f.value("root_count", 0);
+
+        const auto first_difference = [](const nlohmann::json &a, const nlohmann::json &b, const char *key) -> nlohmann::json {
+            if (!a.contains(key) && !b.contains(key))
+                return nullptr;
+            const nlohmann::json &av = a.contains(key) ? a[key] : nlohmann::json::array();
+            const nlohmann::json &bv = b.contains(key) ? b[key] : nlohmann::json::array();
+            const size_t count = std::min(av.size(), bv.size());
+            for (size_t i = 0; i < count; ++i) {
+                if (av[i] != bv[i]) {
+                    nlohmann::json d;
+                    d["index"]      = i;
+                    d["production"] = av[i];
+                    d["faithful"]   = bv[i];
+                    return d;
+                }
+            }
+            if (av.size() != bv.size()) {
+                nlohmann::json d;
+                d["index"]      = count;
+                d["production"] = count < av.size() ? av[count] : nlohmann::json();
+                d["faithful"]   = count < bv.size() ? bv[count] : nlohmann::json();
+                return d;
+            }
+            return nullptr;
+        };
+        if (nlohmann::json node = first_difference(p, f, "nodes"); !node.is_null())
+            summary["first_differing_node"] = std::move(node);
+        if (nlohmann::json edge = first_difference(p, f, "edges"); !edge.is_null())
+            summary["first_differing_edge"] = std::move(edge);
+    }
+    return summary;
+}
