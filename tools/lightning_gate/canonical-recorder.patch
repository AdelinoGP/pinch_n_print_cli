+LightningPlannerFixtureResult run_lightning_planner_fixture(const LightningPlannerSnapshot &snapshot, FixtureDomainSelector selector)
+{
+    const std::vector<Polygons> &selected = selector == FixtureDomainSelector::faithful_planning
+        ? snapshot.faithful_infill_outlines
+        : snapshot.final_infill_outlines;
+    const std::vector<Polygons> &other = selector == FixtureDomainSelector::faithful_planning
+        ? snapshot.final_infill_outlines
+        : snapshot.faithful_infill_outlines;
+
+    // No-op cancel callback: replay is a deterministic, single-threaded planning pass.
+    Generator generator(snapshot, selected, []() {});
+
+    LightningPlannerFixtureResult result;
+    result.object_name        = snapshot.object_name;
+    result.seed_policy        = snapshot.seed_policy;
+    result.layers             = generator.m_lightning_layers;
+    result.overhang_per_layer = generator.m_overhang_per_layer;
+    result.bboxs              = generator.bboxs;
+
+    // Measure the candidate outline sets per layer. Flattening all layers into one union would
+    // compare unrelated layer footprints and can collapse a real per-layer difference to zero.
+    Polygons empty_layer;
+    double   symmetric_difference_area = 0.0;
+    const size_t layer_count = std::max(selected.size(), other.size());
+    for (size_t layer_index = 0; layer_index < layer_count; ++layer_index) {
+        const Polygons &selected_layer = layer_index < selected.size() ? selected[layer_index] : empty_layer;
+        const Polygons &other_layer    = layer_index < other.size() ? other[layer_index] : empty_layer;
+        const ExPolygons selected_union = union_ex(selected_layer);
+        const ExPolygons other_union    = union_ex(other_layer);
+        symmetric_difference_area +=
+            area(to_polygons(diff_ex(selected_union, other_union))) +
+            area(to_polygons(diff_ex(other_union, selected_union)));
+    }
+    result.domain_symmetric_difference_area = symmetric_difference_area;
+
+    return result;
+}
