+
+nlohmann::json regions_json(const PrintObject &print_object)
+{
+    nlohmann::json out = nlohmann::json::array();
+    for (int layer_index = 0; layer_index < int(print_object.layers().size()); ++layer_index) {
+        const Slic3r::Layer *layer = print_object.get_layer(layer_index);
+        for (const LayerRegion *region : layer->regions()) {
+            nlohmann::json r;
+            r["region_id"]    = region->region().print_object_region_id();
+            // Layer::print_z and Layer::height are already millimetres (coordf_t), not scaled units.
+            r["z_mm"]         = layer->print_z;
+            r["height_mm"]    = layer->height;
+            r["surfaces"]     = region_surfaces_json(*region);
+            r["region_config"] = region_config_json(region->region().config());
+            out.push_back(std::move(r));
+        }
+    }
+    return out;
+}
+
+// source.json variant of regions_json: every surface additionally carries its stable pre-anchor
+// source identity and checkpoint identity. The catalog records the Surface addresses so Phase 2
+// can resolve its candidate/operand surfaces back to those ids.
+nlohmann::json source_regions_json(const PrintObject &print_object,
+                                   std::vector<std::pair<const Surface *, SourceSurfaceRef>> &catalog)
+{
+    nlohmann::json out = nlohmann::json::array();
+    for (int layer_index = 0; layer_index < int(print_object.layers().size()); ++layer_index) {
+        const Slic3r::Layer *layer = print_object.get_layer(layer_index);
+        for (const LayerRegion *region : layer->regions()) {
+            const int region_id = region->region().print_object_region_id();
+            nlohmann::json r;
+            r["region_id"] = region_id;
+            // Layer::print_z and Layer::height are already millimetres (coordf_t), not scaled units.
+            r["z_mm"]      = layer->print_z;
+            r["height_mm"] = layer->height;
+            nlohmann::json surfaces = nlohmann::json::array();
+            const Surfaces &region_surfaces = region->fill_surfaces.surfaces;
+            for (size_t surface_index = 0; surface_index < region_surfaces.size(); ++surface_index) {
+                const Surface &surface = region_surfaces[surface_index];
+                SourceSurfaceRef entry;
+                entry.object_id          = print_object.get_id();
+                entry.source_id          = "o" + std::to_string(entry.object_id) +
+                                           "_l" + std::to_string(layer->id()) +
+                                           "_r" + std::to_string(region_id) +
+                                           "_s" + std::to_string(surface_index);
+                entry.local_layer_index  = layer_index;
+                entry.global_layer_index = layer->id();
+                entry.region_id          = region_id;
+                entry.surface_index      = surface_index;
+                catalog.emplace_back(&surface, entry);
+
+                nlohmann::json s;
+                s["surface_type"]       = surface_type_name(surface.surface_type);
+                s["expolygon"]          = expolygon_json(surface.expolygon);
+                s["source_id"]          = entry.source_id;
+                s["region_id"]          = region_id;
+                s["local_layer_index"]  = layer_index;
+                s["global_layer_index"] = layer->id();
+                s["z_mm"]               = layer->print_z;
+                s["height_mm"]          = layer->height;
+                s["checkpoint"]         = "before_anchor_edit";
+                surfaces.push_back(std::move(s));
+            }
+            r["surfaces"]      = std::move(surfaces);
+            r["region_config"] = region_config_json(region->region().config());
+            out.push_back(std::move(r));
+        }
+    }
+    return out;
+}
+
+nlohmann::json graph_json(const std::vector<Layer> &layers, bool include_ptr = true)
+{
+    nlohmann::json out = nlohmann::json::array();
+    for (size_t layer_index = 0; layer_index < layers.size(); ++layer_index) {
+        std::unordered_map<const Node *, int> ids;
+        int next_id = 0;
+        for (const NodeSPtr &root : layers[layer_index].tree_roots)
+            root->visitNodes([&ids, &next_id](NodeSPtr node) { ids.emplace(node.get(), next_id++); });
+
+        nlohmann::json nodes = nlohmann::json::array();
+        nlohmann::json edges = nlohmann::json::array();
+        for (const NodeSPtr &root : layers[layer_index].tree_roots) {
+            root->visitNodes([&ids, &nodes, &edges, include_ptr](NodeSPtr node) {
+                const auto self_it = ids.find(node.get());
+                if (self_it == ids.end())
+                    return;
+                const int node_id = self_it->second;
+                const NodeSPtr parent = node->getParent();
+                int parent_id = -1;
+                int root_id   = node_id;
+                if (parent) {
+                    const auto parent_it = ids.find(parent.get());
+                    if (parent_it != ids.end())
+                        parent_id = parent_it->second;
+                    const Node *top = parent.get();
+                    NodeSPtr top_parent = parent->getParent();
+                    while (top_parent) {
+                        top = top_parent.get();
+                        top_parent = top_parent->getParent();
+                    }
+                    const auto root_it = ids.find(top);
+                    if (root_it != ids.end())
+                        root_id = root_it->second;
+                }
+                nlohmann::json n;
+                n["node_id"]    = node_id;
+                n["point"]      = point_json(node->getLocation());
+                n["point_mm"]   = point_mm_json(node->getLocation());
+                n["parent_id"]  = parent_id;
+                n["root_id"]    = root_id;
+                n["is_root"]    = node->isRoot();
+                if (include_ptr)
+                    n["ptr"] = static_cast<uint64_t>(reinterpret_cast<std::uintptr_t>(node.get()));
+                if (const std::optional<Point> &grounding = node->getLastGroundingLocation())
+                    n["last_grounding"] = point_json(*grounding);
+                else
+                    n["last_grounding"] = nullptr;
+                nodes.push_back(std::move(n));
+                if (parent_id >= 0) {
+                    nlohmann::json e;
+                    e["parent_id"] = parent_id;
+                    e["child_id"]  = node_id;
+                    e["root_id"]   = root_id;
+                    edges.push_back(std::move(e));
+                }
+            });
+        }
+
+        nlohmann::json g;
+        g["layer_index"] = layer_index;
+        g["nodes"]       = std::move(nodes);
+        g["edges"]       = std::move(edges);
+        g["root_count"]  = layers[layer_index].tree_roots.size();
+        out.push_back(std::move(g));
+    }
+    return out;
+}
+
+void write_json(const std::string &path, const nlohmann::json &value)
+{
+    const std::string tmp = path + ".tmp";
+    {
+        std::ofstream stream(tmp, std::ios::binary | std::ios::trunc);
+        if (!stream)
+            return;
+        stream << value.dump(2);
+    }
+    std::remove(path.c_str());
+    std::rename(tmp.c_str(), path.c_str());
+}
+
+// Append exactly one complete JSON object plus newline. The mutex serializes the whole write so TBB
+// workers can never interleave partial lines in the same file.
+void append_jsonl(const std::string &path, const nlohmann::json &value)
+{
+    const std::string line = value.dump();
+    static std::mutex s_mutex;
+    std::lock_guard<std::mutex> lock(s_mutex);
+    std::ofstream stream(path, std::ios::binary | std::ios::app);
+    if (!stream)
+        return;
+    stream << line << '\n';
+}
