+// The caller probe is per-thread: fill dispatch is called from TBB workers and no mutable JSON or
+// identity state may be shared between them. Nested contexts restore the previous value.
+thread_local ProbeFillContext *t_current_fill_context = nullptr;
+
+// Grounding witnesses are also per-thread. Production planning sets this around one layer's
+// generateNewTrees/reconnectRoots pair; snapshot replay never does, so the writers no-op there.
+struct ThreadGroundingContext
+{
+    bool             active { false };
+    GroundingContext value;
+};
+thread_local ThreadGroundingContext t_grounding_context;
+
+// Pre-anchor surface catalog filled by capture_source and read by the Phase-2 workers. Keying on
+// the Surface address is sound because Phase 2's backup-by-move preserves the vector buffer those
+// addresses point into, and candidates keep pointing at the original surfaces.
+std::mutex t_source_catalog_mutex;
+std::unordered_map<const Surface *, SourceSurfaceRef> t_source_catalog;
+
+void register_source_catalog(int object_id,
+                             const std::vector<std::pair<const Surface *, SourceSurfaceRef>> &entries)
+{
+    std::lock_guard<std::mutex> lock(t_source_catalog_mutex);
+    // Replace this object's previous catalog so a re-slice cannot resolve recycled addresses to
+    // stale identities. Catalogs of other live objects are left untouched.
+    for (auto it = t_source_catalog.begin(); it != t_source_catalog.end();) {
+        if (it->second.object_id == object_id)
+            it = t_source_catalog.erase(it);
+        else
+            ++it;
+    }
+    for (const auto &entry : entries)
+        t_source_catalog[entry.first] = entry.second;
+}
