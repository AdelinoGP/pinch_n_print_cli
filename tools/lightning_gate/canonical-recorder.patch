+const std::string &case_name_ref()
+{
+    // Function-local static initialization is thread-safe; the environment is fixed for the process.
+    static const std::string cached = []() {
+        const char *env = std::getenv("LIGHTNING_GATE_CASE");
+        const std::string raw = env == nullptr ? std::string("case") : std::string(env);
+        std::string safe;
+        for (char c : raw)
+            safe.push_back((std::isalnum(static_cast<unsigned char>(c)) != 0) ? c : '_');
+        return safe;
+    }();
+    return cached;
