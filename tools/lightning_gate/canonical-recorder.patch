+} // namespace
+
+LightningPlannerSnapshot make_planner_snapshot(
+    const PrintObject &print_object,
+    const std::vector<std::map<const LayerRegion *, SurfaceCollection>> &final_surfaces)
+{
+    LightningPlannerSnapshot snapshot;
+    snapshot.object_name = model_object_name(print_object);
+    snapshot.object_id   = print_object.get_id();
+    snapshot.seed_policy = "root_point_hash";
+
+    LightningScalars scalars;
+    snapshot.scalars_resolved = resolve_lightning_scalars(print_object, scalars, snapshot.resolved_inputs);
+    if (snapshot.scalars_resolved) {
+        snapshot.infill_extrusion_width     = scalars.infill_extrusion_width;
+        snapshot.supporting_radius          = scalars.supporting_radius;
+        snapshot.wall_supporting_radius     = scalars.wall_supporting_radius;
+        snapshot.prune_length               = scalars.prune_length;
+        snapshot.straightening_max_distance = scalars.straightening_max_distance;
+    }
+
+    const size_t layer_count = print_object.layers().size();
+    snapshot.layers.resize(layer_count);
+    snapshot.faithful_infill_outlines.resize(layer_count);
+    snapshot.final_infill_outlines.resize(layer_count);
+
+    // Same order as collectInternalDomains: top-to-bottom layers, then Layer::regions() order, then
+    // fill_surfaces.surfaces order. The append of to_polygons(surface.expolygon) is byte-identical.
+    for (int layer_id = int(layer_count) - 1; layer_id >= 0; --layer_id) {
+        const Slic3r::Layer *layer = print_object.get_layer(layer_id);
+        FixtureLayerDomains &snapshot_layer = snapshot.layers[layer_id];
+        snapshot_layer.local_layer_index  = uint32_t(layer_id);
+        snapshot_layer.global_layer_index = uint32_t(layer->id());
+        snapshot_layer.z_mm               = layer->print_z;
+        snapshot_layer.height_mm          = layer->height;
+
+        for (const LayerRegion *region : layer->regions()) {
+            FixtureRegionDomains domains;
+            domains.region_id = region->region().print_object_region_id();
+            for (const Surface &surface : region->fill_surfaces.surfaces) {
+                if (!is_planning_surface(surface))
+                    continue;
+                if (surface.surface_type == stInternal)
+                    domains.internal.push_back(surface.expolygon);
+                else
+                    domains.voids.push_back(surface.expolygon);
+                append(snapshot.faithful_infill_outlines[layer_id], to_polygons(surface.expolygon));
+            }
+
+            const SurfaceCollection &final_surface_set = lookup_domains(final_surfaces, size_t(layer_id), region);
+            for (const Surface &surface : final_surface_set.surfaces)
+                if (is_planning_surface(surface))
+                    append(snapshot.final_infill_outlines[layer_id], to_polygons(surface.expolygon));
+
+            snapshot_layer.regions.push_back(std::move(domains));
+        }
+    }
+    return snapshot;
+}
+
+void record_replay(const PrintObject &print_object,
+                   const LightningPlannerSnapshot &snapshot,
+                   const Generator *production_generator)
+{
+    if (!enabled())
+        return;
+
+    const std::string snapshot_before = snapshot_fingerprint(snapshot);
+
+    const LightningPlannerFixtureResult faithful =
+        run_lightning_planner_fixture(snapshot, FixtureDomainSelector::faithful_planning);
+    const LightningPlannerFixtureResult wrong =
+        run_lightning_planner_fixture(snapshot, FixtureDomainSelector::final_domain_only);
+
+    // Fixture replay is const-only; this is the explicit proof that both selectors left the shared
+    // snapshot untouched.
+    const std::string snapshot_after = snapshot_fingerprint(snapshot);
+
+    const nlohmann::json production_graph = production_generator == nullptr
+        ? nlohmann::json::array()
+        : generator_graph_json(*production_generator, false);
+    const nlohmann::json faithful_graph = graph_json(faithful.layers, false);
+    const nlohmann::json wrong_graph     = graph_json(wrong.layers, false);
+
+    const bool faithful_matches_production = production_graph == faithful_graph;
+
+    nlohmann::json j;
+    j["schema_version"]                  = 1;
+    j["case_id"]                        = case_name();
+    j["object_name"]                    = snapshot.object_name;
+    j["object_id"]                      = snapshot.object_id;
+    j["seed_policy"]                    = snapshot.seed_policy;
+    j["snapshot_before"]                = snapshot_before;
+    j["snapshot_after"]                 = snapshot_after;
+    j["snapshot_unchanged"]             = snapshot_before == snapshot_after;
+    j["faithful_matches_production"]    = faithful_matches_production;
+    j["scalars_resolved"]               = snapshot.scalars_resolved;
+    j["domain_symmetric_difference_area"] = unscale_area(faithful.domain_symmetric_difference_area);
+    j["topology_differs"]               = faithful_graph != wrong_graph;
+    j["faithful_domain_polygon_count"]  = polygon_count(snapshot.faithful_infill_outlines);
+    j["wrong_domain_polygon_count"]     = polygon_count(snapshot.final_infill_outlines);
+    j["wrong_nonempty"]                 = polygon_count(snapshot.final_infill_outlines) > 0;
+    j["production"]                     = graph_entry(production_graph);
+    j["faithful"]                       = graph_entry(faithful_graph);
+    j["wrong"]                          = graph_entry(wrong_graph);
+    if (!faithful_matches_production)
+        j["mismatch"] = first_graph_mismatch(production_graph, faithful_graph);
+
+    write_json(output_dir() + "/" + case_name() + "." + object_tag(print_object) + ".replay.json", j);
+}
+
+ProbeFillContext::ProbeFillContext(FillCallInfo info, const ConfigBase &region_config)
+    : m_info(std::move(info))
+    , m_region_config_json(region_config_json(region_config).dump())
+    , m_dispatch_token(make_dispatch_token(m_info))
+    , m_previous(t_current_fill_context)
+{
+    t_current_fill_context = this;
+}
+
+ProbeFillContext::~ProbeFillContext()
+{
+    if (t_current_fill_context == this)
+        t_current_fill_context = m_previous;
+
+    if (!enabled())
+        return;
+
+    nlohmann::json j;
+    j["dispatch_token"]        = m_dispatch_token;
+    j["object_id"]             = m_info.object_id;
+    j["local_layer_index"]     = m_info.local_layer_index;
+    j["global_layer_index"]    = m_info.global_layer_index;
+    j["z_mm"]                  = m_info.z_mm;
+    j["region_id"]             = m_info.region_id;
+    j["region_id_group"]       = m_info.region_id_group;
+    j["surface_type"]          = surface_type_name(static_cast<SurfaceType>(m_info.surface_type));
+    j["surface_type_id"]       = m_info.surface_type;
+    j["pattern"]               = infill_pattern_name(m_info.pattern);
+    j["pattern_id"]            = m_info.pattern;
+    j["extrusion_role"]        = extrusion_role_name(m_info.extrusion_role);
+    j["extrusion_role_id"]     = m_info.extrusion_role;
+    j["angle_deg"]             = m_info.angle_rad * 180.0 / M_PI;
+    j["angle_rad"]             = m_info.angle_rad;
+    j["fixed_angle"]           = m_info.fixed_angle;
+    j["density_percent"]       = m_info.density_percent;
+    j["spacing_mm"]            = m_info.spacing_mm;
+    j["caller_expolygon"]      = expolygon_json(m_info.caller_expolygon);
+    nlohmann::json source_ids  = nlohmann::json::array();
+    for (const std::string &id : m_info.source_ids)
+        source_ids.push_back(id.empty() ? nlohmann::json(nullptr) : nlohmann::json(id));
+    j["source_ids"]            = std::move(source_ids);
+    j["region_config"]         = nlohmann::json::parse(m_region_config_json);
+
+    append_jsonl(output_dir() + "/" + case_name() + "." +
+                     "object_" + std::to_string(m_info.object_id) + ".callers.jsonl",
+                 j);
+}
+
+ProbeFillContext *current_fill_context()
+{
+    return t_current_fill_context;
+}
+
+void record_lightning_clip(const LightningClipRecord &record)
+{
+    if (!enabled())
+        return;
+
+    ProbeFillContext *context = current_fill_context();
+    nlohmann::json    j;
+    if (context != nullptr) {
+        j["dispatch_token"]        = context->dispatch_token();
+        j["caller_dispatch_token"] = context->dispatch_token();
+        j["callee_call_index"]     = context->next_callee_call_index();
+        j["object_id"]             = context->object_id();
+    } else {
+        // No caller probe was installed: keep the observation, but never invent identity.
+        j["dispatch_token"]        = nullptr;
+        j["caller_dispatch_token"] = nullptr;
+        j["callee_call_index"]     = nullptr;
+        j["object_id"]             = nullptr;
+    }
+    j["callee_expolygon"]       = expolygon_json(record.callee_expolygon);
+    j["pre_clip_polylines"]     = polylines_json(record.pre_clip_polylines);
+    j["clipped_polylines"]      = polylines_json(record.clipped_polylines);
+    j["appended_output_range"]  = nlohmann::json::array({record.appended_start, record.appended_end});
+    j["thickness_layers"]       = record.thickness_layers;
+    j["spacing_mm"]             = record.spacing_mm;
+    j["pattern"]                = "lightning";
+
+    const std::string object_name = context != nullptr ? std::to_string(context->object_id()) : std::string("unknown");
+    append_jsonl(output_dir() + "/" + case_name() + ".object_" + object_name + ".clips.jsonl", j);
+}
+
