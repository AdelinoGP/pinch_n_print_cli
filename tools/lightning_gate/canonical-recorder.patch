+std::string source_id_for(const Surface *surface)
+{
+    if (surface == nullptr)
+        return {};
+    std::lock_guard<std::mutex> lock(t_source_catalog_mutex);
+    const auto it = t_source_catalog.find(surface);
+    return it == t_source_catalog.end() ? std::string() : it->second.source_id;
+}
+
+std::string source_id_for(const Surface *surface, int object_id)
+{
+    if (surface == nullptr)
+        return {};
+    std::lock_guard<std::mutex> lock(t_source_catalog_mutex);
+    const auto it = t_source_catalog.find(surface);
+    return it == t_source_catalog.end() || it->second.object_id != object_id
+        ? std::string() : it->second.source_id;
+}
+
+std::vector<std::string> source_ids_for(const std::vector<const Surface *> &surfaces, int object_id)
+{
+    std::vector<std::string> ids;
+    ids.reserve(surfaces.size());
+    std::lock_guard<std::mutex> lock(t_source_catalog_mutex);
+    for (const Surface *surface : surfaces) {
+        const auto it = surface == nullptr ? t_source_catalog.end() : t_source_catalog.find(surface);
+        ids.push_back(it == t_source_catalog.end() || it->second.object_id != object_id
+            ? std::string() : it->second.source_id);
+    }
+    return ids;
+}
+
+// group_fills runs on a TBB worker and its dispatch loop runs on the same worker immediately
+// afterwards, so the per-layer group registry stays thread-local and needs no lock.
+namespace {
+thread_local std::map<std::pair<int, size_t>, std::vector<std::string>> t_group_sources;
+}
+
+void reset_group_sources(int layer_id)
+{
+    t_group_sources.clear();
+    (void)layer_id;
+}
+
+// Address-keyed lookup is not sufficient at group_fills time: the layer's fill_surfaces vector can
+// be reallocated between the source snapshot and the dispatch pass, so the same occurrence appears
+// at a different address. The recorder already assigns source ids by the occurrence's stable
+// (object, global layer, region, surface index) identity; resolve that instead of guessing.
+std::string source_id_at(int object_id, int global_layer_index, size_t region_id, size_t surface_index)
+{
+    std::lock_guard<std::mutex> lock(t_source_catalog_mutex);
+    for (const auto &entry : t_source_catalog) {
+        const SourceSurfaceRef &ref = entry.second;
+        if (ref.object_id == object_id && ref.global_layer_index == global_layer_index &&
+            ref.region_id == int(region_id) && ref.surface_index == surface_index)
+            return ref.source_id;
+    }
+    return {};
+}
+
+void note_group_source(int layer_id, size_t group_index, int global_layer_index, size_t region_id,
+                       size_t surface_index, int object_id)
+{
+    if (!enabled())
+        return;
+    const std::string id = source_id_at(object_id, global_layer_index, region_id, surface_index);
+    // An empty id is a genuine lookup miss; record it so the consumer can reject the group instead
+    // of silently accepting a shorter contributor list.
+    t_group_sources[{layer_id, group_index}].push_back(id);
+}
+
+std::vector<std::string> group_source_ids(int layer_id, size_t group_index)
+{
+    const auto it = t_group_sources.find({layer_id, group_index});
+    return it == t_group_sources.end() ? std::vector<std::string>() : it->second;
+}
+
+void record_operations(const PrintObject &print_object,
+                       const std::vector<std::vector<OperationRecord>> &operations_by_layer)
+{
+    if (!enabled())
+        return;
+
+    nlohmann::json j;
+    j["schema_version"] = 1;
+    j["case_id"]        = case_name();
+    j["object_name"]    = model_object_name(print_object);
+    j["object_id"]      = print_object.get_id();
+    j["seed_policy"]    = "root_point_hash";
+
+    // Each layer's events form one contiguous block; resolve the block-local parent/operand
+    // references to zero-based global operation ids.
+    std::vector<int> base(operations_by_layer.size(), 0);
+    int next_id = 0;
+    for (size_t layer_index = 0; layer_index < operations_by_layer.size(); ++layer_index) {
+        base[layer_index] = next_id;
+        next_id += int(operations_by_layer[layer_index].size());
+    }
+
+    auto source_or_null = [](const std::string &id) {
+        return id.empty() ? nlohmann::json(nullptr) : nlohmann::json(id);
+    };
+    auto sources_json = [&source_or_null](const std::vector<std::string> &ids) {
+        nlohmann::json out = nlohmann::json::array();
+        for (const std::string &id : ids)
+            out.push_back(source_or_null(id));
+        return out;
+    };
+
+    int lookup_miss = 0;
+    nlohmann::json operations = nlohmann::json::array();
+    for (size_t layer_index = 0; layer_index < operations_by_layer.size(); ++layer_index) {
+        const std::vector<OperationRecord> &block = operations_by_layer[layer_index];
+        for (size_t local = 0; local < block.size(); ++local) {
+            const OperationRecord &record = block[local];
+            nlohmann::json op;
+            op["operation_id"] = base[layer_index] + int(local);
+            op["kind"]         = record.kind == nullptr ? std::string() : std::string(record.kind);
+            op["checkpoint"]   = "post_anchor";
+            op["inputs"]       = sources_json(record.inputs);
+            for (const std::string &input : record.inputs)
+                if (input.empty())
+                    ++lookup_miss;
+            nlohmann::json parents = nlohmann::json::array();
+            for (int parent : record.parents)
+                parents.push_back(base[layer_index] + parent);
+            op["parent_operations"] = std::move(parents);
+            nlohmann::json operands = nlohmann::json::array();
+            for (const OperationOperandRecord &operand : record.operands) {
+                nlohmann::json o;
+                o["role"]    = operand.role == nullptr ? std::string() : std::string(operand.role);
+                o["sources"] = sources_json(operand.sources);
+                o["operation_id"] = operand.operation < 0
+                    ? nlohmann::json(nullptr)
+                    : nlohmann::json(base[layer_index] + operand.operation);
+                operands.push_back(std::move(o));
+            }
+            op["operands"]        = std::move(operands);
+            op["offset_units"]    = record.has_offset ? nlohmann::json(record.offset_units) : nlohmann::json(nullptr);
+            op["join"]            = record.join == nullptr ? nlohmann::json(nullptr) : nlohmann::json(std::string(record.join));
+            op["result_geometry"] = expolygons_json(record.result_geometry);
+            op["outputs"]         = nlohmann::json::array();
+            operations.push_back(std::move(op));
+        }
+    }
+    j["operations"]  = std::move(operations);
+    j["lookup_miss"] = lookup_miss;
+
+    write_json(output_dir() + "/" + case_name() + "." + object_tag(print_object) + ".operations.json", j);
+}
+
+void record_generator(
+    const PrintObject              &print_object,
+    const std::vector<Polygons>    &planning_outlines,
+    const std::vector<Polygons>    &overhangs,
+    const std::vector<BoundingBox> &bboxs,
+    const std::vector<Layer>       &layers,
+    float                           infill_extrusion_width,
+    coord_t                         supporting_radius,
+    coord_t                         wall_supporting_radius,
+    coord_t                         prune_length,
+    coord_t                         straightening_max_distance)
+{
+    if (!enabled())
+        return;
+
+    nlohmann::json j;
+    j["schema_version"] = 1;
+    j["case_id"]        = case_name();
+    j["object_id"]      = print_object.get_id();
+    j["object_name"]    = model_object_name(print_object);
+    j["scalars"] = {
+        {"infill_extrusion_width", unscale<double>(infill_extrusion_width)},
+        {"supporting_radius", unscale<double>(supporting_radius)},
+        {"wall_supporting_radius", unscale<double>(wall_supporting_radius)},
+        {"prune_length", unscale<double>(prune_length)},
+        {"straightening_max_distance", unscale<double>(straightening_max_distance)},
+        {"nozzle_diameter", print_object.print()->config().nozzle_diameter.values.empty()
+             ? 0.0 : print_object.print()->config().nozzle_diameter.values.front()},
+    };
+    j["object_config"] = config_json(print_object.config(), {"layer_height", "line_width"});
+    j["regions"]       = regions_json(print_object);
+
+    nlohmann::json planning_layers = nlohmann::json::array();
+    for (size_t layer_index = 0; layer_index < planning_outlines.size(); ++layer_index) {
+        const Slic3r::Layer *layer = print_object.get_layer(int(layer_index));
+        nlohmann::json l;
+        l["local_layer_index"]     = layer_index;
+        // Layer::print_z and Layer::height are already millimetres (coordf_t), not scaled units.
+        l["z_mm"]                  = layer->print_z;
+        l["height_mm"]             = layer->height;
+        l["planning_outlines"]     = polygons_json(planning_outlines[layer_index]);
+        l["overhang"]              = polygons_json(overhangs[layer_index]);
+        l["bbox"]                  = {bboxs[layer_index].min.x(), bboxs[layer_index].min.y(),
+                                      bboxs[layer_index].max.x(), bboxs[layer_index].max.y()};
+        planning_layers.push_back(std::move(l));
+    }
+    j["planning_layers"] = std::move(planning_layers);
+    j["graph"]           = graph_json(layers);
+
+    write_json(output_dir() + "/" + case_name() + "." + object_tag(print_object) + ".planning.json", j);
+}
