+std::string infill_pattern_name(int pattern)
+{
+    // Reuse the canonical enum key map so the recorded string matches config serialization.
+    for (const auto &entry : ConfigOptionEnum<InfillPattern>::get_enum_values())
+        if (entry.second == pattern)
+            return entry.first;
+    // Internal-only patterns are not user-selectable and therefore absent from the config enum map.
+    switch (static_cast<InfillPattern>(pattern)) {
+    case ipSupportBase: return "support_base";
+    case ipConcentricInternal: return "concentric_internal";
+    case ipCount: return "count";
+    default: return "unknown";
+    }
