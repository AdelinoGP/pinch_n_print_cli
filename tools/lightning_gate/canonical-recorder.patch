+struct LightningScalars
+{
+    float   infill_extrusion_width { 0 };
+    coord_t supporting_radius { 0 };
+    coord_t wall_supporting_radius { 0 };
+    coord_t prune_length { 0 };
+    coord_t straightening_max_distance { 0 };
+};
+
+// Resolve exactly the five scalars and the inputs the production sparse-infill constructor
+// (Generator::Generator(const PrintObject &, ...)) derives them from. Returns false when the
+// production accessors cannot resolve the inputs (an empty nozzle-diameter vector); callers then
+// omit the affected fields instead of inventing defaults.
+bool resolve_lightning_scalars(const PrintObject &print_object, LightningScalars &scalars, LightningResolvedInputs &resolved_inputs)
+{
+    const PrintConfig       &print_config  = print_object.print()->config();
+    const PrintObjectConfig &object_config = print_object.config();
+    if (print_object.shared_regions() == nullptr || print_object.shared_regions()->all_regions.empty())
+        return false;
+    const PrintRegionConfig &region_config = print_object.shared_regions()->all_regions.front()->config();
+    const std::vector<double> &nozzle_diameters = print_config.nozzle_diameter.values;
+    if (nozzle_diameters.empty())
+        return false;
+
+    const double max_nozzle_diameter = *std::max_element(nozzle_diameters.begin(), nozzle_diameters.end());
+    const int    n_multiline         = region_config.fill_multiline.value;
+    const double default_infill_extrusion_width = Flow::auto_extrusion_width(FlowRole::frInfill, float(max_nozzle_diameter));
+    // Note: There's not going to be a layer below the first one, so the 'initial layer height'
+    // doesn't have to be taken into account.
+    const double layer_thickness = scaled<double>(object_config.layer_height.value);
+
+    float infill_extrusion_width = scaled<float>(region_config.sparse_infill_line_width.get_abs_value(max_nozzle_diameter));
+    // Match the production divide-by-zero fallback exactly.
+    if (infill_extrusion_width < EPSILON)
+        infill_extrusion_width = scaled<float>(
+            object_config.line_width.get_abs_value(max_nozzle_diameter) < EPSILON ?
+            default_infill_extrusion_width :
+            object_config.line_width.get_abs_value(max_nozzle_diameter));
+
+    const double overhang_angle      = region_config.lightning_overhang_angle.value * M_PI / 180.0;
+    const double prune_angle         = region_config.lightning_prune_angle.value * M_PI / 180.0;
+    const double straightening_angle = region_config.lightning_straightening_angle.value * M_PI / 180.0;
+
+    scalars.infill_extrusion_width      = infill_extrusion_width;
+    scalars.supporting_radius           = coord_t(infill_extrusion_width) * 100 * n_multiline / region_config.sparse_infill_density.value;
+    scalars.wall_supporting_radius      = coord_t(layer_thickness * std::tan(overhang_angle));
+    scalars.prune_length                = coord_t(layer_thickness * std::tan(prune_angle));
+    scalars.straightening_max_distance  = coord_t(layer_thickness * std::tan(straightening_angle));
+
+    resolved_inputs.max_nozzle_diameter_mm        = max_nozzle_diameter;
+    resolved_inputs.layer_height_mm               = object_config.layer_height.value;
+    resolved_inputs.sparse_infill_line_width_mm   = region_config.sparse_infill_line_width.get_abs_value(max_nozzle_diameter);
+    resolved_inputs.object_line_width_mm          = object_config.line_width.get_abs_value(max_nozzle_diameter);
+    resolved_inputs.fill_multiline                = n_multiline;
+    resolved_inputs.sparse_infill_density_percent = region_config.sparse_infill_density.value;
+    resolved_inputs.overhang_angle_deg            = region_config.lightning_overhang_angle.value;
+    resolved_inputs.prune_angle_deg               = region_config.lightning_prune_angle.value;
+    resolved_inputs.straightening_angle_deg       = region_config.lightning_straightening_angle.value;
+    return true;
+}
+
+nlohmann::json resolved_inputs_json(const LightningResolvedInputs &inputs)
+{
+    return {
+        {"max_nozzle_diameter_mm", inputs.max_nozzle_diameter_mm},
+        {"layer_height_mm", inputs.layer_height_mm},
+        {"sparse_infill_line_width_mm", inputs.sparse_infill_line_width_mm},
+        {"object_line_width_mm", inputs.object_line_width_mm},
+        {"fill_multiline", inputs.fill_multiline},
+        {"sparse_infill_density_percent", inputs.sparse_infill_density_percent},
+        {"overhang_angle_deg", inputs.overhang_angle_deg},
+        {"prune_angle_deg", inputs.prune_angle_deg},
+        {"straightening_angle_deg", inputs.straightening_angle_deg},
+    };
+}
