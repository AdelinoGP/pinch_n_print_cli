+
+void capture_domains(const PrintObject &print_object,
+                     const std::vector<std::map<const LayerRegion *, ExPolygons>> &temporary_anchors,
+                     const std::vector<std::map<const LayerRegion *, SurfaceCollection>> &final_surfaces,
+                     const char *phase)
+{
+    if (!enabled())
+        return;
+
+    nlohmann::json j;
+    j["schema_version"] = 1;
+    j["case_id"]        = case_name();
+    j["object_id"]      = print_object.get_id();
+    j["object_name"]    = model_object_name(print_object);
+    j["phase"]          = phase;
+
+    // The five scalars the production sparse-infill Generator constructor resolves, plus the exact
+    // inputs they are derived from. Both groups are omitted as a whole if the production accessors
+    // cannot resolve them; no value is defaulted here.
+    LightningScalars scalars;
+    LightningResolvedInputs resolved_inputs;
+    if (resolve_lightning_scalars(print_object, scalars, resolved_inputs)) {
+        j["scalars"]         = scalars_json(scalars);
+        j["resolved_inputs"] = resolved_inputs_json(resolved_inputs);
+    }
+
+    nlohmann::json layers = nlohmann::json::array();
+    for (int layer_index = 0; layer_index < int(print_object.layers().size()); ++layer_index) {
+        const Slic3r::Layer *layer = print_object.get_layer(layer_index);
+        nlohmann::json l;
+        l["local_layer_index"]  = layer_index;
+        l["global_layer_index"] = layer->id();
+        // Layer::print_z and Layer::height are already millimetres (coordf_t), not scaled units.
+        l["z_mm"]               = layer->print_z;
+        l["height_mm"]          = layer->height;
+        nlohmann::json regions = nlohmann::json::array();
+        for (const LayerRegion *region : layer->regions()) {
+            nlohmann::json r;
+            r["region_id"]        = region->region().print_object_region_id();
+            r["internal_domains"] = expolygons_json(to_expolygons(region->fill_surfaces.filter_by_type(stInternal)));
+            r["void_domains"]     = expolygons_json(to_expolygons(region->fill_surfaces.filter_by_type(stInternalVoid)));
+            r["temporary_anchors"] = expolygons_json(lookup_domains(temporary_anchors, size_t(layer_index), region));
+            const SurfaceCollection &final_surface_set = lookup_domains(final_surfaces, size_t(layer_index), region);
+            r["final_expolygons"]       = expolygons_json(to_expolygons(final_surface_set.surfaces));
+            r["final_internal_domains"] = expolygons_json(to_expolygons(final_surface_set.filter_by_type(stInternal)));
+            r["final_void_domains"]     = expolygons_json(to_expolygons(final_surface_set.filter_by_type(stInternalVoid)));
+            regions.push_back(std::move(r));
+        }
+        l["regions"] = std::move(regions);
+        layers.push_back(std::move(l));
+    }
+    j["layers"] = std::move(layers);
+
+    write_json(output_dir() + "/" + case_name() + "." + object_tag(print_object) + ".domains.json", j);
+}
